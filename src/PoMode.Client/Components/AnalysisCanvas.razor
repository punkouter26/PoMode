@using PoMode.Shared.Analysis
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="canvas-wrap">
    <div class="canvas-stage">
        <canvas @ref="_canvas" class="analysis-canvas"
                role="img"
                aria-label="Piano roll of detected notes above a timeline of detected chords"
                aria-describedby="@(Describe && Model is not null ? _tableId : null)"
                title="Scroll to zoom · drag to pan · click to seek"></canvas>
        @* What is under the playhead, as the server labelled it: chord, sung note, section. canvas.js
           writes the text as the playhead moves, so following it costs no render here. Frosted
           rather than opaque so the notes it sits over stay visible behind it; aria-hidden because
           it repeats what the canvas already describes. *@
        <div class="now-chip" @ref="_chip" data-empty="1" aria-hidden="true">
            <span class="now-chord" data-part="chord" hidden></span>
            <span class="now-note" data-part="note" hidden></span>
            <span class="now-section" data-part="section" hidden></span>
            <span class="now-lyric" data-part="lyric" hidden></span>
        </div>
    </div>
    @if (Describe && Model is { Windows.Count: > 0 } described)
    {
        @* The canvas as words, for a screen reader: each window's time, chord, mode and the notes sung
           in it, all as the server labelled them. Nothing a sighted reader sees is missing from it. *@
        <table class="pm-sr-only" id="@_tableId">
            <caption>Notes and chords, window by window</caption>
            <thead><tr><th scope="col">Time</th><th scope="col">Chord</th><th scope="col">Mode</th><th scope="col">Notes sung</th></tr></thead>
            <tbody>
                @foreach (var window in described.Windows)
                {
                    <tr>
                        <td>@Clock(window.StartSec) to @Clock(window.EndSec)</td>
                        <td>@window.ChordSymbol</td>
                        <td>@(window.ModeTag is { } mode ? ScaleModes.DisplayName(mode) : "unclear")</td>
                        <td>@SungIn(described, window)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <p class="canvas-legend">
        <span class="swatch chord-tone"></span>chord tone
        <span class="swatch characteristic"></span>modal note
        <span class="swatch in-mode"></span>in mode
        <span class="swatch outside"></span>outside
        @if (HighlightEvidence)
        {
            @* Only while the "Why this mode?" readout is open — the only time the rings mean anything. *@
            <span class="swatch evidence"></span><span>ringed: the tone that decides the mode</span>
        }
    </p>
</div>

@code {
    /// <summary>Row sent to JS. Roles travel as strings so reordering the C# enum cannot silently
    /// remap colours (Blazor's interop serializer writes enums as numbers by default).</summary>
    private sealed record CanvasNote(
        int MidiPitch, double StartSec, double DurationSec, string Role, string PitchLabel, string DegreeLabel,
        bool Evidence);

    private sealed record CanvasChord(
        string Symbol, double StartSec, double EndSec, int MeasureNumber, string? ModeTag);

    private sealed record CanvasTempo(double StartSec, double Bpm, bool Changed);

    /// <summary>A section band. The colour travels as a CSS token name and is resolved against the
    /// live theme in canvas.js, so the ribbon flips with light/dark like every other colour.</summary>
    private sealed record CanvasSection(
        double StartSec, double EndSec, string Letter, string Label, string ColourToken);

    /// <summary>One window's tension (the server's share of sung time off the chord), or null.</summary>
    private sealed record CanvasTension(double StartSec, double EndSec, double? Value);

    private sealed record CanvasPayload(
        IReadOnlyList<CanvasNote> Notes, IReadOnlyList<CanvasChord> Chords,
        double DurationSec, int MinPitch, int MaxPitch,
        IReadOnlyList<CanvasTempo> Tempo,
        IReadOnlyList<CanvasSection> Sections,
        IReadOnlyList<CanvasTension> Tension);

    [Parameter, EditorRequired] public VisualizationPayload? Model { get; set; }

    [Parameter] public int? SelectedWindowIndex { get; set; }

    [Parameter] public double PlayheadSec { get; set; }

    [Parameter] public EventCallback<double> OnSeek { get; set; }

    /// <summary>Ring the notes the server flagged as carrying the mode's deciding tone and fade the
    /// rest, so the "Why this mode?" sentence can be checked against the notes it is about.</summary>
    [Parameter] public bool HighlightEvidence { get; set; }

    /// <summary>Play each new model in (notes rising to their rows, chords dropping in behind) rather
    /// than drawing it at once. The analysis page wants it; the Mode Lab, which swaps models on every
    /// slider move, does not.</summary>
    [Parameter] public bool Reveal { get; set; }

    /// <summary>With <see cref="Reveal"/>, paint the note colours on in a sweep after the notes land —
    /// for a hum take, where the melody is the user's and the colours are the verdict on it.</summary>
    [Parameter] public bool Ink { get; set; }

    /// <summary>The analysed job, when there is one: its band's chroma is drawn under the chords.</summary>
    [Parameter] public string? JobId { get; set; }

    /// <summary>Add the window-by-window table a screen reader reads in place of the picture. The
    /// analysis page wants it; the Mode Lab, whose canvas is a preview of a generated loop, does not.</summary>
    [Parameter] public bool Describe { get; set; }

    private readonly string _tableId = $"canvas-table-{Guid.NewGuid():N}";
    private string? _chromaFor;

    private static string Clock(double seconds) => $"{(int)(seconds / 60)}:{(int)(seconds % 60):00}";

    private static string SungIn(VisualizationPayload model, VisualWindow window)
    {
        var labels = model.Notes
            .Where(note => note.StartSec < window.EndSec && note.StartSec + note.DurationSec > window.StartSec)
            .Select(note => note.PitchLabel)
            .ToList();
        return labels.Count == 0 ? "none" : string.Join(", ", labels);
    }

    /// <summary>
    /// Raised once the canvas element exists and its module is initialised, handing the element to the
    /// parent so the mixer can drive the playhead straight from the Web Audio clock (see mixer.js)
    /// instead of pushing 60 updates a second back through Blazor. An <c>@@ref</c> cannot be used for
    /// this: it is assigned *during* render, so a parent gating on it would never re-render.
    /// </summary>
    [Parameter] public EventCallback<ElementReference> OnReady { get; set; }

    private ElementReference _canvas;
    private ElementReference _chip;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AnalysisCanvas>? _self;

    private VisualizationPayload? _sentModel;
    private int? _sentSelection;
    private double? _sentPlayhead;
    private bool? _sentHighlight;

    [JSInvokable]
    public Task OnCanvasSeek(double seconds) => OnSeek.InvokeAsync(seconds);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/player/canvas.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _canvas, _self, _chip);
        }
        await PushStateAsync();
        if (firstRender)
        {
            await OnReady.InvokeAsync(_canvas);
        }
    }

    /// <summary>Only pushes what actually changed — the model payload is the expensive one.</summary>
    private async Task PushStateAsync()
    {
        if (_module is null)
        {
            return;
        }

        if (!ReferenceEquals(_sentModel, Model))
        {
            _sentModel = Model;
            await _module.InvokeVoidAsync("setModel", _canvas, ToCanvasPayload(Model));
            _sentPlayhead = null;
            _sentSelection = null;
            if (Reveal && Model is not null)
            {
                await _module.InvokeVoidAsync("reveal", _canvas, Ink);
            }
        }
        if (JobId is { Length: > 0 } jobId && Model is not null && _chromaFor != jobId)
        {
            _chromaFor = jobId;
            await _module.InvokeVoidAsync("loadChroma", _canvas, jobId);
            await _module.InvokeVoidAsync("loadLyrics", _canvas, jobId);
        }
        if (_sentSelection != SelectedWindowIndex)
        {
            _sentSelection = SelectedWindowIndex;
            await _module.InvokeVoidAsync("setSelection", _canvas, SelectedWindowIndex);
        }
        if (_sentHighlight != HighlightEvidence)
        {
            _sentHighlight = HighlightEvidence;
            await _module.InvokeVoidAsync("setEvidenceHighlight", _canvas, HighlightEvidence);
        }
        if (_sentPlayhead != PlayheadSec)
        {
            _sentPlayhead = PlayheadSec;
            await _module.InvokeVoidAsync("setPlayhead", _canvas, PlayheadSec);
        }
    }

    private static CanvasPayload? ToCanvasPayload(VisualizationPayload? model)
        => model is null ? null : new CanvasPayload(
            [.. model.Notes.Select(note => new CanvasNote(
                note.MidiPitch, note.StartSec, note.DurationSec,
                note.Role.ToString(), note.PitchLabel, note.DegreeLabel, note.Evidence))],
            [.. model.Chords.Select(chord => new CanvasChord(
                chord.Symbol, chord.StartSec, chord.EndSec, chord.MeasureNumber, chord.ModeTag))],
            model.DurationSec, model.MinPitch, model.MaxPitch,
            [.. model.Tempo.Select(point => new CanvasTempo(point.StartSec, point.Bpm, point.Changed))],
            [.. model.Sections.Select(section => new CanvasSection(
                section.StartSec, section.EndSec, section.Letter, section.Label, section.ColourToken))],
            [.. model.Windows.Select(window => new CanvasTension(window.StartSec, window.EndSec, window.Tension))]);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _canvas);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone during teardown — nothing left to clean up.
            }
        }
        _self?.Dispose();
    }
}
