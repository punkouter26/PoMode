@using PoMode.Shared.Analysis

@* Factual readout of the modal analysis (spec §7). Every value here was derived server-side by
   VisualizationBuilder — this component formats, it does not decide. Per-stage tier badges are not
   repeated here: JobProgress already renders them next to each stage's executor. *@

<div class="hud">
    <RadzenCard class="hud-card hud-primary">
        <div class="hud-primary-row">
            <div class="hud-primary-text">
                <RadzenText TextStyle="TextStyle.H6" Text="Primary mode" />
                <RadzenText class="hud-headline" Text="@PrimaryHeadline" />
                @if (Result.PrimaryMode is not null)
                {
                    <RadzenProgressBar Value="@(Result.PrimaryConfidence * 100)" ShowValue="false" class="hud-bar" />
                    <RadzenText class="hud-sub" Text="@($"confidence {Result.PrimaryConfidence:P0}")" />
                    @* The scale spelled out — server-decided tonic + mode, Shared lookup for the names. *@
                    <RadzenText class="hud-sub hud-scale"
                                Text="@($"Scale: {string.Join(" · ", Result.PrimaryScaleNoteNames()!)}")" />
                }
                else
                {
                    <RadzenText class="hud-sub"
                                Text="No window had enough sung material to name a mode." />
                }
                <RadzenText class="hud-sub"
                            Text="@($"Tempo {Result.TempoBpm:0} BPM{(Result.TempoEstimated ? " (estimated)" : "")} · {Windows.Count} windows")" />
            </div>
            <button class="hud-landscape-link" type="button" @onclick="OnShowLandscapeAsync" title="Open the 3D mode landscape">
                3D landscape ↗
            </button>
        </div>
    </RadzenCard>

    @* The three window-detail cards collapse into a single "Details" disclosure. They were
       individually visible before but on a fresh analysis they all read "No window selected" —
       pure noise. Now they only render once a window is actually selected. *@
    @if (Selected is null)
    {
        <RadzenCard class="hud-card hud-empty">
            <RadzenText class="hud-sub" Text="Click a chord block on the timeline to inspect a window." />
        </RadzenCard>
    }
    else
    {
        <RadzenCard class="hud-card">
            <button class="hud-disclosure" type="button" @onclick="ToggleDetailsAsync"
                    aria-expanded="@_detailsOpen" aria-controls="hud-details">
                @(_detailsOpen ? "Hide details" : "Show details")
            </button>
            @if (_detailsOpen)
            {
                <div id="hud-details" class="hud-details">
                    <section class="hud-section">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Harmonic context" />
                        <dl class="hud-facts">
                            <dt>Chord</dt>
                            <dd class="hud-chord">@Selected.ChordSymbol</dd>
                            <dt>Measure</dt>
                            <dd>m@(Selected.MeasureNumber)</dd>
                            <dt>Tonic</dt>
                            <dd>@Result.TonicName <span class="hud-sub">(@Result.TonicConfidence.ToString("P0"))</span></dd>
                            <dt>Sung mask</dt>
                            <dd class="hud-mask">@Selected.MaskHex</dd>
                            <dt>Window</dt>
                            <dd>@Selected.StartSec.ToString("0.00")–@Selected.EndSec.ToString("0.00")s</dd>
                        </dl>
                    </section>

                    <section class="hud-section">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Scale degrees" />
                        <div class="degree-grid">
                            @foreach (var badge in Selected.Degrees)
                            {
                                <span class="@DegreeClass(badge)" title="@DegreeTitle(badge)">@badge.Label</span>
                            }
                        </div>
                        <p class="degree-key">
                            <span class="degree sung"></span>sung
                            <span class="degree characteristic"></span>modal
                            <span class="degree in-mode"></span>in mode
                            <span class="degree"></span>unused
                        </p>
                    </section>

                    <section class="hud-section">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Mode match" />
                        @if (Selected.InsufficientEvidence || Selected.ModeTag is null)
                        {
                            @* Honest empty state: the engine needs 3+ distinct sung pitch classes (spec §6). *@
                            <RadzenText class="hud-sub"
                                        Text="Not enough sung notes in this window to name a mode." />
                        }
                        else
                        {
                            <RadzenText class="hud-headline" Text="@($"{Selected.ModeTag} ({Selected.ModeConfidence:P0})")" />
                            <RadzenProgressBar Value="@((Selected.ModeConfidence ?? 0) * 100)" ShowValue="false" class="hud-bar" />
                            @if (Selected.Alternatives.Count == 0)
                            {
                                <RadzenText class="hud-sub" Text="No close alternatives." />
                            }
                            else
                            {
                                <ul class="alternatives">
                                    @foreach (var alternative in Selected.Alternatives)
                                    {
                                        <li>
                                            <span class="alt-mode">@alternative.Mode</span>
                                            <span class="hud-sub">@alternative.Confidence.ToString("P0")</span>
                                        </li>
                                    }
                                </ul>
                            }
                        }
                    </section>
                </div>
            }
        </RadzenCard>
    }
</div>

@code {
    [Parameter, EditorRequired] public required ModalResult Result { get; set; }

    [Parameter, EditorRequired] public required IReadOnlyList<VisualWindow> Windows { get; set; }

    [Parameter] public int? SelectedWindowIndex { get; set; }

    /// <summary>Raised when the user clicks the "3D landscape" link — the parent owns the WebGL scene.</summary>
    [Parameter] public EventCallback OnShowLandscape { get; set; }

    private bool _detailsOpen;
    private int? _lastSelection;

    private VisualWindow? Selected => SelectedWindowIndex is { } index && index >= 0 && index < Windows.Count
        ? Windows[index]
        : null;

    /// <summary>Open the details disclosure automatically the first time a window is selected.</summary>
    protected override void OnParametersSet()
    {
        if (Selected is not null && _lastSelection != SelectedWindowIndex)
        {
            _detailsOpen = true;
            _lastSelection = SelectedWindowIndex;
        }
    }

    private void ToggleDetailsAsync() => _detailsOpen = !_detailsOpen;

    private Task OnShowLandscapeAsync() => OnShowLandscape.InvokeAsync();

    private string PrimaryHeadline => Result.PrimaryMode is null
        ? $"{Result.TonicName} · mode unclear"
        : $"{Result.TonicName} {Result.PrimaryMode}";

    private static string DegreeClass(DegreeBadge badge)
    {
        var classes = "degree";
        if (badge.Sung) classes += " sung";
        if (badge.Characteristic) classes += " characteristic";
        else if (badge.InMode) classes += " in-mode";
        return classes;
    }

    private static string DegreeTitle(DegreeBadge badge)
    {
        var role = badge.Characteristic ? "characteristic degree of this mode"
            : badge.InMode ? "in this mode"
            : "outside this mode";
        return $"{badge.Label}: {role}; {(badge.Sung ? "sung here" : "not sung here")}";
    }
}
