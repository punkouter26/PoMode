@using PoMode.Shared.Analysis
@inject IJSRuntime JS
@implements IAsyncDisposable

<RadzenCard class="job-progress">
    @* Once complete, the checklist folds to one calm line; the toggle brings the detail back. *@
    @if (Status.Stage == JobStage.Complete && _completedCollapsed)
    {
        <div class="progress-header progress-collapsed">
            <RadzenText class="complete-text" Text="@CompletedSummary" />
            <button class="icon-button collapse-toggle" type="button" @onclick="() => _completedCollapsed = false"
                    aria-expanded="false" title="Show per-stage detail">▸</button>
        </div>
    }
    else
    {
    <div class="progress-header">
        <RadzenText TextStyle="TextStyle.H6" Text="Analysis progress" />
        <span class="percent">@($"{Status.Progress * 100:0}%")</span>
        @if (IsRunning && OnCancel.HasDelegate)
        {
            <RadzenButton class="cancel-button" Text="Cancel" Size="ButtonSize.ExtraSmall"
                          ButtonStyle="ButtonStyle.Light" Click="@(() => OnCancel.InvokeAsync())" />
        }
        @if (Status.Stage == JobStage.Complete)
        {
            <button class="icon-button collapse-toggle" type="button" @onclick="() => _completedCollapsed = true"
                    aria-expanded="true" title="Collapse to one line">▾</button>
        }
    </div>
    <RadzenProgressBar Value="@((Status.Progress) * 100)" ShowValue="false" />
    @if (CurrentStepText is { } step)
    {
        <div class="current-step-wrap">
            <span class="active-pulse" aria-hidden="true"></span>
            <RadzenText class="current-step" Text="@step" />
        </div>
        @if (ActiveStageDetail is { } detail)
        {
            <RadzenText class="stage-detail-hint" Text="@detail" />
        }
    }
    <ul class="stages">
        @foreach (var stage in Status.Plan)
        {
            <li class="@StageClass(stage)">
                <span class="tier"><TierBadge Tier="stage.Tier" /></span>
                <span class="name">@FriendlyName(stage.Stage)</span>
                <span class="executor">@stage.Executor</span>
                @if (DurationText(stage) is { } duration)
                {
                    <span class="duration">@duration</span>
                }
                @if (Status.CompletedStages.Contains(stage.Stage))
                {
                    <span class="done">✓</span>
                }
                else if (IsActive(stage))
                {
                    <span class="spinner" aria-label="in progress"></span>
                }
            </li>
        }
    </ul>
    @if (Status.Stage == JobStage.Complete)
    {
        <RadzenText class="complete-text" Text="Analysis complete" />
    }
    else if (Status.Stage == JobStage.Failed)
    {
        <RadzenText class="error-text" Text="@($"Analysis failed: {Status.Error}")" />
    }
    else if (Status.Stage == JobStage.Cancelled)
    {
        <RadzenText Text="Analysis cancelled" />
    }
    else if (Status.Stage == JobStage.AwaitingClient)
    {
        <RadzenText class="awaiting-client-text" Text="Transcribing the vocals in your browser…" />
    }
    }
</RadzenCard>

@code {
    [Parameter, EditorRequired]
    public required JobStatusDto Status { get; set; }

    /// <summary>Raised by the Cancel button; the parent owns the actual API call.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private Timer? _elapsedTimer;
    private IJSObjectReference? _sfx;

    /// <summary>How many stages had finished the last time this component looked, so a stage
    /// completing sounds once. Starts at -1 rather than 0 so a job resumed from disk with stages
    /// already behind it does not fire a burst of earcons for work the user never watched.</summary>
    private int _soundedStages = -1;

    /// <summary>Completed jobs fold to one line by default; the toggle reopens the checklist.</summary>
    private bool _completedCollapsed = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await SoundStageChangeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Torn down mid-update.
        }
    }

    /// <summary>
    /// One quiet earcon per stage that finishes, climbing the detected mode's degrees so a four-stage
    /// run resolves upward. Fires only on a genuine increase, because this component re-renders once
    /// a second to tick the elapsed timer and a sound on every render would be unbearable.
    /// </summary>
    private async Task SoundStageChangeAsync()
    {
        var completed = Status.CompletedStages?.Count ?? 0;
        if (_soundedStages < 0)
        {
            _soundedStages = completed;
            return;
        }
        if (completed <= _soundedStages)
        {
            return;
        }
        var previous = _soundedStages;
        _soundedStages = completed;
        // The final stage's completion is the job's completion, and Home plays the key's fanfare for
        // that; stepping over it here would land two sounds on top of each other.
        if (Status.Stage is JobStage.Complete)
        {
            return;
        }
        _sfx ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/sfx.js");
        for (var index = previous; index < completed; index++)
        {
            await _sfx.InvokeVoidAsync("stageStep", index);
        }
    }

    private bool IsRunning => !Status.Stage.IsTerminal();

    private string CompletedSummary
    {
        get
        {
            var total = 0.0;
            foreach (var record in Status.StageHistory ?? [])
            {
                if (record.CompletedAt is { } end)
                {
                    total += (end - record.StartedAt).TotalSeconds;
                }
            }
            return total > 0 ? $"Analysis complete ✓ · {total:0.0}s" : "Analysis complete ✓";
        }
    }

    protected override void OnInitialized()
        // Repaint once a second so the active stage's elapsed time counts up live.
        => _elapsedTimer = new Timer(_ =>
        {
            if (IsRunning)
            {
                _ = InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

    public async ValueTask DisposeAsync()
    {
        _elapsedTimer?.Dispose();
        try
        {
            if (_sfx is not null)
            {
                await _sfx.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone during teardown.
        }
    }

    private static string FriendlyName(string stage) => stage switch
    {
        StageNames.Separating => "Separating stems",
        StageNames.PitchTracking => "Transcribing melody",
        StageNames.ChordDetecting => "Detecting chords",
        StageNames.ModalAnalysis => "Analyzing modes",
        _ => stage,
    };

    private static string StageDescription(string stage) => stage switch
    {
        StageNames.Separating => "Separating audio into vocal and instrumental tracks with neural AI model…",
        StageNames.PitchTracking => "Transcribing the vocal melody note by note…",
        StageNames.ChordDetecting => "Detecting harmony and chord progressions over time…",
        StageNames.ModalAnalysis => "Computing modal scale distribution and determining key & tonic…",
        _ => "Processing analysis stage…",
    };

    private string? ActiveStageDetail
    {
        get
        {
            if (!IsRunning) return null;
            for (var index = 0; index < Status.Plan.Count; index++)
            {
                if (IsActive(Status.Plan[index]))
                {
                    return StageDescription(Status.Plan[index].Stage);
                }
            }
            return null;
        }
    }

    private string? CurrentStepText
    {
        get
        {
            if (!IsRunning)
            {
                return null;
            }
            for (var index = 0; index < Status.Plan.Count; index++)
            {
                if (IsActive(Status.Plan[index]))
                {
                    var stage = Status.Plan[index];
                    var dur = DurationText(stage);
                    var durNote = dur is not null ? $" ({dur})" : "";
                    return $"Step {index + 1} of {Status.Plan.Count}: {FriendlyName(stage.Stage)}{durNote}";
                }
            }
            return "Waiting to start…";
        }
    }

    private bool IsActive(StagePlan stage)
        => StageNames.ForStage(Status.Stage) == stage.Stage;

    private string? DurationText(StagePlan stage)
    {
        var record = Status.StageHistory?.LastOrDefault(r => r.Stage == stage.Stage);
        if (record is null)
        {
            return null;
        }
        return record.CompletedAt is { } end
            ? $"{(end - record.StartedAt).TotalSeconds:0.0}s"
            : IsActive(stage)
                ? $"{(DateTimeOffset.UtcNow - record.StartedAt).TotalSeconds:0}s…"
                : null;
    }

    private string StageClass(StagePlan stage)
        => Status.CompletedStages.Contains(stage.Stage) ? "stage completed"
            : IsActive(stage) ? "stage active"
            : "stage";
}
