@using PoMode.Shared.Analysis

<RadzenCard class="stats-card">
    <div class="stats-header">
        <RadzenText TextStyle="TextStyle.H6" Text="Song Analysis & Theory Statistics" />
        <span class="stats-subtitle">Deep harmonic metrics derived from transcribed notes and chords</span>
    </div>

    <div class="stats-grid">
        <!-- Metric 1: Vocal Range & Density -->
        <div class="stat-box">
            <span class="stat-title">Vocal Range</span>
            <div class="stat-highlight">
                <span class="range-span">@RangeLabel</span>
                <span class="stat-badge">@($"{SpanSemitones} semitones ({SpanOctaves:0.1} oct)")</span>
            </div>
            <div class="stat-details">
                <div class="stat-row">
                    <span>Lowest note:</span>
                    <strong>@MinPitchLabel (MIDI @Visual.MinPitch)</strong>
                </div>
                <div class="stat-row">
                    <span>Highest note:</span>
                    <strong>@MaxPitchLabel (MIDI @Visual.MaxPitch)</strong>
                </div>
                <div class="stat-row">
                    <span>Melody note count:</span>
                    <strong>@Visual.Notes.Count notes</strong>
                </div>
                <div class="stat-row">
                    <span>Note density:</span>
                    <strong>@($"{NoteDensity:0.1} notes/sec")</strong>
                </div>
                <div class="stat-row">
                    <span>Avg note length:</span>
                    <strong>@($"{AvgNoteDuration:0.2}s")</strong>
                </div>
            </div>
        </div>

        <!-- Metric 2: Melodic Consonance Breakdown -->
        <div class="stat-box">
            <span class="stat-title">Melodic Role Breakdown</span>
            <div class="stat-highlight">
                <span class="range-span">@($"{InScalePercent:0}% In-Scale")</span>
                <span class="stat-badge @(OutsidePercent > 10 ? "badge-warning" : "badge-success")">
                    @($"{OutsidePercent:0.1}% Chromatic")
                </span>
            </div>
            <div class="role-bars">
                <div class="role-bar-row">
                    <span class="role-label"><span class="swatch chord-tone"></span>Chord tones</span>
                    <div class="bar-track">
                        <div class="bar-fill chord-tone-fill" style="width: @($"{ChordTonePercent:0.1}%");"></div>
                    </div>
                    <span class="role-val">@($"{ChordTonePercent:0}%")</span>
                </div>
                <div class="role-bar-row">
                    <span class="role-label"><span class="swatch characteristic"></span>Modal notes</span>
                    <div class="bar-track">
                        <div class="bar-fill characteristic-fill" style="width: @($"{CharacteristicPercent:0.1}%");"></div>
                    </div>
                    <span class="role-val">@($"{CharacteristicPercent:0}%")</span>
                </div>
                <div class="role-bar-row">
                    <span class="role-label"><span class="swatch in-mode"></span>Scale notes</span>
                    <div class="bar-track">
                        <div class="bar-fill in-mode-fill" style="width: @($"{InModePercent:0.1}%");"></div>
                    </div>
                    <span class="role-val">@($"{InModePercent:0}%")</span>
                </div>
                <div class="role-bar-row">
                    <span class="role-label"><span class="swatch outside"></span>Outside</span>
                    <div class="bar-track">
                        <div class="bar-fill outside-fill" style="width: @($"{OutsidePercent:0.1}%");"></div>
                    </div>
                    <span class="role-val">@($"{OutsidePercent:0}%")</span>
                </div>
            </div>
        </div>

        <!-- Metric 3: Modal Distribution Across Windows -->
        <div class="stat-box">
            <span class="stat-title">Mode Distribution & Modulations</span>
            <div class="stat-highlight">
                <span class="range-span">@PrimaryModeLabel</span>
                <span class="stat-badge">@($"{ModulationCount} modulations")</span>
            </div>
            <div class="mode-distribution-list">
                @foreach (var (modeName, percent, count) in ModeBreakdown)
                {
                    <div class="mode-dist-row">
                        <span class="mode-dist-name">@modeName</span>
                        <div class="bar-track">
                            <div class="bar-fill mode-dist-fill" style="width: @($"{percent:0.1}%");"></div>
                        </div>
                        <span class="mode-dist-percent">@($"{percent:0}% ({count}w)")</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Pitch Class Histogram (Chroma Distribution) -->
    <div class="chroma-section">
        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Pitch Class Distribution (Sung Chroma Histogram)" />
        <div class="chroma-bars">
            @foreach (var pitch in ChromaDistribution)
            {
                var isTonic = pitch.PitchClass == Result.TonicPitchClass;
                <div class="chroma-col @(isTonic ? "chroma-tonic" : "")" title="@($"{pitch.Name}: {pitch.TotalDurationSec:0.1}s ({pitch.Percent:0.1}%)")">
                    <div class="chroma-bar-container">
                        <div class="chroma-bar" style="height: @($"{Math.Max(pitch.Percent * 2.5, 4):0.1}px");"></div>
                    </div>
                    <span class="chroma-label">@pitch.Name</span>
                    @if (isTonic)
                    {
                        <span class="tonic-indicator" title="Tonic key center">★</span>
                    }
                </div>
            }
        </div>
    </div>
</RadzenCard>

@code {
    private static readonly string[] PitchNames = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];

    [Parameter, EditorRequired] public required ModalResult Result { get; set; }
    [Parameter, EditorRequired] public required VisualizationPayload Visual { get; set; }

    private int SpanSemitones => Math.Max(0, Visual.MaxPitch - Visual.MinPitch);
    private double SpanOctaves => SpanSemitones / 12.0;

    private string MinPitchLabel => Visual.Notes.Count == 0 ? "—" : MidiToPitchLabel(Visual.MinPitch);
    private string MaxPitchLabel => Visual.Notes.Count == 0 ? "—" : MidiToPitchLabel(Visual.MaxPitch);
    private string RangeLabel => Visual.Notes.Count == 0 ? "No notes" : $"{MinPitchLabel} – {MaxPitchLabel}";

    private double NoteDensity => Visual.DurationSec > 0 ? Visual.Notes.Count / Visual.DurationSec : 0;
    private double AvgNoteDuration => Visual.Notes.Count > 0 ? Visual.Notes.Average(n => n.DurationSec) : 0;

    private double ChordTonePercent => Visual.Notes.Count == 0 ? 0 : (Visual.Notes.Count(n => n.Role == NoteRole.ChordTone) * 100.0) / Visual.Notes.Count;
    private double CharacteristicPercent => Visual.Notes.Count == 0 ? 0 : (Visual.Notes.Count(n => n.Role == NoteRole.Characteristic) * 100.0) / Visual.Notes.Count;
    private double InModePercent => Visual.Notes.Count == 0 ? 0 : (Visual.Notes.Count(n => n.Role == NoteRole.InMode) * 100.0) / Visual.Notes.Count;
    private double OutsidePercent => Visual.Notes.Count == 0 ? 0 : (Visual.Notes.Count(n => n.Role == NoteRole.Outside) * 100.0) / Visual.Notes.Count;
    private double InScalePercent => 100.0 - OutsidePercent;

    private string PrimaryModeLabel => Result.PrimaryMode is null ? "Mode Unclear" : $"{Result.PrimaryMode} ({Result.PrimaryConfidence:P0})";

    private int ModulationCount
    {
        get
        {
            var count = 0;
            string? lastMode = null;
            foreach (var window in Visual.Windows)
            {
                if (!string.IsNullOrEmpty(window.ModeTag))
                {
                    if (lastMode != null && lastMode != window.ModeTag)
                    {
                        count++;
                    }
                    lastMode = window.ModeTag;
                }
            }
            return count;
        }
    }

    private List<(string Mode, double Percent, int Count)> ModeBreakdown
    {
        get
        {
            var valid = Visual.Windows.Where(w => !string.IsNullOrEmpty(w.ModeTag)).ToList();
            if (valid.Count == 0)
            {
                return [("Unclear", 100.0, Visual.Windows.Count)];
            }
            return valid
                .GroupBy(w => w.ModeTag!)
                .OrderByDescending(g => g.Count())
                .Select(g => (g.Key, (g.Count() * 100.0) / valid.Count, g.Count()))
                .ToList();
        }
    }

    private sealed record ChromaBin(int PitchClass, string Name, double TotalDurationSec, double Percent);

    private List<ChromaBin> ChromaDistribution
    {
        get
        {
            var durations = new double[12];
            foreach (var note in Visual.Notes)
            {
                var pitchClass = ((note.MidiPitch % 12) + 12) % 12;
                durations[pitchClass] += note.DurationSec;
            }
            var total = durations.Sum();
            var list = new List<ChromaBin>(12);
            for (var i = 0; i < 12; i++)
            {
                var percent = total > 0 ? (durations[i] * 100.0) / total : 0;
                list.Add(new ChromaBin(i, PitchNames[i], durations[i], percent));
            }
            return list;
        }
    }

    private static string MidiToPitchLabel(int midi)
    {
        var octave = (midi / 12) - 1;
        var name = PitchNames[((midi % 12) + 12) % 12];
        return $"{name}{octave}";
    }
}
