@using PoMode.Shared.Analysis
@inject AnalysisClient Analysis

@* Local Ollama explanation of the selected window (spec §5). Always optional: with no Ollama the
   card says so and offers a retry. Never a cloud call — the server refuses any non-loopback address. *@

<RadzenCard class="hud-card copilot">
    <RadzenText TextStyle="TextStyle.H6" Text="Copilot" />

    @if (WindowIndex is null)
    {
        <RadzenText class="hud-sub" Text="Select a window to have it explained." />
    }
    else if (_busy)
    {
        <RadzenText class="hud-sub" Text="Asking your local model…" />
    }
    else if (_reply is { Available: true, Markdown: not null } available)
    {
        @* Rendered through MiniMarkdown, which escapes first and only re-adds a fixed inline subset —
           this is language-model output, so it is never trusted as markup. *@
        <div class="copilot-body">@((MarkupString)MiniMarkdown.ToHtml(available.Markdown))</div>
        <RadzenText class="hud-sub" Text="@($"via {available.Model} on this machine")" />
    }
    else if (_reply is not null)
    {
        <RadzenText class="hud-sub copilot-unavailable" Text="Copilot unavailable" />
        <RadzenText class="hud-sub" Text="@_reply.Reason" />
    }
    else
    {
        <RadzenText class="hud-sub" Text="Not asked yet." />
    }

    @if (WindowIndex is not null)
    {
        <RadzenButton Click="AskAsync" Disabled="_busy" ButtonStyle="ButtonStyle.Light"
                      Text="@(_reply is null ? "Explain" : "Regenerate")" class="copilot-button" />
    }
</RadzenCard>

@code {
    [Parameter, EditorRequired] public required string JobId { get; set; }

    [Parameter] public int? WindowIndex { get; set; }

    private CopilotReply? _reply;
    private bool _busy;
    private int? _askedFor;

    /// <summary>Selecting a different window invalidates the previous explanation.</summary>
    protected override void OnParametersSet()
    {
        if (_askedFor != WindowIndex)
        {
            _reply = null;
            _askedFor = null;
        }
    }

    private async Task AskAsync()
    {
        if (WindowIndex is not { } index)
        {
            return;
        }
        _busy = true;
        _reply = null;
        try
        {
            _reply = await Analysis.ExplainAsync(JobId, index);
            _askedFor = index;
        }
        finally
        {
            _busy = false;
        }
    }
}
