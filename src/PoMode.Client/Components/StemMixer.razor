@implements IAsyncDisposable
@inject IJSRuntime Js

@* Transport and stem selector (spec §7). The Web Audio clock lives in mixer.js, which drives the
   canvas playhead directly; this component only issues commands and shows status. State is mirrored
   onto data-mixer-* attributes by the module, so it is inspectable and assertable. *@

<div class="mixer" @ref="_root">
    @if (_status is "unavailable")
    {
        <RadzenText class="mixer-note" Text="Stem audio is not available for this job." />
    }
    else
    {
        <RadzenButton Click="TogglePlayAsync" Disabled="@(_status is "idle" or "loading")"
                      Text="@(_status == "playing" ? "Pause" : "Play")" class="mixer-play" />
        <div class="mixer-modes" role="group" aria-label="Stem selection">
            @foreach (var (mode, label) in Modes)
            {
                <RadzenButton Click="@(() => SetModeAsync(mode))"
                              Disabled="@(_status is "idle" or "loading")"
                              ButtonStyle="@(_mode == mode ? ButtonStyle.Primary : ButtonStyle.Light)"
                              Text="@label" />
            }
        </div>
        <RadzenText class="mixer-note" Text="@StatusText" />
    }
</div>

@code {
    private static readonly (string Mode, string Label)[] Modes =
    [
        ("full", "Full Mix"),
        ("vocals", "Solo Vocals"),
        ("backing", "Solo Backing"),
    ];

    /// <summary>Job whose stems to play. Changing it reloads the mixer.</summary>
    [Parameter, EditorRequired] public required string JobId { get; set; }

    /// <summary>The canvas whose playhead this mixer drives.</summary>
    [Parameter, EditorRequired] public ElementReference CanvasElement { get; set; }

    /// <summary>Seconds to jump to, raised when the user clicks the canvas.</summary>
    [Parameter] public double SeekToSec { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _module;
    private string _status = "idle";
    private string _mode = "full";
    private double _duration;
    private string? _loadedJobId;
    private double? _sentSeek;

    private string StatusText => _duration <= 0
        ? "Loading stems…"
        : $"{Modes.First(entry => entry.Mode == _mode).Label} · {_duration:0.0}s of audio";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/mixer.js");
            await _module.InvokeVoidAsync("init", _root, CanvasElement);
        }
        if (_module is null)
        {
            return;
        }

        if (_loadedJobId != JobId)
        {
            _loadedJobId = JobId;
            _status = "loading";
            _duration = await _module.InvokeAsync<double>("load", _root, new
            {
                mix = $"api/analysis/{JobId}/stems/mix",
                vocals = $"api/analysis/{JobId}/stems/vocals",
                instrumental = $"api/analysis/{JobId}/stems/instrumental",
            });
            _status = _duration > 0 ? "ready" : "unavailable";
            _sentSeek = null;
            StateHasChanged();
            return;
        }

        if (_sentSeek != SeekToSec)
        {
            _sentSeek = SeekToSec;
            await _module.InvokeVoidAsync("seek", _root, SeekToSec);
        }
    }

    private async Task TogglePlayAsync()
    {
        if (_module is null)
        {
            return;
        }
        if (_status == "playing")
        {
            await _module.InvokeVoidAsync("pause", _root);
            _status = "paused";
        }
        else
        {
            await _module.InvokeVoidAsync("play", _root);
            _status = "playing";
        }
    }

    private async Task SetModeAsync(string mode)
    {
        if (_module is null)
        {
            return;
        }
        _mode = mode;
        await _module.InvokeVoidAsync("setMode", _root, mode);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone during teardown.
            }
        }
    }
}
