@implements IAsyncDisposable
@inject IJSRuntime Js

@* Transport and stem selector. The Web Audio clock lives in mixer.js, which drives the canvas
   playhead directly; this component only issues commands and shows status. State is mirrored onto
   data-mixer-* attributes by the module, so it is inspectable and assertable.

   One control set, not two. This used to render a "basic" strip and an "advanced" strip behind a
   Basic parameter, which meant every control existed twice with different semantics — Solo Synth
   here, three independent synth toggles plus a Mute there. Two answers to "what does this button
   do" is the expensive kind of flexibility.

   The three sources stay mutually exclusive; the two solo layers combine freely and mute the stems
   while either is on. Space and comma work globally (play/pause, back to start) via mixer.js's
   document key handler. *@

<div class="mixer" @ref="_root">
    @if (_status is "unavailable")
    {
        <RadzenText class="mixer-note" Text="Stem audio is not available for this job." />
    }
    else
    {
        @* Three kinds of control, drawn as three: Play; one either-or choice of what the audio is (a
           select bar, because picking Vocals un-picks Full mix); and the synth layers, which combine
           freely and mute the stems while either is on. The metronome is its own toggle. Seven
           same-weight buttons used to say none of that. *@
        <div class="mixer-groups">
            <RadzenButton Click="TogglePlayAsync" Disabled="@Loading" Icon="@(_status == "playing" ? "pause" : "play_arrow")"
                          Text="@(_status == "playing" ? "Pause" : "Play")" class="mixer-play"
                          title="Space = play/pause, , = restart" />

            <div class="mixer-group">
                <span class="mixer-group-label" id="mixer-audio-label">Audio</span>
                <RadzenSelectBar TValue="string" Value="@(_stemsMuted ? null : _mode)" Change="@SelectSourceAsync"
                                 Disabled="@Loading" Size="ButtonSize.Small" class="mixer-sources"
                                 AriaLabelledBy="mixer-audio-label">
                    <Items>
                        @foreach (var (mode, label) in Modes)
                        {
                            <RadzenSelectBarItem Text="@label" Value="@mode" />
                        }
                    </Items>
                </RadzenSelectBar>
            </div>

            <div class="mixer-group">
                <span class="mixer-group-label" id="mixer-synth-label">Synth</span>
                <RadzenSelectBar TValue="IEnumerable<string>" Multiple="true" Value="@SynthLayersOn"
                                 Change="@SetSynthLayersAsync" Disabled="@Loading" Size="ButtonSize.Small"
                                 class="mixer-synths" AriaLabelledBy="mixer-synth-label">
                    <Items>
                        <RadzenSelectBarItem Text="Melody" Value="@("vocal")" Disabled="@(_vocalNoteCount == 0)" />
                        <RadzenSelectBarItem Text="Chords" Value="@("chords")" Disabled="@(_chordNoteCount == 0)" />
                    </Items>
                </RadzenSelectBar>
            </div>

            @* Hearing the click against the track is the fastest way to judge whether the detected
               tempo is right, so the metronome sits with the sources rather than behind a disclosure. *@
            <RadzenButton Click="@(() => SetMetronomeAsync(!_metronomeOn))"
                          Disabled="@(Loading || _beatBpm <= 0)" Icon="timer" Size="ButtonSize.Small"
                          ButtonStyle="@(_metronomeOn ? ButtonStyle.Primary : ButtonStyle.Light)"
                          Variant="@(_metronomeOn ? Variant.Flat : Variant.Filled)"
                          Shade="@(_metronomeOn ? Shade.Lighter : Shade.Default)"
                          aria-pressed="@(_metronomeOn ? "true" : "false")"
                          Text="@($"Click · {BpmReadout}")" title="@MetronomeTitle" class="mixer-click" />
        </div>

        @* The always-visible key legend is gone: the header's "Keyboard shortcuts" modal carries
           the full list, and every button's tooltip names its key. One less row of noise. *@
        <div class="mixer-status-line @(_status is "loading" or "idle" ? "loading-active" : "")">
            @if (_status is "loading" or "idle")
            {
                <span class="mixer-pulse-dot" aria-hidden="true"></span>
            }
            <RadzenText class="mixer-note" Text="@StatusText" />
        </div>
        @if (_loadError is not null)
        {
            <div class="mixer-error-bar">
                <span class="mixer-error-msg">⚠️ @_loadError</span>
                <button type="button" class="mixer-retry-btn" @onclick="RetryLoad">↻ Retry</button>
            </div>
        }
        @* The bar's room stays when it goes, so the page under the player does not jump up the moment
           the stems finish loading. *@
        <div class="mixer-loading-slot">
            @if (Loading)
            {
                <RadzenProgressBar class="mixer-loading" Value="100" ShowValue="false"
                                   Mode="ProgressBarMode.Indeterminate" aria-label="Loading stems" />
            }
        </div>
    }
</div>

@code {
    private static readonly (string Mode, string Label)[] Modes =
    [
        ("full", "Full mix"),
        ("vocals", "Vocals"),
        ("backing", "Backing"),
    ];

    /// <summary>Job whose stems to play. Changing it reloads the mixer.</summary>
    [Parameter, EditorRequired] public required string JobId { get; set; }

    /// <summary>Whether the job has a bar-by-bar tempo map. Asked for only when it does: the mixer used
    /// to fetch it for every song and log a 404 for each one analysed without a beat tracker.</summary>
    [Parameter] public bool HasTempoMap { get; set; }

    /// <summary>The canvas whose playhead this mixer drives.</summary>
    [Parameter, EditorRequired] public ElementReference CanvasElement { get; set; }

    /// <summary>Seconds to jump to, raised when the user clicks the canvas.</summary>
    [Parameter] public double SeekToSec { get; set; }

    /// <summary>
    /// Raised with the tempo of the measure the playhead has just entered, so a parent showing a
    /// headline BPM can follow the performance instead of a whole-song average. Fires at most once
    /// per measure.
    /// </summary>
    [Parameter] public EventCallback<double> OnTempoChangedCallback { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<StemMixer>? _selfRef;
    private string _status = "idle";
    private string _mode = "full";
    private double _duration;
    private int _vocalNoteCount;
    private int _backingNoteCount;
    private int _chordNoteCount;

    /// <summary>mixer.js's note-source names — the one C# copy of its NOTE_SOURCE_NAMES.</summary>
    private static readonly string[] SynthSources = ["vocal", "backing", "chords"];

    /// <summary>Which synth layers are audible, keyed by <see cref="SynthSources"/> names —
    /// the same shape as mixer.js's noteSources map.</summary>
    private readonly Dictionary<string, bool> _synthOn = [];

    private bool SynthOn(string source) => _synthOn.GetValueOrDefault(source);

    private bool AnySynthOn => SynthSources.Any(SynthOn);

    private bool Loading => _status is "idle" or "loading";

    /// <summary>The layers the synth select bar offers — the backing transcription has no button.</summary>
    private static readonly string[] SoloLayers = ["vocal", "chords"];

    /// <summary>The synth select bar's value: which of its layers are sounding.</summary>
    private IEnumerable<string> SynthLayersOn => SoloLayers.Where(SynthOn).ToList();

    private bool _metronomeOn;
    private double _beatBpm;

    /// <summary>The tempo of the measure the playhead is in, pushed from mixer.js as it changes.</summary>
    private double _liveBpm;
    private IJSObjectReference? _sfx;
    private bool _stemsMuted;
    private string? _loadedJobId;
    private double? _sentSeek;
    private DateTimeOffset? _loadStartTime;
    private int _loadElapsedSec;
    private Timer? _loadTimer;
    private string _loadingPhase = "Downloading audio stems…";
    private string? _loadError;
    private bool _retryRequested;

    [JSInvokable]
    public void OnStemLoadProgress(string phase)
    {
        _loadingPhase = phase;
        StateHasChanged();
    }

    private string StatusText
    {
        get
        {
            if (_status is "loading" or "idle" || _duration <= 0)
            {
                var timeNote = _loadElapsedSec > 0 ? $" ({_loadElapsedSec}s elapsed)" : "";
                return $"Preparing audio stems… {_loadingPhase}{timeNote}";
            }
            if (_stemsMuted && (SynthOn("vocal") || SynthOn("chords")))
            {
                return (SynthOn("vocal"), SynthOn("chords")) switch
                {
                    (true, true) => $"Synth melody and chords · {_vocalNoteCount} melody notes · {_chordNoteCount} chord tones · {_duration:0.0}s",
                    (true, false) => $"Synth melody · {_vocalNoteCount} notes · {_duration:0.0}s",
                    _ => $"Synth chords · {_chordNoteCount} chord tones · {_duration:0.0}s",
                };
            }
            var label = Modes.FirstOrDefault(entry => entry.Mode == _mode).Label ?? _mode;
            return $"{label} · {_duration:0.0}s of audio";
        }
    }

    /// <summary>
    /// mixer.js reports the tempo of the measure the playhead is in. It fires only when the value
    /// actually changes — at most once a measure — so this stays a discrete event and playback still
    /// costs no per-frame renders.
    /// </summary>
    [JSInvokable]
    public void OnTempoChanged(double bpm)
    {
        if (Math.Abs(_liveBpm - bpm) < 0.05)
        {
            return;
        }
        _liveBpm = bpm;
        _ = OnTempoChangedCallback.InvokeAsync(bpm);
        StateHasChanged();
    }

    private string MetronomeTitle => _beatBpm > 0
        ? $"Click at {_beatBpm:0} BPM"
        : "No beat grid available for this job";

    /// <summary>
    /// Prefers the measure the playhead is actually in. A drifting performance makes one whole-song
    /// average wrong nearly everywhere, and the click the user hears follows the map, so the number
    /// beside the button has to follow it too.
    /// </summary>
    private string BpmReadout => (_liveBpm > 0 ? _liveBpm : _beatBpm) switch
    {
        > 0 and var bpm => $"{bpm:0} BPM",
        _ => "— BPM",
    };

    private void RetryLoad()
    {
        _retryRequested = true;
        _loadedJobId = null;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/player/mixer.js");
                _selfRef = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("init", _root, CanvasElement, _selfRef);
            }
            catch (Exception ex)
            {
                _loadError = $"Mixer init failed: {ex.Message}";
                _status = "unavailable";
                StateHasChanged();
                return;
            }
        }
        if (_module is null)
        {
            return;
        }

        if (_loadedJobId != JobId || _retryRequested)
        {
            _retryRequested = false;
            _loadedJobId = JobId;
            _status = "loading";
            _loadError = null;
            _loadStartTime = DateTimeOffset.UtcNow;
            _loadElapsedSec = 0;
            _loadingPhase = "Downloading audio stems…";
            _loadTimer?.Dispose();
            _loadTimer = new Timer(_ =>
            {
                if (_status is "loading" or "idle")
                {
                    if (_loadStartTime.HasValue)
                    {
                        _loadElapsedSec = (int)(DateTimeOffset.UtcNow - _loadStartTime.Value).TotalSeconds;
                    }
                    _ = InvokeAsync(StateHasChanged);
                }
            }, null, 500, 500);

            try
            {
                _duration = await _module.InvokeAsync<double>("load", _root, new
                {
                    mix = $"api/analysis/{JobId}/stems/mix",
                    vocals = $"api/analysis/{JobId}/stems/vocals",
                    instrumental = $"api/analysis/{JobId}/stems/instrumental",
                });
                _status = _duration > 0 ? "ready" : "unavailable";
                if (_duration <= 0)
                {
                    _loadError = "Could not load audio stems from server.";
                }
            }
            catch (Exception ex)
            {
                _loadError = $"Audio load error: {ex.Message}";
                _status = "unavailable";
            }
            finally
            {
                _loadTimer?.Dispose();
                _loadTimer = null;
            }

            _sentSeek = null;
            _synthOn.Clear();
            _metronomeOn = false;
            _beatBpm = 0;
            _liveBpm = 0;
            _stemsMuted = false;
            if (_status == "ready")
            {
                try
                {
                    // The transcriptions feed the synth layers; a missing artifact keeps its button
                    // disabled rather than failing the mixer. Same for the beat grid and the click.
                    var counts = await _module.InvokeAsync<int[]>("loadNotes", _root, new
                    {
                        vocal = $"api/analysis/{JobId}/notes",
                        backing = $"api/analysis/{JobId}/notes-backing",
                        chords = $"api/analysis/{JobId}/notes-chords",
                    });
                    // loadNotes always answers [vocal, backing, chords].
                    (_vocalNoteCount, _backingNoteCount, _chordNoteCount) = (counts[0], counts[1], counts[2]);
                    _beatBpm = await _module.InvokeAsync<double>("loadBeats", _root, $"api/analysis/{JobId}/beats");
                    // Optional: absent when no beat tracker ran (a demo or a hum take, whose tempo was
                    // given) or the job predates the map. The metronome then keeps to the grid above.
                    if (HasTempoMap)
                    {
                        await _module.InvokeAsync<double>(
                            "loadTempoMap", _root, $"api/analysis/{JobId}/tempo-map", _duration);
                    }
                }
                catch
                {
                    // Secondary artifact loading errors don't prevent playback
                }
            }
            StateHasChanged();
            return;
        }

        if (_sentSeek != SeekToSec)
        {
            _sentSeek = SeekToSec;
            await _module.InvokeVoidAsync("seek", _root, SeekToSec);
        }
    }

    /// <summary>mixer.js reports keyboard-driven transport changes so the Play button's label
    /// stays truthful; playback itself already happened on the JS side.</summary>
    [JSInvokable]
    public void OnTransportKey(bool playing)
    {
        if (_status is "idle" or "loading" or "unavailable")
        {
            return;
        }
        _status = playing ? "playing" : "paused";
        StateHasChanged();
    }

    /// <summary>Fire-and-forget UI sound; failures (autoplay policy, teardown) stay silent.</summary>
    private async Task PlayFxAsync(string name)
    {
        try
        {
            _sfx ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/shell/sfx.js");
            await _sfx.InvokeVoidAsync(name);
        }
        catch (JSException)
        {
            // Sounds are garnish, never an error.
        }
    }

    private async Task TogglePlayAsync()
    {
        if (_module is null)
        {
            return;
        }
        if (_status == "playing")
        {
            await _module.InvokeVoidAsync("pause", _root);
            _status = "paused";
            await PlayFxAsync("click");
        }
        else
        {
            await _module.InvokeVoidAsync("play", _root);
            _status = "playing";
            await PlayFxAsync("whoosh");
        }
    }

    /// <summary>Picks which audio source plays, switching every solo layer off.</summary>
    private async Task SelectSourceAsync(string source)
    {
        if (_module is null)
        {
            return;
        }
        _mode = source;
        if (_stemsMuted)
        {
            _stemsMuted = false;
            await _module.InvokeVoidAsync("setStemsMuted", _root, false);
        }
        foreach (var layer in SynthSources)
        {
            if (SynthOn(layer))
            {
                await SetNotesAsync(layer, false);
            }
        }
        await _module.InvokeVoidAsync("setMode", _root, source);
        await PlayFxAsync("click");
        StateHasChanged();
    }

    /// <summary>
    /// The synth melody and chord layers combine freely; the select bar hands back whichever are now
    /// picked. The stems stay muted while any layer is on; when the last one turns off, the audio
    /// source the user had before (still in <c>_mode</c>) comes back.
    /// </summary>
    private async Task SetSynthLayersAsync(IEnumerable<string>? picked)
    {
        if (_module is null)
        {
            return;
        }
        var wanted = picked?.ToHashSet() ?? [];
        foreach (var layer in SoloLayers)
        {
            if (wanted.Contains(layer) != SynthOn(layer))
            {
                await SetNotesAsync(layer, wanted.Contains(layer));
            }
        }
        var anySolo = AnySynthOn;
        if (_stemsMuted != anySolo)
        {
            _stemsMuted = anySolo;
            await _module.InvokeVoidAsync("setStemsMuted", _root, anySolo);
        }
        await PlayFxAsync("click");
        StateHasChanged();
    }

    private async Task SetNotesAsync(string source, bool on)
    {
        if (_module is null || !SynthSources.Contains(source))
        {
            return;
        }
        _synthOn[source] = on;
        await _module.InvokeVoidAsync("setNoteSource", _root, source, on);
        // The canvas glow channel follows the synth on/off so the user sees what's audible.
        // Only vocal and backing have overlay channels; canvas.js ignores anything else anyway.
        if (source is "vocal" or "backing")
        {
            try
            {
                await _module.InvokeVoidAsync("setOverlay", _root, source, on);
            }
            catch (JSDisconnectedException)
            {
                // circuit torn down
            }
        }
    }

    private async Task SetMetronomeAsync(bool on)
    {
        if (_module is null)
        {
            return;
        }
        _metronomeOn = on;
        await _module.InvokeVoidAsync("setMetronome", _root, on);
    }

    public async ValueTask DisposeAsync()
    {
        _loadTimer?.Dispose();
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose", _root);
                await _module.DisposeAsync();
            }
            if (_sfx is not null)
            {
                await _sfx.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone during teardown.
        }
        _selfRef?.Dispose();
    }
}
