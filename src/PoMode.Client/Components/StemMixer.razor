@implements IAsyncDisposable
@inject IJSRuntime Js

@* Transport and stem selector (spec §7). The Web Audio clock lives in mixer.js, which drives the
   canvas playhead directly; this component only issues commands and shows status. State is mirrored
   onto data-mixer-* attributes by the module, so it is inspectable and assertable.

   The stem modes stay mutually exclusive; the note overlays and the metronome are independent
   toggles, so each button only ever shows or hides its own layer. Space and comma work globally
   (play/pause, back to start) via mixer.js's document key handler. *@

<div class="mixer" @ref="_root">
    @if (_status is "unavailable")
    {
        <RadzenText class="mixer-note" Text="Stem audio is not available for this job." />
    }
    else
    {
        @* The strip is three labelled groups so a glance tells you which controls affect audio
           routing, which turn on a synthetic layer, and which are playback verbs. *@
        <div class="mixer-groups">
            <div class="mixer-group mixer-group-play" role="group" aria-label="Transport">
                <RadzenButton Click="TogglePlayAsync" Disabled="@(_status is "idle" or "loading")"
                              Text="@(_status == "playing" ? "Pause" : "Play")" class="mixer-play"
                              title="Space = play/pause, , = restart" />
            </div>

            <div class="mixer-group mixer-group-source" role="group" aria-label="Audio source">
                <span class="mixer-group-label">Source</span>
                @if (Basic)
                {
                    @foreach (var (mode, label) in Modes)
                    {
                        <RadzenButton Click="@(() => SelectBasicSourceAsync(mode))"
                                      Disabled="@(_status is "idle" or "loading")"
                                      ButtonStyle="@(_mode == mode && !_stemsMuted && !_vocalSynthOn ? ButtonStyle.Primary : ButtonStyle.Light)"
                                      Text="@label" />
                    }
                    <RadzenButton Click="@(() => SelectBasicSourceAsync("synth"))"
                                  Disabled="@(_status is "idle" or "loading" || _vocalNoteCount == 0)"
                                  ButtonStyle="@(_stemsMuted && _vocalSynthOn ? ButtonStyle.Primary : ButtonStyle.Light)"
                                  Text="Solo Synth" title="Solo the transcribed vocal melody as synth MIDI lead (mutes audio stems)" />
                }
                else
                {
                    <RadzenToggleButton Value="@_stemsMuted" Change="@SetStemsMutedAsync"
                                        Disabled="@(_status is "idle" or "loading")"
                                        ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Primary"
                                        Text="Mute stems" title="Silence the separated audio — keep only synth/click/drone" />
                    @foreach (var (mode, label) in Modes)
                    {
                        <RadzenButton Click="@(() => SetModeAsync(mode))"
                                      Disabled="@(_status is "idle" or "loading")"
                                      ButtonStyle="@(_mode == mode && !_stemsMuted ? ButtonStyle.Primary : ButtonStyle.Light)"
                                      Text="@label" />
                    }
                    <RadzenToggleButton Value="@_vocalSynthOn" Change="@(on => SetNotesAsync("vocal", on))"
                                        Disabled="@(_status is "idle" or "loading" || _vocalNoteCount == 0)"
                                        ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Primary"
                                        Text="Synth vocal" title="Play the transcribed vocal melody as a synth lead (MIDI)" />
                    <RadzenToggleButton Value="@_backingSynthOn" Change="@(on => SetNotesAsync("backing", on))"
                                        Disabled="@(_status is "idle" or "loading" || _backingNoteCount == 0)"
                                        ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Primary"
                                        Text="Synth backing" title="Play the transcribed backing notes as a synth pad (MIDI)" />
                }
            </div>

            @if (!Basic)
            {
                <div class="mixer-group mixer-group-layers" role="group" aria-label="Layers and helpers">
                    <span class="mixer-group-label">Layers</span>
                    <RadzenToggleButton Value="@_vocalNotesOn" Change="@(on => SetOverlayAsync("vocal", on))"
                                        Disabled="@(_status is "idle" or "loading" || _vocalNoteCount == 0)"
                                        ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Primary"
                                        Text="Show vocal notes" title="Highlight the vocal notes on the canvas (no audio)" />
                    <RadzenToggleButton Value="@_backingNotesOn" Change="@(on => SetOverlayAsync("backing", on))"
                                        Disabled="@(_status is "idle" or "loading" || _backingNoteCount == 0)"
                                        ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Primary"
                                        Text="Show backing notes" title="Highlight the backing notes on the canvas (no audio)" />
                    <div class="metronome-cell" title="@MetronomeTitle">
                        <RadzenToggleButton Value="@_metronomeOn" Change="@SetMetronomeAsync"
                                            Disabled="@(_status is "idle" or "loading" || _beatBpm <= 0)"
                                            ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Primary"
                                            Text="Metronome" />
                        <div class="bpm-nudge" role="group" aria-label="Tempo nudge">
                            <button class="icon-button bpm-step" type="button" @onclick="@(() => NudgeBpmAsync(-2))"
                                    disabled="@(_status is "idle" or "loading" || _beatBpm <= 0)"
                                    title="Slower (2 BPM)" aria-label="Slower 2 BPM">−</button>
                            <span class="bpm-readout">@BpmReadout</span>
                            <button class="icon-button bpm-step" type="button" @onclick="@(() => NudgeBpmAsync(2))"
                                    disabled="@(_status is "idle" or "loading" || _beatBpm <= 0)"
                                    title="Faster (2 BPM)" aria-label="Faster 2 BPM">+</button>
                            <button class="icon-button bpm-tap" type="button" @onclick="OnTapTempoAsync"
                                    disabled="@(_status is "idle" or "loading")"
                                    title="Tap tempo (3+ taps)" aria-label="Tap tempo">TAP</button>
                        </div>
                    </div>
                    <div class="drone-cell" title="@($"Drone on {TonicName ?? "the detected tonic"}")">
                        <RadzenToggleButton Value="@_droneOn" Change="@SetDroneAsync"
                                            Disabled="@(_status is "idle" or "loading" || TonicPitchClass is null)"
                                            ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Primary"
                                            Text="Drone" />
                        @if (TonicName is not null)
                        {
                            <span class="drone-readout">@TonicName</span>
                        }
                    </div>
                    <RadzenToggleButton Value="@_karaokeOn" Change="@SetKaraokeAsync"
                                        Disabled="@(_status is "idle" or "loading" || _vocalNoteCount == 0)"
                                        ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Primary"
                                        Text="Karaoke"
                                        title="@KaraokeTitle" />
                </div>
            }
        </div>

        @if (!Basic)
        {
            @* Always-visible affordance for the keyboard verbs a mixer user actually needs. *@
            <p class="mixer-keys" aria-label="Keyboard shortcuts">
                <kbd>Space</kbd> play/pause <span class="key-sep">·</span>
                <kbd>,</kbd> restart <span class="key-sep">·</span>
                <kbd>M</kbd> mute stems <span class="key-sep">·</span>
                <kbd>1</kbd>/<kbd>2</kbd>/<kbd>3</kbd> mix/vocals/backing <span class="key-sep">·</span>
                <kbd>V</kbd>/<kbd>B</kbd> synth vocal/backing <span class="key-sep">·</span>
                <kbd>K</kbd> karaoke
            </p>
        }

        @if (!Basic)
        {
            <canvas class="mixer-spectrum" @ref="_spectrumCanvas" aria-hidden="true"></canvas>
        }
        <div class="mixer-status-line @(_status is "loading" or "idle" ? "loading-active" : "")">
            @if (_status is "loading" or "idle")
            {
                <span class="mixer-pulse-dot" aria-hidden="true"></span>
            }
            <RadzenText class="mixer-note" Text="@StatusText" />
            <button type="button" class="mixer-debug-toggle" @onclick="() => _showDebug = !_showDebug"
                    title="Toggle audio engine diagnostics">
                🐞 @(_showDebug ? "Hide Info" : "Debug Info")
            </button>
        </div>
        @if (_loadError is not null)
        {
            <div class="mixer-error-bar">
                <span class="mixer-error-msg">⚠️ @_loadError</span>
                <button type="button" class="mixer-retry-btn" @onclick="RetryLoad">↻ Retry</button>
            </div>
        }
        @if (_showDebug)
        {
            <div class="mixer-debug-panel">
                <div class="debug-row"><span>Audio Engine:</span> <strong>@(_status is "ready" ? "Active (Web Audio)" : _status)</strong></div>
                <div class="debug-row"><span>Current Phase:</span> <strong>@_loadingPhase (@(_loadElapsedSec)s)</strong></div>
                <div class="debug-row"><span>Decoded Audio:</span> <strong>@($"{_duration:0.0}s")</strong></div>
                <div class="debug-row"><span>Transcribed Notes:</span> <strong>@_vocalNoteCount vocal · @_backingNoteCount backing</strong></div>
                <div class="debug-row"><span>Job ID:</span> <code>@JobId</code></div>
                @if (_loadError is not null)
                {
                    <div class="debug-row debug-error"><span>Error:</span> <strong>@_loadError</strong></div>
                }
            </div>
        }
        @if (_status is "loading" or "idle")
        {
            <RadzenProgressBar class="mixer-loading" Value="100" ShowValue="false"
                               Mode="ProgressBarMode.Indeterminate" aria-label="Loading stems" />
        }
        @if (_karaokeError is not null)
        {
            <RadzenText class="mixer-note karaoke-error" Text="@_karaokeError" />
        }
    }
</div>

@code {
    private static readonly (string Mode, string Label)[] Modes =
    [
        ("full", "Full Mix"),
        ("vocals", "Solo Vocals"),
        ("backing", "Solo Backing"),
    ];

    /// <summary>Job whose stems to play. Changing it reloads the mixer.</summary>
    [Parameter, EditorRequired] public required string JobId { get; set; }

    /// <summary>The canvas whose playhead this mixer drives.</summary>
    [Parameter, EditorRequired] public ElementReference CanvasElement { get; set; }

    /// <summary>Seconds to jump to, raised when the user clicks the canvas.</summary>
    [Parameter] public double SeekToSec { get; set; }

    /// <summary>The detected tonic (server-decided), enabling the drone toggle when present.</summary>
    [Parameter] public string? TonicName { get; set; }
    [Parameter] public int? TonicPitchClass { get; set; }

    /// <summary>When true, renders the streamlined basic playback controls only.</summary>
    [Parameter] public bool Basic { get; set; }

    private ElementReference _root;
    private ElementReference _spectrumCanvas;
    private IJSObjectReference? _module;
    private IJSObjectReference? _spectrum;
    private bool _droneOn;
    private DotNetObjectReference<StemMixer>? _selfRef;
    private string _status = "idle";
    private string _mode = "full";
    private double _duration;
    private int _vocalNoteCount;
    private int _backingNoteCount;
    private bool _vocalSynthOn;   // MIDI synth: routes through mixer.js oscillator bank
    private bool _backingSynthOn; // MIDI synth: routes through mixer.js oscillator bank
    private bool _vocalNotesOn;   // canvas overlay: glows vocal dots
    private bool _backingNotesOn; // canvas overlay: backing has no canvas yet, kept for parity
    private bool _metronomeOn;
    private double _beatBpm;
    private double _bpmNudge;     // user-adjusted offset from server tempo
    private bool _karaokeOn;
    private int _karaokeScore;
    private string? _karaokeError;
    private Timer? _karaokeTimer;
    private readonly List<double> _tapTimes = new();
    private bool _stemsMuted;
    private string? _loadedJobId;
    private double? _sentSeek;
    private DateTimeOffset? _loadStartTime;
    private int _loadElapsedSec;
    private Timer? _loadTimer;
    private string _loadingPhase = "Downloading audio stems…";

    [JSInvokable]
    public void OnStemLoadProgress(string phase)
    {
        _loadingPhase = phase;
        StateHasChanged();
    }

    private string StatusText
    {
        get
        {
            if (_status is "loading" or "idle" || _duration <= 0)
            {
                var timeNote = _loadElapsedSec > 0 ? $" ({_loadElapsedSec}s elapsed)" : "";
                return $"Preparing audio stems… {_loadingPhase}{timeNote}";
            }
            if (_mode == "synth")
            {
                return $"Solo Synth · {_vocalNoteCount} melody notes · {_duration:0.0}s";
            }
            var label = Modes.FirstOrDefault(entry => entry.Mode == _mode).Label ?? _mode;
            return $"{label} · {_duration:0.0}s of audio";
        }
    }

    private string MetronomeTitle => _beatBpm > 0
        ? $"Click at {(_beatBpm + _bpmNudge):0} BPM{(Math.Abs(_bpmNudge) > 0.01 ? $" (server {_beatBpm:0} + nudge {_bpmNudge:+0;-0;0})" : "")}"
        : "No beat grid available for this job";

    private string BpmReadout => _beatBpm > 0 ? $"{(_beatBpm + _bpmNudge):0} BPM" : "— BPM";

    private string KaraokeTitle => _karaokeOn
        ? $"Karaoke scoring: {_karaokeScore}%"
        : "Mute vocal stem, open mic, score your singing against the melody";

    private string? _loadError;
    private bool _showDebug;
    private bool _retryRequested;

    private void RetryLoad()
    {
        _retryRequested = true;
        _loadedJobId = null;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/mixer.js");
                _selfRef = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("init", _root, CanvasElement, _selfRef);
                if (!Basic)
                {
                    _spectrum = await Js.InvokeAsync<IJSObjectReference>("import", "./js/fx-spectrum.js");
                    await _spectrum.InvokeVoidAsync("init", _spectrumCanvas);
                }
            }
            catch (Exception ex)
            {
                _loadError = $"Mixer init failed: {ex.Message}";
                _status = "unavailable";
                StateHasChanged();
                return;
            }
        }
        if (_module is null)
        {
            return;
        }

        if (_loadedJobId != JobId || _retryRequested)
        {
            _retryRequested = false;
            _loadedJobId = JobId;
            _status = "loading";
            _loadError = null;
            _loadStartTime = DateTimeOffset.UtcNow;
            _loadElapsedSec = 0;
            _loadingPhase = "Downloading audio stems…";
            _loadTimer?.Dispose();
            _loadTimer = new Timer(_ =>
            {
                if (_status is "loading" or "idle")
                {
                    if (_loadStartTime.HasValue)
                    {
                        _loadElapsedSec = (int)(DateTimeOffset.UtcNow - _loadStartTime.Value).TotalSeconds;
                    }
                    _ = InvokeAsync(StateHasChanged);
                }
            }, null, 500, 500);

            try
            {
                _duration = await _module.InvokeAsync<double>("load", _root, new
                {
                    mix = $"api/analysis/{JobId}/stems/mix",
                    vocals = $"api/analysis/{JobId}/stems/vocals",
                    instrumental = $"api/analysis/{JobId}/stems/instrumental",
                });
                _status = _duration > 0 ? "ready" : "unavailable";
                if (_duration <= 0)
                {
                    _loadError = "Could not load audio stems from server.";
                }
            }
            catch (Exception ex)
            {
                _loadError = $"Audio load error: {ex.Message}";
                _status = "unavailable";
            }
            finally
            {
                _loadTimer?.Dispose();
                _loadTimer = null;
            }

            _sentSeek = null;
            _vocalSynthOn = false;
            _backingSynthOn = false;
            _vocalNotesOn = false;
            _backingNotesOn = false;
            _metronomeOn = false;
            _beatBpm = 0;
            _bpmNudge = 0;
            _stemsMuted = false;
            _tapTimes.Clear();
            StopKaraokeTimer();
            _karaokeOn = false;
            _karaokeError = null;
            _droneOn = false; // mixer.js load() stops the drone itself; keep the toggle truthful
            if (_status == "ready")
            {
                try
                {
                    // The transcriptions feed the note overlays; a missing artifact keeps its toggle
                    // disabled rather than failing the mixer. Same for the beat grid and the metronome.
                    var counts = await _module.InvokeAsync<int[]>("loadNotes", _root, new
                    {
                        vocal = $"api/analysis/{JobId}/notes",
                        backing = $"api/analysis/{JobId}/notes-backing",
                    });
                    _vocalNoteCount = counts.Length > 0 ? counts[0] : 0;
                    _backingNoteCount = counts.Length > 1 ? counts[1] : 0;
                    _beatBpm = await _module.InvokeAsync<double>("loadBeats", _root, $"api/analysis/{JobId}/beats");
                }
                catch
                {
                    // Secondary artifact loading errors don't prevent playback
                }
            }
            StateHasChanged();
            return;
        }

        if (_sentSeek != SeekToSec)
        {
            _sentSeek = SeekToSec;
            await _module.InvokeVoidAsync("seek", _root, SeekToSec);
        }
    }

    /// <summary>mixer.js reports keyboard-driven transport changes so the Play button's label
    /// stays truthful; playback itself already happened on the JS side.</summary>
    [JSInvokable]
    public void OnTransportKey(bool playing)
    {
        if (_status is "idle" or "loading" or "unavailable")
        {
            return;
        }
        _status = playing ? "playing" : "paused";
        StateHasChanged();
    }

    /// <summary>mixer.js reports its M-key stems-mute shortcut so the toggle stays truthful.</summary>
    [JSInvokable]
    public void OnStemsMutedChanged(bool muted)
    {
        _stemsMuted = muted;
        StateHasChanged();
    }

    /// <summary>mixer.js reports its 1/2/3 source mode shortcut so the highlighted button tracks.</summary>
    [JSInvokable]
    public void OnModeShortcut(string mode)
    {
        _mode = mode;
        // Muting off when the user explicitly picks a source again — the keyboard is intent.
        if (_stemsMuted && mode != _mode)
        {
            _stemsMuted = false;
            _ = _module?.InvokeVoidAsync("setStemsMuted", _root, false);
        }
        StateHasChanged();
    }

    /// <summary>mixer.js reports its V/B synth toggles so the Synth buttons stay in sync.</summary>
    [JSInvokable]
    public void OnSynthToggle(string source, bool on)
    {
        if (source == "vocal")
        {
            _vocalSynthOn = on;
            _vocalNotesOn = on; // the canvas glow follows the synth on/off
        }
        else
        {
            _backingSynthOn = on;
        }
        StateHasChanged();
    }

    /// <summary>mixer.js fires K so the karaoke button label and score can refresh.</summary>
    [JSInvokable]
    public void OnKaraokeShortcut()
    {
        _ = SetKaraokeAsync(!_karaokeOn);
    }

    private async Task TogglePlayAsync()
    {
        if (_module is null)
        {
            return;
        }
        if (_status == "playing")
        {
            await _module.InvokeVoidAsync("pause", _root);
            _status = "paused";
        }
        else
        {
            await _module.InvokeVoidAsync("play", _root);
            _status = "playing";
        }
    }

    private async Task SetModeAsync(string mode)
    {
        if (_module is null)
        {
            return;
        }
        _mode = mode;
        await _module.InvokeVoidAsync("setMode", _root, mode);
    }

    private async Task SelectBasicSourceAsync(string source)
    {
        if (_module is null) return;
        if (source == "synth")
        {
            _mode = "synth";
            _stemsMuted = true;
            await _module.InvokeVoidAsync("setStemsMuted", _root, true);
            await SetNotesAsync("vocal", true);
        }
        else
        {
            _mode = source;
            if (_stemsMuted)
            {
                _stemsMuted = false;
                await _module.InvokeVoidAsync("setStemsMuted", _root, false);
            }
            if (_vocalSynthOn)
            {
                await SetNotesAsync("vocal", false);
            }
            await _module.InvokeVoidAsync("setMode", _root, source);
        }
        StateHasChanged();
    }

    private async Task SetNotesAsync(string source, bool on)
    {
        if (_module is null)
        {
            return;
        }
        if (source == "vocal")
        {
            _vocalSynthOn = on;
        }
        else
        {
            _backingSynthOn = on;
        }
        await _module.InvokeVoidAsync("setNoteSource", _root, source, on);
        // The canvas glow channel follows the synth on/off so the user sees what's audible.
        if (source == "vocal")
        {
            _vocalNotesOn = on;
        }
        try
        {
            await _module.InvokeVoidAsync("setOverlay", _root, source, on);
        }
        catch (JSDisconnectedException)
        {
            // circuit torn down
        }
    }

    /// <summary>Show/hide the canvas overlay without enabling the synth. Independent of <see cref="SetNotesAsync"/>.</summary>
    private async Task SetOverlayAsync(string source, bool on)
    {
        if (_module is null)
        {
            return;
        }
        if (source == "vocal")
        {
            _vocalNotesOn = on;
        }
        else
        {
            _backingNotesOn = on;
        }
        try
        {
            await _module.InvokeVoidAsync("setOverlay", _root, source, on);
        }
        catch (JSDisconnectedException)
        {
            // circuit torn down
        }
    }

    private async Task SetStemsMutedAsync(bool muted)
    {
        if (_module is null)
        {
            return;
        }
        _stemsMuted = muted;
        // Re-applying the current mode with a "muted" twist via a synthetic mode is cleanest: we
        // add two modes to the JS-side table on the fly by issuing setMode with a special key, but
        // simpler: temporarily zero the master gain.
        await _module.InvokeVoidAsync("setStemsMuted", _root, muted);
        StateHasChanged();
    }

    private async Task NudgeBpmAsync(double delta)
    {
        _bpmNudge = Math.Clamp(_bpmNudge + delta, -30, 30);
        await ApplyBpmAsync();
    }

    private async Task OnTapTempoAsync()
    {
        var now = DateTime.UtcNow;
        _tapTimes.Add(now.Ticks / (double)TimeSpan.TicksPerSecond);
        // Drop taps older than 2 s so the user can pace a fresh tap session without restarting.
        _tapTimes.RemoveAll(t => now.Ticks / (double)TimeSpan.TicksPerSecond - t > 2);
        if (_tapTimes.Count >= 2)
        {
            var diffs = new List<double>();
            for (var i = 1; i < _tapTimes.Count; i++)
            {
                diffs.Add(_tapTimes[i] - _tapTimes[i - 1]);
            }
            var avgInterval = diffs.Average();
            if (avgInterval > 0)
            {
                var tappedBpm = 60.0 / avgInterval;
                if (_beatBpm > 0)
                {
                    _bpmNudge = Math.Clamp(tappedBpm - _beatBpm, -30, 30);
                }
                else
                {
                    // No server grid — feed the absolute value straight to the metronome.
                    _beatBpm = tappedBpm;
                }
                await ApplyBpmAsync();
            }
        }
    }

    private async Task ApplyBpmAsync()
    {
        if (_module is null)
        {
            return;
        }
        await _module.InvokeVoidAsync("setBpmNudge", _root, _bpmNudge);
    }

    private async Task SetMetronomeAsync(bool on)
    {
        if (_module is null)
        {
            return;
        }
        _metronomeOn = on;
        await _module.InvokeVoidAsync("setMetronome", _root, on);
    }

    /// <summary>
    /// Karaoke: mute the vocal stem (solo backing), open the mic, and let mixer.js trace and score
    /// the singing against the vocal transcription. Turning it off restores the full mix.
    /// </summary>
    private async Task SetKaraokeAsync(bool on)
    {
        if (_module is null)
        {
            return;
        }
        if (on)
        {
            _karaokeError = null;
            if (!await _module.InvokeAsync<bool>("startKaraoke", _root))
            {
                _karaokeOn = false;
                _karaokeError = "Microphone access was denied or is unavailable.";
                return;
            }
            _karaokeOn = true;
            _karaokeScore = 0;
            await SetModeAsync("backing");
            _karaokeTimer = new Timer(async _ =>
            {
                try
                {
                    _karaokeScore = await _module.InvokeAsync<int>("karaokeScoreOf", _root);
                    await InvokeAsync(StateHasChanged);
                }
                catch (JSDisconnectedException)
                {
                    // Torn down mid-poll; the timer is disposed with the component.
                }
            }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
        else
        {
            StopKaraokeTimer();
            _karaokeOn = false;
            await _module.InvokeVoidAsync("stopKaraoke", _root);
            await SetModeAsync("full");
        }
    }

    private void StopKaraokeTimer()
    {
        _karaokeTimer?.Dispose();
        _karaokeTimer = null;
    }

    /// <summary>A soft pad on the detected tonic; the pitch class came from the server's analysis.</summary>
    private async Task SetDroneAsync(bool on)
    {
        if (_module is null || TonicPitchClass is null)
        {
            return;
        }
        _droneOn = on;
        // Octave 3: low enough to sit under the mix, high enough to stay audible on laptop speakers.
        await _module.InvokeVoidAsync("setDrone", _root, on ? 48 + TonicPitchClass.Value : null);
    }

    public async ValueTask DisposeAsync()
    {
        _loadTimer?.Dispose();
        StopKaraokeTimer();
        try
        {
            if (_spectrum is not null)
            {
                await _spectrum.InvokeVoidAsync("dispose", _spectrumCanvas);
                await _spectrum.DisposeAsync();
            }
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose", _root);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone during teardown.
        }
        _selfRef?.Dispose();
    }
}
