@using PoMode.Shared.Analysis
@using PoMode.Client.Services
@inject AnalysisClient Client

@* What a public music catalogue says about this recording, beside what PoMode measured.

   Not loaded on render. A lookup reaches two third-party services, and doing that automatically for
   every job a user opens would spend someone else's rate limit on a question nobody asked. The panel
   sits closed until it is opened. *@

<RadzenCard class="reference-card">
    <div class="reference-head">
        <span class="stat-title">Second opinion</span>
        @if (_lookup is null)
        {
            <RadzenButton Text="@(_busy ? "Looking up…" : "Look it up")" Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Secondary" Disabled="@_busy"
                          Click="@(() => LookupAsync(null))" id="reference-lookup" />
        }
    </div>

    @if (_lookup is null && !_busy)
    {
        <p class="reference-hint">
            Check this analysis against MusicBrainz and the community key and tempo estimates in
            AcousticBrainz. Nothing but the file's name is sent — the audio never leaves this machine.
        </p>
    }
    else if (_lookup is { } lookup)
    {
        @if (lookup.Match is { } match)
        {
            <div class="reference-match">
                @if (match.CoverArtUrl is { } cover && !_coverFailed)
                {
                    @* Dropped on error rather than checked beforehand: verifying the URL would cost a
                       third network round trip on every lookup to learn what the browser discovers
                       for free. Handled through Blazor rather than an inline onerror, so no script
                       or style lives in the markup. *@
                    <img class="reference-cover" src="@cover" alt="" loading="lazy"
                         @onerror="@(() => _coverFailed = true)" />
                }
                <div class="reference-identity">
                    <p class="reference-title">@match.Title</p>
                    @if (match.Artist is { } artist)
                    {
                        <p class="reference-artist">@artist</p>
                    }
                    @if (match.ReleaseTitle is { } release)
                    {
                        <p class="reference-release">@release</p>
                    }
                    <p class="reference-confidence">
                        Matched on “@match.Query” · @($"{match.MatchConfidence * 100:0}%") confidence
                    </p>
                </div>
            </div>

            <div class="agreements">
                <span class="agreement @AgreementClass(match.KeyAgreement)">
                    Key: @AgreementLabel(match.KeyAgreement)
                </span>
                <span class="agreement @AgreementClass(match.TempoAgreement)">
                    Tempo: @AgreementLabel(match.TempoAgreement)
                </span>
            </div>
        }

        @* The sentence is written server-side — comparing two readings of a key is a musical
           judgment, and the interesting case (a catalogue naming the relative major of a modal
           reading) needs explaining rather than scoring. *@
        <p class="reference-comparison">@lookup.Summary</p>

        <div class="reference-retry">
            <input class="reference-query" type="text" placeholder="Wrong song? Type a title and artist"
                   @bind="_query" @bind:event="oninput" @onkeydown="OnQueryKeyDown"
                   aria-label="Search the catalogue for a different recording" />
            <RadzenButton Text="Search" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Disabled="@(_busy || string.IsNullOrWhiteSpace(_query))"
                          Click="@(() => LookupAsync(_query))" />
        </div>
    }

    @if (_error is { } error)
    {
        <p class="reference-error">@error</p>
    }
</RadzenCard>

@code {
    [Parameter, EditorRequired] public required string JobId { get; set; }

    private ReferenceLookupDto? _lookup;
    private string? _query;
    private string? _error;
    private bool _busy;

    /// <summary>Set when the cover art URL 404s, which is the common case — most releases have none.</summary>
    private bool _coverFailed;

    /// <summary>The job the current lookup belongs to, so opening a different job clears it.</summary>
    private string? _loadedJobId;

    protected override void OnParametersSet()
    {
        if (_loadedJobId == JobId)
        {
            return;
        }
        _loadedJobId = JobId;
        _lookup = null;
        _query = null;
        _error = null;
        _coverFailed = false;
    }

    private async Task LookupAsync(string? query)
    {
        _busy = true;
        _error = null;
        // A new search is a new release, so last search's missing cover says nothing about this one.
        _coverFailed = false;
        try
        {
            _lookup = await Client.GetReferenceAsync(JobId, query);
            if (_lookup is null)
            {
                // A 429 from the catalogue rate limit lands here too, which is why the message names
                // waiting rather than failure.
                _error = "The lookup could not be run just now. Try again in a moment.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnQueryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_query) && !_busy)
        {
            await LookupAsync(_query);
        }
    }

    /// <summary>
    /// Unknown is styled as neither agreement nor disagreement on purpose: most recordings have no
    /// community analysis at all, and showing that absence as a red cross would read as the two
    /// sources contradicting each other when one of them simply never spoke.
    /// </summary>
    private static string AgreementClass(ReferenceAgreement agreement) => agreement switch
    {
        ReferenceAgreement.Agrees => "agrees",
        ReferenceAgreement.Differs => "differs",
        _ => "unknown",
    };

    private static string AgreementLabel(ReferenceAgreement agreement) => agreement switch
    {
        ReferenceAgreement.Agrees => "agrees",
        ReferenceAgreement.Differs => "reads it differently",
        _ => "no community estimate",
    };
}
