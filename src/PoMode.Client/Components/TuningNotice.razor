@using PoMode.Shared.Analysis

@* Shown only when a correction was actually made. A recording already at A=440, and one whose
   deviations were too scattered for any single offset to describe, both report zero, and in both
   cases there is nothing to tell the user about. A chip beside the take's origin rather than a
   full-width banner: the figure is one line, and the reasoning is in the tooltip. *@

@if (Math.Abs(Cents) >= 0.5)
{
    <span class="tuning-notice" data-tuning-cents="@($"{Cents:0.0}")"
          title="@($"This recording sits {Direction} of A=440, so its notes were read against {ReferenceHz} Hz. Measured across the whole recording, then applied once: every interval you sang is unchanged; only the reference moved.")">
        <span aria-hidden="true">🎚</span>
        Tuned @($"{Math.Abs(Cents):0.#}")&nbsp;cents @Direction · A=@ReferenceHz&nbsp;Hz
    </span>
}

@code {
    [Parameter] public double Cents { get; set; }

    private string Direction => Cents > 0 ? "sharp" : "flat";

    /// <summary>The concert A this recording is actually tuned to, which is the number a musician reads.</summary>
    private string ReferenceHz => $"{440.0 * Math.Pow(2.0, Cents / 1200.0):0.#}";
}
