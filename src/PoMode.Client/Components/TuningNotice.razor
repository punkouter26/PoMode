@using PoMode.Shared.Analysis

@* Shown only when a correction was actually made. A recording already at A=440, and one whose
   deviations were too scattered for any single offset to describe, both report zero, and in both
   cases there is nothing to tell the user about. *@

@if (Math.Abs(Cents) >= 0.5)
{
    <div class="tuning-notice" data-tuning-cents="@($"{Cents:0.0}")"
         title="Measured across the whole recording, then applied once. Every interval you sang is unchanged; only the reference the notes are read against moved.">
        <span class="tuning-icon" aria-hidden="true">🎚</span>
        <span class="tuning-text">
            Pitch adjusted <strong>@Direction @($"{Math.Abs(Cents):0.#}")&nbsp;cents</strong>
            &middot; this recording sits @Direction of A=440, so its notes were read against @ReferenceHz&nbsp;Hz
        </span>
    </div>
}

@code {
    [Parameter] public double Cents { get; set; }

    private string Direction => Cents > 0 ? "sharp" : "flat";

    /// <summary>The concert A this recording is actually tuned to, which is the number a musician reads.</summary>
    private string ReferenceHz => $"{440.0 * Math.Pow(2.0, Cents / 1200.0):0.#}";
}
