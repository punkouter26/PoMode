@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject SessionState Session
@using PoMode.Shared.Account
@implements IAsyncDisposable

<a class="skip-link" href="#main-content">Skip to content</a>

<header class="app-header">
    <div class="brand">PoMode</div>
    @* Two labels per destination, one of which is display:none at any given width, so the row fits a
       320px phone without a scroll strip hiding the last item. Only one span is ever rendered
       visible, so assistive tech reads one name. Diagnostics is an operator's page, not a place a
       listener goes, so it lives in the ⋯ menu rather than taking a slot here. *@
    <nav class="actions" aria-label="Main navigation">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="nav-wide">Analyze</span><span class="nav-narrow">Analyze</span>
        </NavLink>
        <NavLink class="nav-link" href="modes">
            <span class="nav-wide">Mode Lab</span><span class="nav-narrow">Modes</span>
        </NavLink>
        <NavLink class="nav-link" href="library">
            <span class="nav-wide">Library</span><span class="nav-narrow">Songs</span>
        </NavLink>
        <NavLink class="nav-link" href="practice">
            <span class="nav-wide">Practice</span><span class="nav-narrow">Sing</span>
        </NavLink>
    </nav>
    <div class="session">
        @if (Session.Current is { DisplayName: { } who })
        {
            <span class="session-name" id="session-name" data-session-kind="@Session.Current.Kind">@who</span>
        }
        <button class="icon-button theme-toggle" type="button" @onclick="CycleThemeAsync"
                title="Theme: follows the system by default; click to override" aria-label="@($"Theme: {ThemeLabel}")">
            @ThemeGlyph
        </button>
        <button class="icon-button overflow-toggle" type="button" @onclick="ToggleOverflowAsync"
                title="More" aria-label="More" aria-haspopup="true" aria-expanded="@_overflowOpen">
            ⋯
        </button>
        @if (_overflowOpen)
        {
            @* A transparent scrim rather than a document-level JS listener: clicking anywhere else
               has to close the menu, and a scrim gets that from the same render tree the menu lives
               in, with no listener to leak when the layout is torn down. *@
            <div class="overflow-scrim" @onclick="CloseOverflow" aria-hidden="true"></div>
            <div class="overflow-menu" role="menu" tabindex="-1" @ref="_overflowMenu"
                 @onkeydown="OnOverflowKeyDown">
                @if (Session.Current is { } session)
                {
                    <div class="overflow-group overflow-account" role="group" aria-label="Account">
                        <span class="overflow-label">Account</span>
                        <span class="overflow-who">@(session.DisplayName ?? "Not signed in")</span>
                        @if (session.Kind == SessionKind.Guest)
                        {
                            <span class="overflow-hint">Your library lives in this browser.</span>
                        }
                    </div>
                    @* A guest is never offered "sign out": their session is their library, and ending it
                       would strand every take in it. Signing in with Microsoft carries it across. *@
                    @if (session.Kind == SessionKind.Guest && session.MicrosoftAvailable)
                    {
                        <button class="overflow-item" type="button" role="menuitem" id="sign-in-microsoft"
                                @onclick="SignInWithMicrosoft">
                            Sign in with Microsoft
                        </button>
                    }
                    else if (session.Kind == SessionKind.Microsoft)
                    {
                        <button class="overflow-item" type="button" role="menuitem" id="sign-out"
                                @onclick="SignOutAsync">
                            Sign out
                        </button>
                    }
                }
                <button class="overflow-item" type="button" role="menuitem" @onclick="ToggleShortcutsAsync">
                    Keyboard shortcuts
                </button>
                @* Effects are a real setting rather than only an OS preference, because the two
                   questions the OS conflates are separate here: how much motion you want to see,
                   and whether an app may make noise at you. *@
                <div class="overflow-group" role="group" aria-label="Visual effects">
                    <span class="overflow-label">Effects</span>
                    <div class="fx-levels">
                        @foreach (var (value, label) in FxLevels)
                        {
                            <button class="fx-level @(_fxLevel == value ? "active" : "")" type="button"
                                    aria-pressed="@(_fxLevel == value)" data-fx-level="@value"
                                    @onclick="@(() => SetFxLevelAsync(value))">@label</button>
                        }
                    </div>
                    @if (_fxFollowsSystem)
                    {
                        <span class="overflow-hint">Following your system motion setting</span>
                    }
                </div>
                <button class="overflow-item" type="button" role="menuitemcheckbox"
                        aria-checked="@(!_fxMuted)" @onclick="ToggleFxMutedAsync" id="fx-sound-toggle">
                    @(_fxMuted ? "☓" : "♪") Interface sounds
                </button>
                @* Only where it can work: this server has a VAPID key and this browser can receive a
                   push (Safari only as an installed app). The permission prompt comes from the click
                   on this item and from nothing else. *@
                @if (_pushState is "on" or "off" or "blocked")
                {
                    <button class="overflow-item" type="button" role="menuitemcheckbox" id="push-toggle"
                            aria-checked="@(_pushState == "on" ? "true" : "false")" data-push-state="@_pushState"
                            disabled="@(_pushState == "blocked" || _pushBusy)" @onclick="TogglePushAsync">
                        @(_pushState == "on" ? "🔔" : "🔕") Notify me when analysis finishes
                    </button>
                    @if (_pushState == "blocked")
                    {
                        <span class="overflow-hint overflow-item-hint">Notifications are blocked for this site in your browser's settings.</span>
                    }
                }
                <a class="overflow-item" role="menuitem" href="diagnostics" @onclick="CloseOverflow">
                    Diagnostics
                </a>
                @* Offered only when the browser has actually handed us an install prompt, so the
                   item is never a button that does nothing. *@
                @if (_canInstall)
                {
                    <button class="overflow-item" type="button" role="menuitem" @onclick="InstallAsync"
                            id="install-app">
                        Install PoMode
                    </button>
                }
            </div>
        }
    </div>
</header>

@if (_shortcutsOpen)
{
    <div class="modal-backdrop" @onclick="CloseShortcuts">
        @* tabindex + a focus call on open is what makes Escape work at all: a keydown handler on a
           div never fires unless something inside it holds focus, and a dialog that traps the eye
           but not the keyboard is the worse of the two failures. *@
        <div class="modal-card shortcuts-modal" role="dialog" aria-modal="true" tabindex="-1"
             aria-labelledby="shortcuts-title" @ref="_shortcutsCard" @onkeydown="OnShortcutsKeyDown"
             @onclick:stopPropagation>
            <div class="shortcuts-head">
                <h2 id="shortcuts-title">Keyboard shortcuts</h2>
                <button class="icon-button" type="button" @onclick="CloseShortcuts" aria-label="Close">✕</button>
            </div>
            <dl class="shortcuts-list">
                <dt><kbd>Space</kbd></dt><dd>Play / pause the stems</dd>
                <dt><kbd>,</kbd></dt><dd>Restart playback from the beginning</dd>
                <dt>Mouse wheel</dt><dd>Zoom the canvas timeline in and out</dd>
                <dt>Click + drag</dt><dd>Pan the canvas timeline</dd>
                <dt>Click</dt><dd>Seek the playhead to that point and inspect that window</dd>
            </dl>
        </div>
    </div>
}

<MockDataBanner />
<RadzenNotification />

<main id="main-content" class="app-main">
    <ErrorBoundary @ref="_boundary">
        <ChildContent>
            @* Pages wait for a session: every one of them calls the API on first render, and a call
               that beats the guest cookie would land in nobody's library. *@
            @if (_sessionReady)
            {
                @Body
            }
        </ChildContent>
        <ErrorContent>
            @* Without a boundary a single component exception tears down the whole render tree
               and leaves a blank page with no way back. *@
            <div class="po-error-panel" role="alert">
                <h2>Something went wrong</h2>
                <p>This page hit an unexpected error. Reload the page to try again.</p>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</main>

@code {
    private IJSObjectReference? _theme;
    private IJSObjectReference? _pwa;
    private IJSObjectReference? _prefs;
    private IJSObjectReference? _push;
    private DotNetObjectReference<MainLayout>? _self;

    /// <summary>push.js's answer: "unavailable" (item hidden), "blocked", "off" or "on".</summary>
    private string _pushState = "unavailable";
    private bool _pushBusy;

    /// <summary>The effect levels offered, in the order they read as a scale.</summary>
    private static readonly (string Value, string Label)[] FxLevels =
    [
        ("full", "Full"),
        ("subtle", "Subtle"),
        ("off", "Off"),
    ];

    private string _fxLevel = "full";
    private bool _sessionReady;

    private ErrorBoundary? _boundary;

    /// <summary>The layout outlives navigation, so a tripped boundary would otherwise keep showing its
    /// error panel on every page until a reload. A new page (a new Body) gets a clean start.</summary>
    protected override void OnParametersSet() => _boundary?.Recover();
    private bool _fxMuted;

    /// <summary>True while no explicit level has been chosen, so the menu can say the level is
    /// inherited rather than claiming a choice the user never made.</summary>
    private bool _fxFollowsSystem = true;

    /// <summary>True once the browser has offered an install prompt for this app to capture. It
    /// never fires on a desktop browser that already has the app, or on iOS at all.</summary>
    private bool _canInstall;
    private string _themeMode = "system";
    private bool _overflowOpen;
    private bool _shortcutsOpen;

    private ElementReference _overflowMenu;
    private ElementReference _shortcutsCard;

    /// <summary>Set when a popover has just opened, so the render after that can move focus into it
    /// exactly once rather than stealing focus back on every subsequent render.</summary>
    private bool _focusOverflow;
    private bool _focusShortcuts;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        try
        {
            await Session.EnsureAsync();
        }
        catch (HttpRequestException)
        {
            // The API is unreachable: render the pages anyway so they can show their own errors,
            // rather than a blank shell that looks like a hang.
        }
        _sessionReady = true;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private void SignInWithMicrosoft()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"auth/login/microsoft?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }

    private async Task SignOutAsync()
    {
        _overflowOpen = false;
        if (_push is not null && _pushState == "on")
        {
            // While the session still exists: the account being left stops notifying this browser.
            try
            {
                await _push.InvokeVoidAsync("forget");
            }
            catch (JSException)
            {
                // Signing out must not depend on a push service being reachable.
            }
        }
        await Session.SignOutAsync();
        // The library and any open job belonged to the account just left.
        Navigation.NavigateTo("", forceLoad: true);
    }

    private string ThemeLabel => _themeMode switch
    {
        "light" => "Light",
        "dark" => "Dark",
        _ => "Auto",
    };

    private string ThemeGlyph => _themeMode switch
    {
        "light" => "☀",
        "dark" => "☾",
        _ => "◐",
    };

    private void ToggleOverflowAsync()
    {
        _overflowOpen = !_overflowOpen;
        _focusOverflow = _overflowOpen;
    }

    private void CloseOverflow() => _overflowOpen = false;

    private void ToggleShortcutsAsync()
    {
        _overflowOpen = false;
        _shortcutsOpen = !_shortcutsOpen;
        _focusShortcuts = _shortcutsOpen;
    }

    private void CloseShortcuts() => _shortcutsOpen = false;

    private void OnOverflowKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _overflowOpen = false;
        }
    }

    private void OnShortcutsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _shortcutsOpen = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusShortcuts)
        {
            _focusShortcuts = false;
            await _shortcutsCard.FocusAsync();
        }
        else if (_focusOverflow)
        {
            _focusOverflow = false;
            await _overflowMenu.FocusAsync();
        }
        if (!firstRender)
        {
            return;
        }
        _theme = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/theme.js");
        _themeMode = await _theme.InvokeAsync<string>("init");
        // Before any effect module: init stamps data-fx on <html>, and every module below reads it
        // on the way up. Read back as three primitives rather than one object so this does not
        // depend on how JS interop is configured to deserialize.
        _prefs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/prefs.js");
        await _prefs.InvokeVoidAsync("init");
        await ReadFxStateAsync();
        _self = DotNetObjectReference.Create(this);
        // The install prompt fires once, on the browser's own schedule; pwa.js captures it so the
        // app can offer it from the menu rather than leaving it to Chrome's infobar.
        _pwa = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/pwa.js");
        await _pwa.InvokeVoidAsync("watchInstall", _self);
        _canInstall = await _pwa.InvokeAsync<bool>("canInstall");
        StateHasChanged();
        await InitPushAsync();
    }

    /// <summary>After the session exists: /api/push answers signed-in callers only, and a browser
    /// that is already subscribed re-registers itself with whoever that is.</summary>
    private async Task InitPushAsync()
    {
        try
        {
            await Session.EnsureAsync();
            _push = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/push.js");
            _pushState = await _push.InvokeAsync<string>("init");
            StateHasChanged();
        }
        catch (Exception ex) when (ex is JSException or HttpRequestException)
        {
            // No toggle, which is what a browser without push support gets anyway.
        }
    }

    private async Task TogglePushAsync()
    {
        if (_push is null || _pushBusy)
        {
            return;
        }
        _pushBusy = true;
        try
        {
            _pushState = await _push.InvokeAsync<string>(_pushState == "on" ? "disable" : "enable");
        }
        catch (JSException)
        {
            // Subscribing failed part-way (the push service unreachable, the server refused the
            // endpoint); re-read what actually holds rather than guess.
            _pushState = await _push.InvokeAsync<string>("init");
        }
        finally
        {
            _pushBusy = false;
        }
    }

    /// <summary>Called from pwa.js when the browser offers an install prompt.</summary>
    [JSInvokable]
    public Task OnInstallAvailable()
    {
        _canInstall = true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task InstallAsync()
    {
        _overflowOpen = false;
        if (_pwa is not null)
        {
            await _pwa.InvokeAsync<bool>("promptInstall");
            // A prompt is single-use whether or not it was accepted, so the item goes either way.
            _canInstall = false;
        }
    }

    private async Task CycleThemeAsync()
    {
        if (_theme is not null)
        {
            _themeMode = await _theme.InvokeAsync<string>("cycle");
        }
    }

    private async Task ReadFxStateAsync()
    {
        if (_prefs is null)
        {
            return;
        }
        _fxLevel = await _prefs.InvokeAsync<string>("level");
        _fxMuted = await _prefs.InvokeAsync<bool>("muted");
        _fxFollowsSystem = !await _prefs.InvokeAsync<bool>("isExplicit");
    }

    private async Task SetFxLevelAsync(string value)
    {
        if (_prefs is null)
        {
            return;
        }
        await _prefs.InvokeVoidAsync("setLevel", value);
        await ReadFxStateAsync();
    }

    private async Task ToggleFxMutedAsync()
    {
        if (_prefs is null)
        {
            return;
        }
        await _prefs.InvokeVoidAsync("setMuted", !_fxMuted);
        await ReadFxStateAsync();
    }

    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnSessionChanged;
        try
        {
            if (_pwa is not null)
            {
                await _pwa.DisposeAsync();
            }
            if (_prefs is not null)
            {
                await _prefs.DisposeAsync();
            }
            if (_push is not null)
            {
                await _push.DisposeAsync();
            }
            if (_theme is not null)
            {
                await _theme.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone during teardown.
        }
        // After the JS side has stopped calling in, so a transition in flight cannot invoke a
        // disposed reference.
        _self?.Dispose();
    }
}
