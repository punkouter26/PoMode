@page "/modes"
@using PoMode.Shared.Analysis
@inject AnalysisClient Analysis
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NotificationService NotificationService
@implements IAsyncDisposable

<PageTitle>PoMode · Mode Lab</PageTitle>

<h1 class="pm-sr-only">Mode Lab</h1>

<div class="modelab-studio-container">
    @* Loosen the purity setting far enough and the melody stops anchoring to its own tonic. Since all
       seven relative modes share one set of notes, what it drifts into is usually a real mode with a
       different home note. The server names it rather than reporting a poor score against a mode the
       melody has left. *@
    @if (_melody?.BetterFit is { } betterFit)
    {
        <div class="better-fit-banner" role="status" data-better-fit="@betterFit.Name">
            <span class="better-fit-lead">This actually sounds like</span>
            <span class="better-fit-mode">@betterFit.Name</span>
            <span class="better-fit-score">@($"{betterFit.Percentage:0.#}% fit, against {_melody.ModePercentage:0.#}% for {GetModeDisplayName(_selectedMode)}")</span>
        </div>
    }

    @* One bar: what you can do to the loop, then what it is made of. The page title and the nav
       already say "Mode Lab", so the bar does not. *@
    <div class="studio-top-bar pm-panel">
        <div class="studio-transport">
            @* Play and pause share a button; picking a card, rolling, or changing a setting restarts
               the loop from bar one, which is what a separate Stop was for. Radzen buttons like every
               other page: this bar used to be hand-rolled, green/amber/violet with emoji, and read as a
               different app. A toggle that is on is a tinted primary. *@
            <RadzenButton Text="@(_isPlaying ? "Pause" : "Play")" Icon="@(_isPlaying ? "pause" : "play_arrow")"
                          Size="ButtonSize.Small" Click="@(() => _isPlaying ? PauseAsync() : PlayAsync())"
                          Disabled="@(!_isPlaying && (_isLoading || _melody is null))"
                          title="@(_isPlaying ? "Pause" : "Play (flute and piano)")" />

            <RadzenButton Text="Loop" Icon="repeat" Size="ButtonSize.Small" Click="@ToggleLoopAsync"
                          ButtonStyle="@(_isLooping ? ButtonStyle.Primary : ButtonStyle.Light)"
                          Variant="@(_isLooping ? Variant.Flat : Variant.Filled)"
                          Shade="@(_isLooping ? Shade.Lighter : Shade.Default)"
                          aria-pressed="@(_isLooping ? "true" : "false")" title="Loop the progression" />

            <RadzenButton Text="New melody" Icon="casino" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Click="@RandomizeSeedAsync" title="Generate a new melody over the same chords" />

            @* The harmony's own dice. Rolls until you land on a progression worth singing over —
               the key stays where you put it, because that is the one setting a voice cares about. *@
            <RadzenButton Text="New chords" Icon="casino" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          id="roll-chords" Click="@RandomizeProgressionAsync" Disabled="@(_progressions.Count < 2)"
                          title="Roll a random chord progression to sing over (the key stays as you set it)" />

            <DownloadMenu Items="DownloadItems" />

            <RadzenButton Text="@(_isSendingToAnalyzer ? "Analyzing…" : "Analyze")" Icon="science"
                          Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" class="send-analyzer"
                          Click="@SendToAnalyzerAsync" Disabled="@(_isSendingToAnalyzer || _melody is null)"
                          title="Synthesize this loop and run it through the song analyzer" />
        </div>

        <BackingControls Tonic="_selectedTonic" TonicChanged="OnTonicPickedAsync"
                         ProgressionId="@_selectedProgressionId" ProgressionIdChanged="OnProgressionPickedAsync"
                         Progressions="_progressions"
                         Bpm="_bpm" BpmChanged="OnTempoPickedAsync">
            <Between>
                <div class="backing-field">
                    <span class="backing-label" title="Move the backing chords to the selected mode's own tonic, so the mode is heard as a colour rather than as the parent key with a displaced melody">
                        Match to mode
                    </span>
                    <button class="match-toggle @(_matchHarmonyToMode ? "on" : "off")" type="button"
                            id="match-harmony-toggle" data-match-harmony="@(_matchHarmonyToMode ? "on" : "off")"
                            aria-pressed="@_matchHarmonyToMode" @onclick="ToggleMatchHarmonyAsync">
                        @(_matchHarmonyToMode ? "On" : "Off")
                    </button>
                </div>
            </Between>
            <ChildContent>
                <div class="backing-field">
                    <span class="backing-label" id="style-label">Style</span>
                    <RadzenDropDown TValue="MelodyStyle" @bind-Value="_selectedStyle" Data="@StyleOptions"
                                    Change="@(_ => OnConfigChanged())" class="style-dd" id="style-select"
                                    aria-labelledby="style-label" />
                </div>
                @* One purity readout: the target you set and what the generated melody measured. It used
                   to be stated five times across the card pill, two badges and the canvas header. *@
                <div class="backing-field purity-field">
                    <span class="backing-label" id="purity-label">Purity</span>
                    <RadzenSlider TValue="double" @bind-Value="_targetPurity" Min="0" Max="100" Step="10"
                                  Change="@(args => OnPurityChanged(args))"
                                  class="purity-slider" id="purity-slider" aria-labelledby="purity-label" />
                    <span class="purity-readout" data-purity-target="@($"{_targetPurity:0}")"
                          title="How hard the example insists on its mode. At the top the melody starts and ends on the mode root and the loop opens on the home chord; lower settings loosen both, so the opening chord need not be the mode's own.">
                        @($"{_targetPurity:0}%")
                        @if (_melody is not null)
                        {
                            <span class="purity-measured">@($" · measured {_melody.ModePercentage:0.#}%")</span>
                        }
                    </span>
                </div>
            </ChildContent>
        </BackingControls>
    </div>

    @* The seven relative modes and the two pentatonics: one scale read nine ways, side by side. The
       pentatonics used to be two buttons in a ribbon of their own; they are modes of the same key, so
       they are cards like the rest. *@
    <div class="studio-modes-wrap">
    <div class="studio-modes-strip">
        @foreach (var modeItem in StripModes)
        {
            var isSelected = _selectedMode == modeItem.Mode;
            var modeNotes = ScaleModes.RelativeScaleNoteNames(_selectedTonic, modeItem.Mode);
            @* The whole card is the button: it was a clickable <div> the keyboard could not reach, with a
               23px "Sample" button inside doing the same thing. *@
            <button type="button"
                    class="compact-mode-card @GetModeCssClass(modeItem.Mode) @(isSelected ? "selected" : "") @(isSelected && _isPlaying ? "playing" : "")"
                    aria-pressed="@(isSelected ? "true" : "false")"
                    @onclick="@(() => SampleModeAsync(modeItem.Mode))">
                <span class="mode-card-top">
                    <span class="compact-mode-title">@CardTitle(modeItem)</span>
                    <span class="compact-degree-badge">@modeItem.Degree</span>
                </span>
                <span class="compact-scale-notes">
                    @for (var n = 0; n < modeNotes.Length; n++)
                    {
                        var noteName = modeNotes[n];
                        var isRoot = n == 0;
                        var isChar = n > 0 && IsCharacteristicNote(_selectedTonic, modeItem.Mode, noteName);
                        <span class="note-token @(isRoot ? "root-token" : (isChar ? "char-token" : ""))" title="@(isRoot ? "Mode Root Note" : (isChar ? "Characteristic Color Tone" : "Scale Note"))">@noteName</span>
                        if (n < modeNotes.Length - 1)
                        {
                            <span class="note-dot">·</span>
                        }
                    }
                </span>
                <span class="compact-mode-desc">@modeItem.Mood</span>
                <span class="compact-card-cta">@(isSelected && _isPlaying ? "🔊 Playing" : "▶ Sample")</span>
            </button>
        }
    </div>
    </div>

    @* The strip's lesson made physical: the same notes, a different home. Each note is a body on a
       chromatic clock around the mode's home note; picking a card springs the new home to the centre.
       Which notes, and which is home, come from ScaleModes; mode-gravity.js only moves them. *@
    <div class="studio-gravity-panel pm-panel">
        <div class="gravity-text">
            <span class="gravity-label">Home note</span>
            <span class="gravity-home">@GetModeDisplayName(_selectedMode)</span>
            <span class="gravity-desc">Each note sits on the clock by how far it is above home. Another card: the same notes, a new home, a new shape. Tap a note to hear it.</span>
        </div>
        <canvas class="gravity-canvas" @ref="_gravityCanvas" id="mode-gravity"
                role="img" aria-label="@GravityLabel"></canvas>
    </div>

    @if (_melody is not null)
    {
        @* The chords as text sit on the roll's own header: the roll draws them as blocks, and the pills
           are the readable spelling of the same lane, lit while each sounds. *@
        <div class="studio-canvas-panel pm-panel">
            <div class="canvas-panel-header">
                <span class="canvas-panel-desc">@_melody.CharacteristicExplanation</span>
                <div class="compact-chords-list" aria-label="The chords in this loop">
                    @foreach (var chord in _melody.Chords)
                    {
                        var isCurrent = _playheadSec >= chord.StartSec && _playheadSec < chord.EndSec;
                        <span class="compact-chord-pill @(isCurrent ? "current" : "")"><span class="ch-sym">@chord.Symbol</span></span>
                    }
                </div>
            </div>
            <AnalysisCanvas Model="_melody.Visual" SelectedWindowIndex="_activeWindowIndex"
                            PlayheadSec="_playheadSec" OnSeek="OnSeek" />
        </div>
    }
    else if (_isLoading)
    {
        <div class="modelab-loading">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText Text="Generating modal melodies and harmonies…" />
        </div>
    }
</div>

@code {
    private sealed record ModePresetInfo(ScaleMode Mode, string BaseName, string Degree, string Mood, string CharacteristicTone);

    private static readonly IReadOnlyList<MelodyStyle> StyleOptions =
    [
        MelodyStyle.Lyrical,
        MelodyStyle.Arpeggiated,
        MelodyStyle.Syncopated,
        MelodyStyle.Motific
    ];

    // The 7 Church Modes ordered from Degree 1 to Degree 7
    private static readonly IReadOnlyList<ModePresetInfo> SevenModesOrdered =
    [
        new(ScaleMode.Ionian, "Ionian (Major)", "Deg 1", "Bright, joyful, heroic", "Starts on 1st degree"),
        new(ScaleMode.Dorian, "Dorian", "Deg 2", "Jazzy, soulful, hopeful", "Natural 6th"),
        new(ScaleMode.Phrygian, "Phrygian", "Deg 3", "Dark flamenco tension", "Minor 2nd"),
        new(ScaleMode.Lydian, "Lydian", "Deg 4", "Dreamy, floating wonder", "Sharp 4th"),
        new(ScaleMode.Mixolydian, "Mixolydian", "Deg 5", "Bluesy classic rock", "Flat 7th"),
        new(ScaleMode.Aeolian, "Aeolian (Minor)", "Deg 6", "Emotional natural minor", "Minor 6th"),
        new(ScaleMode.Locrian, "Locrian", "Deg 7", "Tense, diminished", "Diminished 5th & b2")
    ];

    private static readonly IReadOnlyList<ModePresetInfo> PentatonicModes =
    [
        new(ScaleMode.MajorPentatonic, "Major Pentatonic", "5-Tone", "Open, pastoral", "Degrees 1-2-3-5-6"),
        new(ScaleMode.MinorPentatonic, "Minor Pentatonic", "5-Tone", "Bluesy rock", "Degrees 6-1-2-3-5")
    ];

    /// <summary>Every card on the strip, in the order it reads: the seven modes, then the two pentatonics.</summary>
    private static readonly IReadOnlyList<ModePresetInfo> StripModes = [.. SevenModesOrdered, .. PentatonicModes];

    /// <summary>The seven modes are named on their own root ("D Dorian"); a pentatonic by its own name
    /// on the root its notes start from.</summary>
    private string CardTitle(ModePresetInfo info) => PentatonicModes.Contains(info)
        ? $"{ScaleModes.RelativeScaleNoteNames(_selectedTonic, info.Mode)[0]} {info.BaseName}"
        : GetModeDisplayName(info.Mode);

    /// <summary>The loop as files, built from the same request the preview plays.</summary>
    private IReadOnlyList<DownloadMenu.Item> DownloadItems
    {
        get
        {
            var query = $"TonicPitchClass={_selectedTonic}&Mode={_selectedMode}&ProgressionId={Uri.EscapeDataString(_selectedProgressionId)}&Bpm={_bpm}&Style={_selectedStyle}&Seed={_seed}&TargetPurity={_targetPurity}";
            return
            [
                new("WAV audio (44.1 kHz stereo)", $"api/modal-melodies/wav?{query}", "Download the loop as a WAV file"),
                new("MIDI (melody and chords)", $"api/modal-melodies/midi?{query}", "Download the loop as a standard MIDI file"),
            ];
        }
    }

    private List<ChordProgressionDefinition> _progressions = [];
    private int _selectedTonic = 0; // C
    private string _selectedProgressionId = "pop-axis";
    private ScaleMode _selectedMode = ScaleMode.Ionian;
    private MelodyStyle _selectedStyle = MelodyStyle.Lyrical;
    private double _targetPurity = 90.0;
    private double _bpm = 100.0;
    private int _seed = 42;
    private bool _matchHarmonyToMode = true;

    private GeneratedMelodyDto? _melody;
    private bool _isLoading = true;
    private bool _isPlaying;
    private bool _isLooping = true;
    private bool _isSendingToAnalyzer;
    private double _playheadSec;
    private double _totalDurationSec = 8.0;
    private int? _activeWindowIndex;

    private IJSObjectReference? _playerModule;
    private DotNetObjectReference<ModeLab>? _selfRef;

    /// <summary>One body per note of the mode on screen, as the home-note view draws it.</summary>
    private sealed record GravityBody(int PitchClass, string Label, int Interval, bool Home, bool Characteristic);

    private ElementReference _gravityCanvas;
    private IJSObjectReference? _gravityModule;
    private (int Tonic, ScaleMode Mode)? _gravitySent;

    /// <summary>The mode's notes as the home-note view wants them: pitch class, name, semitones above
    /// the mode's own root, and whether it is home or the mode's characteristic tone. All from the
    /// shared ScaleModes tables, so this view and the cards above it cannot disagree.</summary>
    private IReadOnlyList<GravityBody> GravityBodies()
    {
        var root = (_selectedTonic + ScaleModes.ModeDegreeOffset(_selectedMode)) % 12;
        var characteristic = ScaleModes.CharacteristicIntervals(_selectedMode) is [var first, ..] ? first : -1;
        return [.. ScaleModes.Intervals(_selectedMode).Select(interval =>
        {
            var pitchClass = (root + interval) % 12;
            return new GravityBody(pitchClass, ScaleModes.NoteName(pitchClass), interval, interval == 0, interval == characteristic);
        })];
    }

    private string GravityLabel
        => $"{GetModeDisplayName(_selectedMode)}: home note at the centre, the other notes of the scale around it by distance above it";

    /// <summary>Pushes the mode to the home-note view whenever the key or the mode changed.</summary>
    private async Task SyncGravityAsync()
    {
        if (_gravitySent == (_selectedTonic, _selectedMode))
        {
            return;
        }
        if (_gravityModule is null)
        {
            _gravityModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/player/mode-gravity.js");
            await _gravityModule.InvokeVoidAsync("init", _gravityCanvas);
        }
        _gravitySent = (_selectedTonic, _selectedMode);
        var token = GetModeCssClass(_selectedMode) is { Length: > 0 } css ? $"--pm-{css}" : "--pm-accent";
        await _gravityModule.InvokeVoidAsync("setMode", _gravityCanvas, GravityBodies(), token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await SyncGravityAsync();
        }
        catch (JSDisconnectedException)
        {
            // Navigated away mid-render.
        }
    }

    private string GetModeDisplayName(ScaleMode mode)
    {
        var offset = ScaleModes.ModeDegreeOffset(mode);
        var modeRootName = ScaleModes.NoteName((_selectedTonic + offset) % 12);
        return $"{modeRootName} {mode}";
    }

    private static string GetModeCssClass(ScaleMode mode) => mode switch
    {
        ScaleMode.Ionian => "mode-ionian",
        ScaleMode.Dorian => "mode-dorian",
        ScaleMode.Phrygian => "mode-phrygian",
        ScaleMode.Lydian => "mode-lydian",
        ScaleMode.Mixolydian => "mode-mixolydian",
        ScaleMode.Aeolian => "mode-aeolian",
        ScaleMode.Locrian => "mode-locrian",
        _ => "",
    };

    private static bool IsCharacteristicNote(int parentTonic, ScaleMode mode, string noteName)
    {
        var offset = ScaleModes.ModeDegreeOffset(mode);
        var modeRootClass = (parentTonic + offset) % 12;
        // The table lives in PoMode.Shared so the client and the analyzer cannot drift apart on which
        // degree gives a mode its colour. A scale with no characteristic tone marks none.
        if (ScaleModes.CharacteristicIntervals(mode) is not [var charInterval, ..])
        {
            return false;
        }
        var charPitchClass = (modeRootClass + charInterval) % 12;
        return string.Equals(noteName, ScaleModes.NoteName(charPitchClass), StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var progs = await Analysis.GetModalProgressionsAsync();
            if (progs is { Count: > 0 })
            {
                _progressions = progs;
                _selectedProgressionId = _progressions[0].Id;
                _bpm = _progressions[0].DefaultBpm;

                // Open on the harmony that matches the mode the strip starts on, so the first thing
                // heard is already the mode rather than the parent key.
                ApplyModeHarmony(_selectedMode);
            }
            await RefreshMelodyAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Initialization Error", ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>The selectors as the server's request shape — one copy, so the preview, the analyzer
    /// hand-off and a hum take can never be generated from subtly different settings.</summary>
    private ModalMelodyRequest CurrentRequest() => new(
        TonicPitchClass: _selectedTonic,
        Mode: _selectedMode,
        ProgressionId: _selectedProgressionId,
        Bpm: _bpm,
        Style: _selectedStyle,
        Seed: _seed,
        TargetPurity: _targetPurity);

    private async Task RefreshMelodyAsync()
    {
        _melody = await Analysis.GenerateModalMelodyAsync(CurrentRequest());
        if (_melody is not null)
        {
            _totalDurationSec = _melody.MelodyNotes.Count > 0
                ? Math.Max(_melody.MelodyNotes.Max(n => n.StartSec + n.DurationSec), _melody.Chords.Max(c => c.EndSec))
                : 8.0;

            if (_isPlaying && _playerModule is not null)
            {
                await _playerModule.InvokeVoidAsync("updateMelody", _melody.MelodyNotes, _melody.BackingNotes, _totalDurationSec);
            }
        }
    }

    /// <summary>
    /// Points the harmony at the selected mode's own signature cadence. A mode is a tonal centre, not
    /// just a note set: over a progression that keeps insisting on the parent key, every mode comes out
    /// sounding like that key with the melody starting somewhere else.
    /// </summary>
    private void ApplyModeHarmony(ScaleMode mode)
    {
        if (!_matchHarmonyToMode) return;

        var signature = _progressions.SignatureFor(mode);
        if (signature is null || signature.Id == _selectedProgressionId) return;

        _selectedProgressionId = signature.Id;
        _bpm = signature.DefaultBpm;
    }

    private async Task SampleModeAsync(ScaleMode mode)
    {
        _selectedMode = mode;
        ApplyModeHarmony(mode);
        await RefreshMelodyAsync();

        // Always restart the picked mode from its first beat. Falling through to updateMelody while
        // a take is in flight kept the previous mode's chords and loop length, and resuming on a
        // stale pause offset dropped the new sample mid-phrase.
        await StopAsync();
        await PlayAsync();
    }

    private async Task OnConfigChanged(object? _ = null)
    {
        await RefreshMelodyAsync();
        if (_isPlaying)
        {
            // The arrangement just changed underneath the playhead, so this is a new take.
            await StopAsync();
            await PlayAsync();
        }
    }

    private async Task OnTonicPickedAsync(int tonic)
    {
        _selectedTonic = tonic;
        await OnConfigChanged();
    }

    private async Task OnProgressionPickedAsync(string id)
    {
        _selectedProgressionId = id;
        await OnProgressionChanged();
    }

    private async Task OnTempoPickedAsync(double bpm)
    {
        _bpm = bpm;
        await OnTempoChanged();
    }

    private async Task OnPurityChanged(double _ = 0)
    {
        // The slider hands back negative zero at the bottom of its travel, which formats as "-0%".
        if (_targetPurity <= 0) _targetPurity = 0;

        await RefreshMelodyAsync();
        if (_isPlaying)
        {
            // The arrangement just changed underneath the playhead, so this is a new take.
            await StopAsync();
            await PlayAsync();
        }
    }

    private async Task OnProgressionChanged(object? _ = null)
    {
        var prog = _progressions.FirstOrDefault(p => p.Id == _selectedProgressionId);
        if (prog is not null)
        {
            _bpm = prog.DefaultBpm;
            _selectedMode = prog.SuggestedMode;
        }
        await RefreshMelodyAsync();
        if (_isPlaying)
        {
            // The arrangement just changed underneath the playhead, so this is a new take.
            await StopAsync();
            await PlayAsync();
        }
    }

    private async Task OnTempoChanged(double _ = 0)
    {
        await RefreshMelodyAsync();
        if (_isPlaying)
        {
            // The arrangement just changed underneath the playhead, so this is a new take.
            await StopAsync();
            await PlayAsync();
        }
    }

    private async Task RandomizeSeedAsync()
    {
        _seed = Random.Shared.Next(1, 100000);
        await RefreshMelodyAsync();

        // A new melody is a new take, so it starts from bar one. Swapping the notes underneath a
        // running playhead left it partway through a phrase that no longer existed.
        var wasPlaying = _isPlaying;
        await StopAsync();
        if (wasPlaying)
        {
            await PlayAsync();
        }
    }

    /// <summary>
    /// Rolls a different progression to sing over. Deliberately leaves the key alone: a singer picks
    /// a key for their own range and does not want it moving under them, whereas the chords are the
    /// thing worth re-rolling until one sounds worth a take.
    ///
    /// <para>Sets the mode from the progression the way the dropdown does, and never routes through
    /// <see cref="ApplyModeHarmony"/> — that would look up the new mode's signature cadence and snap
    /// the harmony straight back off the roll.</para>
    /// </summary>
    private async Task RandomizeProgressionAsync()
    {
        if (_progressions.Count < 2) return;

        // Re-roll rather than allow a no-op: a dice button that lands on the same progression reads
        // as broken, and with a catalog this size that happens often.
        ChordProgressionDefinition next;
        do
        {
            next = _progressions[Random.Shared.Next(_progressions.Count)];
        }
        while (next.Id == _selectedProgressionId);

        _selectedProgressionId = next.Id;
        _bpm = next.DefaultBpm;
        _selectedMode = next.SuggestedMode;

        // A fresh progression deserves a fresh melody over it — the old seed's phrases were shaped
        // around chords that are gone.
        _seed = Random.Shared.Next(1, 100000);

        // A roll that lands while a take is already captured would leave "Save my melody" pointing
        // at chords that are no longer on screen. The take itself still carries its own backing, but
        // the screen would be lying about what it was.
        await RefreshMelodyAsync();

        // Audition it straight away: the whole point of the roll is to hear whether it is worth
        // singing over, and from bar one rather than wherever the previous loop had got to.
        var wasPlaying = _isPlaying;
        await StopAsync();
        if (wasPlaying)
        {
            await PlayAsync();
        }
    }

    private async Task SendToAnalyzerAsync()
    {
        if (_melody is null || _isSendingToAnalyzer) return;
        _isSendingToAnalyzer = true;
        try
        {
            if (_isPlaying)
            {
                await PauseAsync();
            }

            var job = await Analysis.AnalyzeModalMelodyAsync(CurrentRequest());
            if (job is not null && !string.IsNullOrEmpty(job.JobId))
            {
                NotificationService.Notify(NotificationSeverity.Success, "Mode Lab Bridge", "Synthesized WAV audio & queued analysis job!");
                Navigation.NavigateTo($"/?job={job.JobId}");
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Analysis Error", "Failed to queue analysis job.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            _isSendingToAnalyzer = false;
        }
    }

    private async Task EnsurePlayerAsync()
    {
        _playerModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/player/modal-player.js");
        _selfRef ??= DotNetObjectReference.Create(this);
    }

    private async Task PlayAsync()
    {
        if (_melody is null) return;
        await EnsurePlayerAsync();
        if (_playerModule is null) return;

        _isPlaying = true;
        await _playerModule.InvokeVoidAsync("play", _melody.MelodyNotes, _melody.BackingNotes, _totalDurationSec, _selfRef);
    }

    private async Task PauseAsync()
    {
        if (_playerModule is null) return;
        _isPlaying = false;
        await _playerModule.InvokeVoidAsync("pause");
    }

    private async Task StopAsync()
    {
        if (_playerModule is null) return;
        _isPlaying = false;
        _playheadSec = 0;
        _activeWindowIndex = null;
        await _playerModule.InvokeVoidAsync("stop");
    }

    private async Task ToggleMatchHarmonyAsync()
    {
        _matchHarmonyToMode = !_matchHarmonyToMode;
        if (_matchHarmonyToMode)
        {
            ApplyModeHarmony(_selectedMode);
        }
        else if (_progressions.FirstOrDefault(p => p.Id == _selectedProgressionId)?.RootsOn == HarmonicRoot.ModeRoot)
        {
            // Turning the match off is a request for one harmony that does not follow the mode, so a
            // mode-rooted progression has to give way to a parent-rooted one or nothing would change.
            var shared = _progressions.FirstSharedHarmony();
            if (shared is not null)
            {
                _selectedProgressionId = shared.Id;
                _bpm = shared.DefaultBpm;
            }
        }
        await RefreshMelodyAsync();
        if (_isPlaying)
        {
            await StopAsync();
            await PlayAsync();
        }
    }

    private async Task ToggleLoopAsync()
    {
        _isLooping = !_isLooping;
        if (_playerModule is not null)
        {
            await _playerModule.InvokeVoidAsync("setLooping", _isLooping);
        }
    }

    private void OnSeek(double seekSec)
    {
        _playheadSec = seekSec;
        if (_playerModule is not null)
        {
            _ = _playerModule.InvokeVoidAsync("seek", seekSec);
        }
        UpdateActiveWindow(seekSec);
    }

    /// <summary>Raised by the player when a non-looping take runs off its end.</summary>
    [JSInvokable]
    public void OnPlaybackEnded()
    {
        _isPlaying = false;
        _playheadSec = 0;
        _activeWindowIndex = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPlayheadUpdated(double positionSec)
    {
        _playheadSec = positionSec;
        UpdateActiveWindow(positionSec);
        StateHasChanged();
    }

    private void UpdateActiveWindow(double pos)
    {
        if (_melody?.ModalAnalysis is { } result)
        {
            _activeWindowIndex = result.WindowIndexAt(pos);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_playerModule is not null)
            {
                await _playerModule.InvokeVoidAsync("dispose");
                await _playerModule.DisposeAsync();
            }
            if (_gravityModule is not null)
            {
                await _gravityModule.InvokeVoidAsync("dispose", _gravityCanvas);
                await _gravityModule.DisposeAsync();
            }
            _selfRef?.Dispose();
        }
        catch (JSDisconnectedException) { }
    }
}
