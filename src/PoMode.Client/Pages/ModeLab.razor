@page "/modes"
@using PoMode.Shared.Analysis
@inject AnalysisClient Analysis
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NotificationService NotificationService
@implements IAsyncDisposable

<PageTitle>PoMode · Mode Lab</PageTitle>

<div class="modelab-studio-container">
    @* Loosen the purity setting far enough and the melody stops anchoring to its own tonic. Since all
       seven relative modes share one set of notes, what it drifts into is usually a real mode with a
       different home note. The server names it rather than reporting a poor score against a mode the
       melody has left. *@
    @if (_melody?.BetterFit is { } betterFit)
    {
        <div class="better-fit-banner" role="status" data-better-fit="@betterFit.Name">
            <span class="better-fit-lead">This actually sounds like</span>
            <span class="better-fit-mode">@betterFit.Name</span>
            <span class="better-fit-score">@($"{betterFit.Percentage:0.#}% fit, against {_melody.ModePercentage:0.#}% for {GetModeDisplayName(_selectedMode)}")</span>
        </div>
    }

    <!-- Top Studio Toolbar: Title, Transport, and Key/Progression/Style/Purity Selectors -->
    <div class="studio-top-bar">
        <div class="studio-brand">
            <span class="brand-title">🎼 Mode Lab</span>
        </div>

        <div class="studio-transport">
            @if (!_isPlaying)
            {
                <button class="transport-btn play" @onclick="PlayAsync" disabled="@(_isLoading || _melody is null || IsHumBusy)" title="Play (Flute & Piano)">
                    ▶ Play
                </button>
            }
            else
            {
                <button class="transport-btn pause" @onclick="PauseAsync" disabled="@IsHumBusy" title="Pause">
                    ⏸ Pause
                </button>
            }
            <button class="transport-btn stop" @onclick="StopAsync" disabled="@((!_isPlaying && _playheadSec == 0) || IsHumBusy)" title="Stop">
                ⏹ Stop
            </button>

            <button class="transport-btn loop @(_isLooping ? "active" : "")" @onclick="ToggleLoopAsync" disabled="@IsHumBusy" title="Loop Toggle">
                🔁 Loop
            </button>

            <button class="transport-btn shuffle" @onclick="RandomizeSeedAsync" disabled="@IsHumBusy" title="Generate New Melody">
                🎲 New Melody
            </button>

            @* The harmony's own dice. Rolls until you land on a progression worth singing over —
               the key stays where you put it, because that is the one setting a voice cares about. *@
            <button class="transport-btn shuffle chords" id="roll-chords" @onclick="RandomizeProgressionAsync"
                    disabled="@(IsHumBusy || _progressions.Count < 2)"
                    title="Roll a random chord progression to sing over (the key stays as you set it)">
                🎲 New Chords
            </button>

            <a class="transport-link wav" href="@($"api/modal-melodies/wav?TonicPitchClass={_selectedTonic}&Mode={_selectedMode}&ProgressionId={_selectedProgressionId}&Bpm={_bpm}&Style={_selectedStyle}&Seed={_seed}&TargetPurity={_targetPurity}")"
               target="_blank" rel="noopener" title="Download High-Fidelity 44.1kHz Stereo PCM WAV Audio">
                📥 WAV
            </a>

            <a class="transport-link midi" href="@($"api/modal-melodies/midi?TonicPitchClass={_selectedTonic}&Mode={_selectedMode}&ProgressionId={_selectedProgressionId}&Bpm={_bpm}&Style={_selectedStyle}&Seed={_seed}&TargetPurity={_targetPurity}")"
               target="_blank" rel="noopener" title="Download Standard MIDI File">
                📥 MIDI
            </a>

            <button class="transport-btn send-analyzer" @onclick="SendToAnalyzerAsync" disabled="@(_isSendingToAnalyzer || _melody is null || IsHumBusy)"
                    title="Synthesize and import directly into the Song Analyzer for AI stem separation and chord/pitch tracking">
                @(_isSendingToAnalyzer ? "⏳ Analyzing…" : "🔬 Analyze in Song Analyzer →")
            </button>
        </div>

        <div class="studio-selectors">
            <div class="selector-field">
                <span class="field-label">Key:</span>
                <RadzenDropDown TValue="int" @bind-Value="_selectedTonic" Data="@TonicOptions"
                                TextProperty="Name" ValueProperty="PitchClass"
                                Change="@(_ => OnConfigChanged())" Disabled="@IsHumBusy" class="compact-dropdown key-dd" id="tonic-select" />
            </div>

            <div class="selector-field match-field">
                <span class="field-label" title="Move the backing chords to the selected mode's own tonic, so the mode is heard as a colour rather than as the parent key with a displaced melody">
                    Match to mode:
                </span>
                <button class="match-toggle @(_matchHarmonyToMode ? "on" : "off")" type="button"
                        id="match-harmony-toggle" data-match-harmony="@(_matchHarmonyToMode ? "on" : "off")"
                        disabled="@IsHumBusy" @onclick="ToggleMatchHarmonyAsync">
                    @(_matchHarmonyToMode ? "On" : "Off")
                </button>
            </div>

            <div class="selector-field prog-field">
                <span class="field-label">Progression:</span>
                <RadzenDropDown TValue="string" @bind-Value="_selectedProgressionId" Data="@_progressions"
                                TextProperty="Name" ValueProperty="Id"
                                Change="@(_ => OnProgressionChanged())" Disabled="@IsHumBusy" class="compact-dropdown prog-dd" id="prog-select" />
            </div>

            <div class="selector-field">
                <span class="field-label">Style:</span>
                <RadzenDropDown TValue="MelodyStyle" @bind-Value="_selectedStyle" Data="@StyleOptions"
                                Change="@(_ => OnConfigChanged())" Disabled="@IsHumBusy" class="compact-dropdown style-dd" id="style-select" />
            </div>

            <div class="selector-field tempo-field">
                <span class="field-label">@($"{_bpm:0} BPM")</span>
                <RadzenSlider TValue="double" @bind-Value="_bpm" Min="50" Max="180" Step="2"
                              Change="@(args => OnTempoChanged(args))" Disabled="@IsHumBusy" class="compact-slider" id="tempo-slider" />
            </div>
        </div>
    </div>

    @* Hum Along. The progression plays on its own, the microphone records over it, and the take goes
       to the analyzer carrying the chords it was actually sung over — so the analysis reads the
       user's melody against real harmony instead of harmony guessed out of a solo voice. *@
    <div class="hum-strip @(IsHumBusy ? "busy" : "")" data-hum-state="@_humState">
        <div class="hum-lead">
            <span class="hum-icon">🎤</span>
            <div class="hum-copy">
                <span class="hum-title">Hum Along</span>
                <span class="hum-sub">@HumSubtitle</span>
            </div>
        </div>

        <div class="hum-actions">
            @switch (_humState)
            {
                case HumState.Idle:
                    <button class="hum-btn record" type="button" id="hum-record"
                            @onclick="StartHumAsync" disabled="@(_melody is null || _isLoading)">
                        ● Record over these chords
                    </button>
                    break;

                case HumState.CountingIn:
                    <span class="hum-countdown">Counting in…</span>
                    break;

                case HumState.Recording:
                    <span class="hum-dot" aria-hidden="true"></span>
                    <button class="hum-btn stop" type="button" id="hum-stop" @onclick="StopHumAsync">
                        ⏹ Stop · @($"{_humElapsedSec:0.0}s")
                    </button>
                    break;

                case HumState.Captured:
                    <span class="hum-take-len">Take: @($"{_humTakeSec:0.0}s")</span>
                    @* Hearing the take against the chords is the only way to judge it — the voice
                       alone says nothing about whether the phrase landed. *@
                    <button class="hum-btn review" type="button" id="hum-review"
                            @onclick="ToggleReviewAsync" disabled="@_isSavingHum">
                        @(_isReviewing ? "⏹ Stop" : "▶ Hear it back")
                    </button>
                    <button class="hum-btn analyze" type="button" id="hum-analyze"
                            @onclick="AnalyzeHumAsync" disabled="@_isSavingHum">
                        @(_isSavingHum ? "⏳ Saving…" : "🔬 Save & analyze my melody →")
                    </button>
                    <button class="hum-btn redo" type="button" id="hum-redo"
                            @onclick="DiscardHumAsync" disabled="@_isSavingHum">
                        🗑 Redo
                    </button>
                    break;
            }
        </div>
        @* Your line over the chords it was sung against. Kept in the tree whatever the hum state so
           the canvas reference stays valid across a redo; it is empty until a take is reviewed. *@
        <div class="hum-review-wrap @(_humState == HumState.Captured && _humReviewOn ? "" : "hidden")">
            <canvas class="hum-review" @ref="_humReviewCanvas" aria-hidden="true"
                    data-testid="hum-review"></canvas>
            <span class="hum-review-legend">chord tones · your line, lit where it agrees</span>
        </div>
    </div>

    <!-- 7 Relative Modes Horizontal Strip with Color-Themed Cards & Purity Badges -->
    @* The glow layer is authored here rather than injected by the module: Blazor re-renders the
       card list on every mode change, and a canvas spliced into the middle of a list it diffs by
       index is asking for trouble. It sits outside the strip and is positioned over it. *@
    <div class="modes-strip-wrap">
        <canvas class="mode-strip-fx" @ref="_stripCanvas" aria-hidden="true"></canvas>
        <div class="studio-modes-strip" @ref="_stripContainer">
        @foreach (var modeItem in SevenModesOrdered)
        {
            var isSelected = _selectedMode == modeItem.Mode;
            var modeNotes = ScaleModes.RelativeScaleNoteNames(_selectedTonic, modeItem.Mode);
            <div class="compact-mode-card @GetModeCssClass(modeItem.Mode) @(isSelected ? "selected" : "")"
                 @onclick="@(() => SampleModeAsync(modeItem.Mode))">
                <div class="mode-card-top">
                    <span class="compact-mode-title">@GetModeDisplayName(modeItem.Mode)</span>
                    <div class="card-badges">
                        @if (isSelected && _melody is not null)
                        {
                            <span class="compact-purity-pill" title="Actual Modal Purity score">@($"{_melody.ModePercentage:0.#}%")</span>
                        }
                        <span class="compact-degree-badge">@modeItem.Degree</span>
                    </div>
                </div>
                <div class="compact-scale-notes">
                    @for (var n = 0; n < modeNotes.Length; n++)
                    {
                        var noteName = modeNotes[n];
                        var isRoot = n == 0;
                        var isChar = n > 0 && IsCharacteristicNote(_selectedTonic, modeItem.Mode, noteName);
                        <span class="note-token @(isRoot ? "root-token" : (isChar ? "char-token" : ""))" title="@(isRoot ? "Mode Root Note" : (isChar ? "Characteristic Color Tone" : "Scale Note"))">@noteName</span>
                        if (n < modeNotes.Length - 1)
                        {
                            <span class="note-dot">·</span>
                        }
                    }
                </div>
                <div class="compact-mode-desc">@modeItem.Mood</div>
                <button class="compact-sample-btn @(isSelected && _isPlaying ? "playing" : "")"
                        type="button" @onclick:stopPropagation="true" @onclick="@(() => SampleModeAsync(modeItem.Mode))">
                    @(isSelected && _isPlaying ? "🔊 Playing" : "▶ Sample")
                </button>
            </div>
        }
        </div>
    </div>

    @if (_melody is not null)
    {
        <!-- Mid Ribbon: Scale spelling + Modal Purity + Chords Flow + Pentatonics -->
        <div class="studio-mid-ribbon">
            <div class="scale-spelling-box">
                <span class="ribbon-label">Scale:</span>
                <div class="spelling-badges">
                    @for (var i = 0; i < _melody.ScaleNotes.Count; i++)
                    {
                        var noteName = _melody.ScaleNotes[i];
                        var isRoot = i == 0;
                        var isChar = i > 0 && IsCharacteristicNote(_selectedTonic, _selectedMode, noteName);
                        <span class="compact-note-badge @(isRoot ? "root-badge" : (isChar ? "char-badge" : "scale-badge"))"
                              title="@(isRoot ? "Mode Tonic Root" : (isChar ? "Characteristic Modal Color Tone" : "In-Mode Scale Note"))">
                            @noteName
                            @if (isRoot)
                            {
                                <small class="badge-sub">[1]</small>
                            }
                            else if (isChar)
                            {
                                <small class="badge-sub">★</small>
                            }
                        </span>
                    }
                </div>
            </div>

            <div class="modal-purity-box">
                <span class="ribbon-label">Modal Purity:</span>
                <RadzenSlider TValue="double" @bind-Value="_targetPurity" Min="0" Max="100" Step="10"
                              Change="@(args => OnPurityChanged(args))" Disabled="@IsHumBusy"
                              class="compact-slider purity-slider" id="purity-slider" />
                <span class="purity-badge" data-purity-target="@($"{_targetPurity:0}")"
                      title="How hard the example insists on its mode. At the top the melody starts and ends on the mode root and the loop opens on the home chord; lower settings loosen both, so the opening chord need not be the mode's own.">
                    🎯 @($"{_targetPurity:0}%")
                </span>
                <span class="purity-measured" title="Modal purity actually measured in the generated melody">
                    measured @($"{_melody.ModePercentage:0.#}%")
                </span>
            </div>

            <div class="progression-chords-box">
                <span class="ribbon-label">Chords:</span>
                <div class="compact-chords-list">
                    @for (var i = 0; i < _melody.Chords.Count; i++)
                    {
                        var chord = _melody.Chords[i];
                        var isCurrent = _playheadSec >= chord.StartSec && _playheadSec < chord.EndSec;
                        <div class="compact-chord-pill @(isCurrent ? "current" : "")">
                            <span class="ch-bar">M@(i + 1)</span>
                            <span class="ch-sym">@chord.Symbol</span>
                        </div>
                    }
                </div>
            </div>

            <div class="pentatonics-box">
                <span class="ribbon-label">Pentatonics:</span>
                @foreach (var penta in PentatonicModes)
                {
                    var isSelected = _selectedMode == penta.Mode;
                    var pentaNotes = ScaleModes.RelativeScaleNoteNames(_selectedTonic, penta.Mode);
                    <button class="compact-penta-btn @(isSelected ? "selected" : "")" type="button"
                            @onclick="@(() => SampleModeAsync(penta.Mode))" title="@string.Join(" · ", pentaNotes)">
                        @penta.BaseName
                    </button>
                }
            </div>
        </div>

        <!-- Visual Piano Roll Panel -->
        <div class="studio-canvas-panel">
            <div class="canvas-panel-header">
                <div class="canvas-title-group">
                    <span class="canvas-panel-title">Piano Roll (Flute Melody Lead & Acoustic Piano Chords)</span>
                    <span class="purity-tag" title="Modal affinity score">@($"{_melody.ModePercentage:0.#}% Modal Purity")</span>
                    <span class="canvas-panel-desc">@_melody.CharacteristicExplanation</span>
                </div>
                <span class="canvas-panel-time">Playhead: @($"{_playheadSec:0.0}s / {_totalDurationSec:0.0}s")</span>
            </div>
            <AnalysisCanvas Model="_melody.Visual" SelectedWindowIndex="_activeWindowIndex"
                            PlayheadSec="_playheadSec" OnSeek="OnSeek" />
        </div>
    }
    else if (_isLoading)
    {
        <div class="modelab-loading">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText Text="Generating modal melodies and harmonies…" />
        </div>
    }
</div>

@code {
    private sealed record TonicOption(int PitchClass, string Name);
    private sealed record ModePresetInfo(ScaleMode Mode, string BaseName, string Degree, string Mood, string CharacteristicTone);

    private static readonly IReadOnlyList<TonicOption> TonicOptions =
    [
        new(0, "C"), new(1, "C# / Db"), new(2, "D"), new(3, "D# / Eb"),
        new(4, "E"), new(5, "F"), new(6, "F# / Gb"), new(7, "G"),
        new(8, "G# / Ab"), new(9, "A"), new(10, "A# / Bb"), new(11, "B")
    ];

    private static readonly IReadOnlyList<MelodyStyle> StyleOptions =
    [
        MelodyStyle.Lyrical,
        MelodyStyle.Arpeggiated,
        MelodyStyle.Syncopated,
        MelodyStyle.Motific
    ];

    // The 7 Church Modes ordered from Degree 1 to Degree 7
    private static readonly IReadOnlyList<ModePresetInfo> SevenModesOrdered =
    [
        new(ScaleMode.Ionian, "Ionian (Major)", "Deg 1", "Bright, joyful, heroic", "Starts on 1st degree"),
        new(ScaleMode.Dorian, "Dorian", "Deg 2", "Jazzy, soulful, hopeful", "Natural 6th"),
        new(ScaleMode.Phrygian, "Phrygian", "Deg 3", "Dark flamenco tension", "Minor 2nd"),
        new(ScaleMode.Lydian, "Lydian", "Deg 4", "Dreamy, floating wonder", "Sharp 4th"),
        new(ScaleMode.Mixolydian, "Mixolydian", "Deg 5", "Bluesy classic rock", "Flat 7th"),
        new(ScaleMode.Aeolian, "Aeolian (Minor)", "Deg 6", "Emotional natural minor", "Minor 6th"),
        new(ScaleMode.Locrian, "Locrian", "Deg 7", "Tense, diminished", "Diminished 5th & b2")
    ];

    private static readonly IReadOnlyList<ModePresetInfo> PentatonicModes =
    [
        new(ScaleMode.MajorPentatonic, "Major Pentatonic", "5-Tone", "Open, pastoral", "Degrees 1-2-3-5-6"),
        new(ScaleMode.MinorPentatonic, "Minor Pentatonic", "5-Tone", "Bluesy rock", "Degrees 6-1-2-3-5")
    ];

    private List<ChordProgressionDefinition> _progressions = [];
    private int _selectedTonic = 0; // C
    private string _selectedProgressionId = "pop-axis";
    private string _selectedProgressionName = "Axis of Pop (C - G - Am - F / I - V - vi - IV)";
    private ScaleMode _selectedMode = ScaleMode.Ionian;
    private MelodyStyle _selectedStyle = MelodyStyle.Lyrical;
    private double _targetPurity = 90.0;
    private double _bpm = 100.0;
    private int _seed = 42;
    private bool _matchHarmonyToMode = true;

    private GeneratedMelodyDto? _melody;
    private bool _isLoading = true;
    private bool _isPlaying;
    private bool _isLooping = true;
    private bool _isSendingToAnalyzer;
    private double _playheadSec;
    private double _totalDurationSec = 8.0;
    private int? _activeWindowIndex;

    private IJSObjectReference? _playerModule;
    private DotNetObjectReference<ModeLab>? _selfRef;

    // ── Hum Along ────────────────────────────────────────────────────────────────────────────────

    private enum HumState { Idle, CountingIn, Recording, Captured }

    /// <summary>Beats of count-in before the loop starts, so the singer has the pulse before bar one.</summary>
    private const int CountInBeats = 4;

    /// <summary>
    /// Ceiling on one take. The loop runs until Stop, but the browser is holding raw PCM the whole
    /// time — at 44.1 kHz mono this is roughly 26 MB, comfortably inside the API's 100 MB upload cap.
    /// </summary>
    private const double MaxHumSeconds = 300.0;

    private HumState _humState = HumState.Idle;
    private byte[]? _humTake;
    private double _humElapsedSec;
    private double _humTakeSec;
    private bool _isSavingHum;
    private bool _isReviewing;
    private readonly System.Diagnostics.Stopwatch _humWatch = new();
    private IJSObjectReference? _humModule;

    /// <summary>
    /// The arrangement the take was actually sung over, captured when recording starts. The take
    /// travels to the server with this rather than with whatever the selectors say at upload time —
    /// otherwise changing the key between Stop and Save would file the recording under chords the
    /// singer never heard.
    /// </summary>
    private ModalMelodyRequest? _humBacking;

    private bool IsHumBusy => _humState is HumState.CountingIn or HumState.Recording;

    private string HumSubtitle => _humState switch
    {
        HumState.CountingIn => "Get ready…",
        HumState.Recording => $"Recording over {_selectedProgressionName}. The loop repeats until you press Stop.",
        HumState.Captured => "Analyzed against the chords you actually heard — not chords guessed from your voice.",
        _ => "Roll 🎲 New Chords until you like the progression, then record. Headphones keep the piano out of your take.",
    };

    private string CurrentParentKeyName
        => TonicOptions.FirstOrDefault(t => t.PitchClass == _selectedTonic)?.Name ?? "C";

    private string GetModeDisplayName(ScaleMode mode)
    {
        var offset = ScaleModes.ModeDegreeOffset(mode);
        var modeRootName = ScaleModes.NoteName((_selectedTonic + offset) % 12);
        return $"{modeRootName} {mode}";
    }

    private static string GetModeCssClass(ScaleMode mode) => mode switch
    {
        ScaleMode.Ionian => "mode-ionian",
        ScaleMode.Dorian => "mode-dorian",
        ScaleMode.Phrygian => "mode-phrygian",
        ScaleMode.Lydian => "mode-lydian",
        ScaleMode.Mixolydian => "mode-mixolydian",
        ScaleMode.Aeolian => "mode-aeolian",
        ScaleMode.Locrian => "mode-locrian",
        _ => "",
    };

    private static bool IsCharacteristicNote(int parentTonic, ScaleMode mode, string noteName)
    {
        var offset = ScaleModes.ModeDegreeOffset(mode);
        var modeRootClass = (parentTonic + offset) % 12;
        // The table lives in PoMode.Shared so the client and the analyzer cannot drift apart on which
        // degree gives a mode its colour.
        var charInterval = ScaleModes.CharacteristicIntervals(mode)[0];
        var charPitchClass = (modeRootClass + charInterval) % 12;
        return string.Equals(noteName, ScaleModes.NoteName(charPitchClass), StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var progs = await Analysis.GetModalProgressionsAsync();
            if (progs is { Count: > 0 })
            {
                _progressions = progs;
                _selectedProgressionId = _progressions[0].Id;
                _selectedProgressionName = _progressions[0].Name;
                _bpm = _progressions[0].DefaultBpm;

                // Open on the harmony that matches the mode the strip starts on, so the first thing
                // heard is already the mode rather than the parent key.
                ApplyModeHarmony(_selectedMode);
            }
            await RefreshMelodyAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Initialization Error", ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>The selectors as the server's request shape — one copy, so the preview, the analyzer
    /// hand-off and a hum take can never be generated from subtly different settings.</summary>
    private ModalMelodyRequest CurrentRequest() => new(
        TonicPitchClass: _selectedTonic,
        Mode: _selectedMode,
        ProgressionId: _selectedProgressionId,
        Bpm: _bpm,
        Style: _selectedStyle,
        Seed: _seed,
        TargetPurity: _targetPurity);

    private async Task RefreshMelodyAsync()
    {
        _melody = await Analysis.GenerateModalMelodyAsync(CurrentRequest());
        if (_melody is not null)
        {
            _totalDurationSec = _melody.MelodyNotes.Count > 0
                ? Math.Max(_melody.MelodyNotes.Max(n => n.StartSec + n.DurationSec), _melody.Chords.Max(c => c.EndSec))
                : 8.0;

            if (_isPlaying && _playerModule is not null)
            {
                await _playerModule.InvokeVoidAsync("updateMelody", _melody.MelodyNotes, _melody.BackingNotes, _totalDurationSec);
            }
        }
    }

    /// <summary>
    /// Points the harmony at the selected mode's own signature cadence. A mode is a tonal centre, not
    /// just a note set: over a progression that keeps insisting on the parent key, every mode comes out
    /// sounding like that key with the melody starting somewhere else.
    /// </summary>
    private void ApplyModeHarmony(ScaleMode mode)
    {
        if (!_matchHarmonyToMode) return;

        var signature = _progressions.SignatureFor(mode);
        if (signature is null || signature.Id == _selectedProgressionId) return;

        _selectedProgressionId = signature.Id;
        _selectedProgressionName = signature.Name;
        _bpm = signature.DefaultBpm;
    }

    private async Task SampleModeAsync(ScaleMode mode)
    {
        // A captured take belongs to the chords it was sung over. Changing the arrangement while it
        // is still on screen would leave "Save my melody" offering to file it under an arrangement
        // nobody sang, so the take is dropped along with the settings that produced it.
        if (IsHumBusy) return;
        await StopReviewIfPlayingAsync();
        DiscardHumTake();

        _selectedMode = mode;
        ApplyModeHarmony(mode);
        await RefreshMelodyAsync();

        // Always restart the picked mode from its first beat. Falling through to updateMelody while
        // a take is in flight kept the previous mode's chords and loop length, and resuming on a
        // stale pause offset dropped the new sample mid-phrase.
        await StopAsync();
        await PlayAsync();
    }

    private async Task OnConfigChanged(object? _ = null)
    {
        // A captured take belongs to the chords it was sung over. Changing the arrangement while it
        // is still on screen would leave "Save my melody" offering to file it under an arrangement
        // nobody sang, so the take is dropped along with the settings that produced it.
        if (IsHumBusy) return;
        await StopReviewIfPlayingAsync();
        DiscardHumTake();

        await RefreshMelodyAsync();
        if (_isPlaying)
        {
            // The arrangement just changed underneath the playhead, so this is a new take.
            await StopAsync();
            await PlayAsync();
        }
    }

    private async Task OnPurityChanged(double _ = 0)
    {
        // A captured take belongs to the chords it was sung over. Changing the arrangement while it
        // is still on screen would leave "Save my melody" offering to file it under an arrangement
        // nobody sang, so the take is dropped along with the settings that produced it.
        if (IsHumBusy) return;
        await StopReviewIfPlayingAsync();
        DiscardHumTake();

        // The slider hands back negative zero at the bottom of its travel, which formats as "-0%".
        if (_targetPurity <= 0) _targetPurity = 0;

        await RefreshMelodyAsync();
        if (_isPlaying)
        {
            // The arrangement just changed underneath the playhead, so this is a new take.
            await StopAsync();
            await PlayAsync();
        }
    }

    private async Task OnProgressionChanged(object? _ = null)
    {
        // A captured take belongs to the chords it was sung over. Changing the arrangement while it
        // is still on screen would leave "Save my melody" offering to file it under an arrangement
        // nobody sang, so the take is dropped along with the settings that produced it.
        if (IsHumBusy) return;
        await StopReviewIfPlayingAsync();
        DiscardHumTake();

        var prog = _progressions.FirstOrDefault(p => p.Id == _selectedProgressionId);
        if (prog is not null)
        {
            _selectedProgressionName = prog.Name;
            _bpm = prog.DefaultBpm;
            _selectedMode = prog.SuggestedMode;
        }
        await RefreshMelodyAsync();
        if (_isPlaying)
        {
            // The arrangement just changed underneath the playhead, so this is a new take.
            await StopAsync();
            await PlayAsync();
        }
    }

    private async Task OnTempoChanged(double _ = 0)
    {
        // A captured take belongs to the chords it was sung over. Changing the arrangement while it
        // is still on screen would leave "Save my melody" offering to file it under an arrangement
        // nobody sang, so the take is dropped along with the settings that produced it.
        if (IsHumBusy) return;
        await StopReviewIfPlayingAsync();
        DiscardHumTake();

        await RefreshMelodyAsync();
        if (_isPlaying)
        {
            // The arrangement just changed underneath the playhead, so this is a new take.
            await StopAsync();
            await PlayAsync();
        }
    }

    private async Task RandomizeSeedAsync()
    {
        // A captured take belongs to the chords it was sung over. Changing the arrangement while it
        // is still on screen would leave "Save my melody" offering to file it under an arrangement
        // nobody sang, so the take is dropped along with the settings that produced it.
        if (IsHumBusy) return;
        await StopReviewIfPlayingAsync();
        DiscardHumTake();

        _seed = Random.Shared.Next(1, 100000);
        await RefreshMelodyAsync();

        // A new melody is a new take, so it starts from bar one. Swapping the notes underneath a
        // running playhead left it partway through a phrase that no longer existed.
        var wasPlaying = _isPlaying;
        await StopAsync();
        if (wasPlaying)
        {
            await PlayAsync();
        }
    }

    /// <summary>
    /// Rolls a different progression to sing over. Deliberately leaves the key alone: a singer picks
    /// a key for their own range and does not want it moving under them, whereas the chords are the
    /// thing worth re-rolling until one sounds worth a take.
    ///
    /// <para>Sets the mode from the progression the way the dropdown does, and never routes through
    /// <see cref="ApplyModeHarmony"/> — that would look up the new mode's signature cadence and snap
    /// the harmony straight back off the roll.</para>
    /// </summary>
    private async Task RandomizeProgressionAsync()
    {
        if (IsHumBusy || _progressions.Count < 2) return;

        // Re-roll rather than allow a no-op: a dice button that lands on the same progression reads
        // as broken, and with a catalog this size that happens often.
        ChordProgressionDefinition next;
        do
        {
            next = _progressions[Random.Shared.Next(_progressions.Count)];
        }
        while (next.Id == _selectedProgressionId);

        _selectedProgressionId = next.Id;
        _selectedProgressionName = next.Name;
        _bpm = next.DefaultBpm;
        _selectedMode = next.SuggestedMode;

        // A fresh progression deserves a fresh melody over it — the old seed's phrases were shaped
        // around chords that are gone.
        _seed = Random.Shared.Next(1, 100000);

        // A roll that lands while a take is already captured would leave "Save my melody" pointing
        // at chords that are no longer on screen. The take itself still carries its own backing, but
        // the screen would be lying about what it was.
        await StopReviewIfPlayingAsync();
        DiscardHumTake();

        await RefreshMelodyAsync();

        // Audition it straight away: the whole point of the roll is to hear whether it is worth
        // singing over, and from bar one rather than wherever the previous loop had got to.
        var wasPlaying = _isPlaying;
        await StopAsync();
        if (wasPlaying)
        {
            await PlayAsync();
        }
    }

    private async Task EnsureHumRecorderAsync()
        => _humModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hum-recorder.js");

    /// <summary>
    /// Opens the microphone, counts the singer in, then loops the chords alone while the take runs.
    /// The generated melody is muted for the duration: the only melody that should reach the
    /// analyzer is the one being sung.
    /// </summary>
    private async Task StartHumAsync()
    {
        if (_melody is null || _humState is not HumState.Idle) return;
        _humState = HumState.CountingIn;

        try
        {
            await EnsureHumRecorderAsync();
            await EnsurePlayerAsync();
            if (_humModule is null || _playerModule is null)
            {
                _humState = HumState.Idle;
                return;
            }

            await StopReviewIfPlayingAsync();
            _humBacking = CurrentRequest();
            _humTake = null;
            _humElapsedSec = 0;

            await StopAsync();
            // The take runs until Stop, so the chords have to keep coming regardless of what the
            // transport's own loop toggle says. It is restored when the take ends.
            await _playerModule.InvokeVoidAsync("setLooping", true);

            // Open the microphone before the clicks: the first take of a session raises the
            // permission prompt, and counting down to a dialog box helps nobody.
            if (!await _humModule.InvokeAsync<bool>("beginCapture"))
            {
                _humState = HumState.Idle;
                NotificationService.Notify(
                    NotificationSeverity.Error, "Hum Along", "The microphone could not be opened.");
                return;
            }

            await _humModule.InvokeVoidAsync("countIn", _bpm, CountInBeats);

            // Chords only — an empty melody list, so the flute never sounds while the mic is open.
            _humState = HumState.Recording;
            _isPlaying = true;
            _humWatch.Restart();
            await _playerModule.InvokeVoidAsync(
                "play", Array.Empty<NoteEvent>(), _melody.BackingNotes, _totalDurationSec, _selfRef);
        }
        catch (Exception ex)
        {
            _humState = HumState.Idle;
            _humWatch.Reset();
            await CancelHumCaptureAsync();
            NotificationService.Notify(NotificationSeverity.Error, "Hum Along", ex.Message);
        }
    }

    /// <summary>Ends the take and keeps the encoded audio for the singer to save or redo.</summary>
    private async Task StopHumAsync()
    {
        if (_humState is not HumState.Recording) return;
        // Claim the transition before the first await, so a take that hits the length cap on one
        // playhead tick cannot also be stopped by the next one.
        _humState = HumState.Captured;
        _humTakeSec = _humWatch.Elapsed.TotalSeconds;
        _humWatch.Reset();

        try
        {
            // finishCapture reads the player's downbeat to trim the take to bar one, so it has to
            // run while the transport is still going.
            var take = _humModule is null
                ? []
                : await _humModule.InvokeAsync<byte[]>("finishCapture");
            await StopAsync();
            if (_playerModule is not null)
            {
                await _playerModule.InvokeVoidAsync("setLooping", _isLooping);
            }

            // Empty covers both "the microphone gave us nothing" and "the take was all count-in" —
            // the recorder refuses to encode either, so neither reaches the analyzer.
            if (take.Length == 0)
            {
                _humState = HumState.Idle;
                NotificationService.Notify(
                    NotificationSeverity.Warning, "Hum Along",
                    "Nothing usable was captured — check the microphone and try a longer take.");
                return;
            }
            _humTake = take;
        }
        catch (Exception ex)
        {
            _humState = HumState.Idle;
            NotificationService.Notify(NotificationSeverity.Error, "Hum Along", ex.Message);
        }
    }

    /// <summary>Uploads the take with the backing it was sung over, then opens it in the analyzer.</summary>
    private async Task AnalyzeHumAsync()
    {
        if (_humTake is null || _humBacking is null || _isSavingHum) return;
        _isSavingHum = true;
        try
        {
            await StopReviewIfPlayingAsync();
            var job = await Analysis.UploadHumTakeAsync(_humTake, _humBacking);
            if (job is not null && !string.IsNullOrEmpty(job.JobId))
            {
                DiscardHumTake();
                NotificationService.Notify(
                    NotificationSeverity.Success, "Hum Along", "Take saved — analyzing your melody against those chords.");
                Navigation.NavigateTo($"/?job={job.JobId}");
            }
            else
            {
                NotificationService.Notify(
                    NotificationSeverity.Error, "Hum Along", "The server would not accept the take.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Hum Along", ex.Message);
        }
        finally
        {
            _isSavingHum = false;
        }
    }

    /// <summary>Plays the take back with its chords underneath, or stops that playback.</summary>
    private async Task ToggleReviewAsync()
    {
        if (_humModule is null || _melody is null) return;
        try
        {
            if (_isReviewing)
            {
                _isReviewing = false;
                await _humModule.InvokeVoidAsync("stopReview");
                _isPlaying = false;
                _playheadSec = 0;
                return;
            }

            // The player is driven from inside the recorder so both start on one instant; this side
            // only has to agree that a take is now playing.
            _isReviewing = true;
            _isPlaying = true;
            var seconds = await _humModule.InvokeAsync<double>(
                "reviewTake", _melody.BackingNotes, _totalDurationSec, _selfRef);
            if (seconds <= 0)
            {
                _isReviewing = false;
                _isPlaying = false;
                NotificationService.Notify(
                    NotificationSeverity.Warning, "Hum Along", "The take could not be played back.");
            }
        }
        catch (Exception ex)
        {
            _isReviewing = false;
            _isPlaying = false;
            NotificationService.Notify(NotificationSeverity.Error, "Hum Along", ex.Message);
        }
    }

    /// <summary>Raised by the recorder when the take has played all the way through.</summary>
    [JSInvokable]
    public void OnHumReviewEnded()
    {
        _isReviewing = false;
        _isPlaying = false;
        _playheadSec = 0;
        _activeWindowIndex = null;
        StateHasChanged();
    }

    private async Task DiscardHumAsync()
    {
        await StopReviewIfPlayingAsync();
        DiscardHumTake();
    }

    private async Task StopReviewIfPlayingAsync()
    {
        if (!_isReviewing || _humModule is null) return;
        _isReviewing = false;
        _isPlaying = false;
        try
        {
            await _humModule.InvokeVoidAsync("stopReview");
        }
        catch (JSDisconnectedException) { }
    }

    private void DiscardHumTake()
    {
        if (_humState is HumState.Captured)
        {
            _humState = HumState.Idle;
        }
        _humTake = null;
        _humBacking = null;
        _humElapsedSec = 0;
        _humTakeSec = 0;
        _isReviewing = false;
        // Fire-and-forget: the take's bytes and decoded buffer live in the JS module too, and a page
        // that has moved on must not keep them alive.
        if (_humModule is not null)
        {
            _ = InvokeVoidSafelyAsync(_humModule, "clearTake");
        }
    }

    private static async Task InvokeVoidSafelyAsync(IJSObjectReference module, string identifier)
    {
        try
        {
            await module.InvokeVoidAsync(identifier);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private async Task CancelHumCaptureAsync()
    {
        if (_humModule is null) return;
        try
        {
            await _humModule.InvokeVoidAsync("cancelCapture");
        }
        catch (JSDisconnectedException) { }
    }

    private async Task SendToAnalyzerAsync()
    {
        if (_melody is null || _isSendingToAnalyzer) return;
        _isSendingToAnalyzer = true;
        try
        {
            if (_isPlaying)
            {
                await PauseAsync();
            }

            var job = await Analysis.AnalyzeModalMelodyAsync(CurrentRequest());
            if (job is not null && !string.IsNullOrEmpty(job.JobId))
            {
                NotificationService.Notify(NotificationSeverity.Success, "Mode Lab Bridge", "Synthesized WAV audio & queued analysis job!");
                Navigation.NavigateTo($"/?job={job.JobId}");
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Analysis Error", "Failed to queue analysis job.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            _isSendingToAnalyzer = false;
        }
    }

    private async Task EnsurePlayerAsync()
    {
        _playerModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/modal-player.js");
        _selfRef ??= DotNetObjectReference.Create(this);
    }

    private async Task PlayAsync()
    {
        if (_melody is null) return;
        await EnsurePlayerAsync();
        if (_playerModule is null) return;

        _isPlaying = true;
        await _playerModule.InvokeVoidAsync("play", _melody.MelodyNotes, _melody.BackingNotes, _totalDurationSec, _selfRef);
    }

    private async Task PauseAsync()
    {
        if (_playerModule is null) return;
        _isPlaying = false;
        await _playerModule.InvokeVoidAsync("pause");
    }

    private async Task StopAsync()
    {
        if (_playerModule is null) return;
        _isPlaying = false;
        _playheadSec = 0;
        _activeWindowIndex = null;
        await _playerModule.InvokeVoidAsync("stop");
    }

    private async Task ToggleMatchHarmonyAsync()
    {
        // A captured take belongs to the chords it was sung over. Changing the arrangement while it
        // is still on screen would leave "Save my melody" offering to file it under an arrangement
        // nobody sang, so the take is dropped along with the settings that produced it.
        if (IsHumBusy) return;
        await StopReviewIfPlayingAsync();
        DiscardHumTake();

        _matchHarmonyToMode = !_matchHarmonyToMode;
        if (_matchHarmonyToMode)
        {
            ApplyModeHarmony(_selectedMode);
        }
        else if (_progressions.FirstOrDefault(p => p.Id == _selectedProgressionId)?.RootsOn == HarmonicRoot.ModeRoot)
        {
            // Turning the match off is a request for one harmony that does not follow the mode, so a
            // mode-rooted progression has to give way to a parent-rooted one or nothing would change.
            var shared = _progressions.FirstSharedHarmony();
            if (shared is not null)
            {
                _selectedProgressionId = shared.Id;
                _selectedProgressionName = shared.Name;
                _bpm = shared.DefaultBpm;
            }
        }
        await RefreshMelodyAsync();
        if (_isPlaying)
        {
            await StopAsync();
            await PlayAsync();
        }
    }

    private async Task ToggleLoopAsync()
    {
        _isLooping = !_isLooping;
        if (_playerModule is not null)
        {
            await _playerModule.InvokeVoidAsync("setLooping", _isLooping);
        }
    }

    private void OnSeek(double seekSec)
    {
        _playheadSec = seekSec;
        if (_playerModule is not null)
        {
            _ = _playerModule.InvokeVoidAsync("seek", seekSec);
        }
        UpdateActiveWindow(seekSec);
    }

    /// <summary>Raised by the player when a non-looping take runs off its end.</summary>
    [JSInvokable]
    public void OnPlaybackEnded()
    {
        _isPlaying = false;
        _playheadSec = 0;
        _activeWindowIndex = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPlayheadUpdated(double positionSec)
    {
        _playheadSec = positionSec;
        UpdateActiveWindow(positionSec);

        // The player already ticks once per animation frame while the loop runs, so the take's
        // running time rides on that rather than on a second timer of its own.
        if (_humState is HumState.Recording)
        {
            _humElapsedSec = _humWatch.Elapsed.TotalSeconds;
            if (_humElapsedSec >= MaxHumSeconds)
            {
                _ = StopHumAsync();
            }
        }

        StateHasChanged();
    }

    private void UpdateActiveWindow(double pos)
    {
        if (_melody?.ModalAnalysis is { } result)
        {
            _activeWindowIndex = result.WindowIndexAt(pos);
        }
    }

    private ElementReference _humReviewCanvas;
    private IJSObjectReference? _humReviewFx;
    private bool _humReviewOn;
    private ElementReference _stripCanvas;
    private ElementReference _stripContainer;
    private IJSObjectReference? _stripFx;
    private bool _stripFxOn;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                // Imported here rather than by the hum flow: hum-recorder.js drives the panel
                // directly during playback, but the canvas it draws on has to be claimed once, and
                // the first render is the only moment that is true exactly once.
                _humReviewFx = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fx-hum-review.js");
                _humReviewOn = await _humReviewFx.InvokeAsync<bool>("init", _humReviewCanvas);

                _stripFx = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fx-mode-strip.js");
                // False without WebGL2 or with effects off; the cards keep their own borders and
                // badges either way, which is where the information actually lives.
                _stripFxOn = await _stripFx.InvokeAsync<bool>("init", _stripCanvas, _stripContainer);
            }
            else if (_stripFxOn && _stripFx is not null)
            {
                // Which card is selected lives in a CSS class Blazor rewrites, and there is no event
                // to observe that from — so the re-render itself is the signal, and the module
                // re-measures on the next frame rather than on every one.
                await _stripFx.InvokeVoidAsync("refresh", _stripContainer);
            }
        }
        catch (JSDisconnectedException)
        {
            // Navigated away mid-render.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_humReviewFx is not null)
            {
                await _humReviewFx.InvokeVoidAsync("dispose");
                await _humReviewFx.DisposeAsync();
            }
            if (_stripFx is not null)
            {
                await _stripFx.InvokeVoidAsync("dispose", _stripContainer);
                await _stripFx.DisposeAsync();
            }
            // Before the player, so a take still running when the page is left releases the
            // microphone — otherwise the browser's recording indicator stays lit for the session.
            if (_humModule is not null)
            {
                await _humModule.InvokeVoidAsync("dispose");
                await _humModule.DisposeAsync();
            }
            if (_playerModule is not null)
            {
                await _playerModule.InvokeVoidAsync("dispose");
                await _playerModule.DisposeAsync();
            }
            _selfRef?.Dispose();
        }
        catch (JSDisconnectedException) { }
    }
}
