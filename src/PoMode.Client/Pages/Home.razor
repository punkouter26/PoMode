@page "/"
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@using PoMode.Shared.Analysis
@using PoMode.Shared.Serialization
@inject AnalysisClient Analysis
@inject MockDataState MockData
@inject AnalysisViewState ViewState
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PoMode</PageTitle>

@if (_visual is null && _status is null)
{
    <RadzenCard class="intake-card">
        @* One dropzone, four intake paths. The primary action is "drop a file here" — everything else
           lives behind a small "More ways" disclosure so the empty state stays focused on the work. *@
        <div class="upload-hero">
            <RadzenIcon Icon="graphic_eq" class="upload-hero-icon" />
            <RadzenText TextStyle="TextStyle.H6" Text="Drop a track, get the theory" />
            <RadzenText class="upload-hero-sub"
                        Text=".mp3 or .wav · up to 100 MB" />
            <RadzenUpload Url="@UploadUrl" Accept=".mp3,.wav" Auto="true"
                          Progress="@OnUploadProgress"
                          Complete="@OnUploadComplete" Error="@OnUploadError" ChooseText="Choose audio file" />
            @if (_executorStages is not null)
            {
                @* One radio group per pipeline stage. "Auto" keeps the server's ranked default; a
                   pick rides along on the upload URL and the planner honours it when available. *@
                <div class="executor-pickers" role="group" aria-label="Analysis models per stage">
                    @foreach (var (stageName, choices) in _executorStages)
                    {
                        <div class="executor-picker">
                            <span class="executor-picker-label">@StageLabel(stageName)</span>
                            @if (choices.Count <= 2)
                            {
                                @* One real option: nothing to pick, so say it plainly — disabled
                                   radios read as "broken", not as "no choice needed". *@
                                <span class="executor-picker-single">
                                    @(choices.Count == 2 ? choices[1].Label : "Auto (server picks best)")
                                </span>
                            }
                            else
                            {
                                <RadzenRadioButtonList TValue="string" Data="@choices"
                                                       TextProperty="Label" ValueProperty="Value"
                                                       Value="@ExecutorChoiceOf(stageName)"
                                                       Change="@(value => OnExecutorPicked(stageName, value))"
                                                       Orientation="Orientation.Vertical"
                                                       class="executor-radios" />
                            }
                        </div>
                    }
                </div>
            }
            @if (_uploading)
            {
                <div class="upload-progress">
                    <RadzenProgressBar Value="@_uploadPercent" ShowValue="false" />
                    <RadzenText class="upload-progress-text" Text="@UploadProgressText" />
                </div>
            }
            @if (_uploadError is not null)
            {
                <RadzenText class="upload-error" Text="@_uploadError" />
            }
            @if (ViewState.IsAdvanced)
            {
                <button class="more-ways" type="button" @onclick="ToggleMoreInputsAsync"
                        aria-expanded="@_moreInputsOpen" aria-controls="more-inputs-panel">
                    @(_moreInputsOpen ? "Hide other ways" : "More ways to get audio in")
                </button>
                @if (_moreInputsOpen)
                {
                    <div id="more-inputs-panel" class="more-inputs" role="region" aria-label="Other ways to provide audio">
                        <fieldset class="more-input-block">
                            <legend>From URL</legend>
                            <RadzenText class="more-input-hint"
                                         Text="Paste a page URL (YouTube, SoundCloud, …). The server fetches the audio with yt-dlp." />
                            <div class="url-row">
                                <RadzenTextBox @bind-Value="_url" Placeholder="https://…" Disabled="@_fetchingUrl"
                                               aria-label="Audio page URL" />
                                <RadzenButton Text="@(_fetchingUrl ? "Fetching…" : "Analyze")" Click="@OnAnalyzeUrl"
                                              Disabled="@_fetchingUrl" ButtonStyle="ButtonStyle.Primary" />
                            </div>
                            @if (_urlError is not null)
                            {
                                <RadzenText class="upload-error" Text="@_urlError" />
                            }
                        </fieldset>
                        <fieldset class="more-input-block">
                            <legend>Record</legend>
                            <RadzenText class="more-input-hint"
                                         Text="Capture from your microphone, then analyze like an upload." />
                            <div class="record-row">
                                @if (!_recording)
                                {
                                    <RadzenButton Text="Start recording" Click="@OnStartRecording" ButtonStyle="ButtonStyle.Primary" />
                                }
                                else
                                {
                                    <RadzenButton Text="Stop and analyze" Click="@OnStopRecording" ButtonStyle="ButtonStyle.Danger" />
                                    <RadzenText class="recording-hint" Text="Recording…" />
                                }
                            </div>
                            @if (_recordError is not null)
                            {
                                <RadzenText class="upload-error" Text="@_recordError" />
                            }
                        </fieldset>
                        <fieldset class="more-input-block">
                            <legend>Batch</legend>
                            <BatchPanel />
                        </fieldset>
                    </div>
                }
            }
        </div>
        @* Machine-readable probe result: browser tests wait for it before uploading, so a capability
           declaration can never race the probe. "none" = probed, nothing usable; empty = still probing. *@
        <span class="client-capability" hidden data-capability="@(_probed ? _clientCapability ?? "none" : "")"></span>
    </RadzenCard>
}
else if (ViewState.IsAdvanced)
{
    @* The full intake card collapses once a job is on screen; one slim action brings it back.
       The capability probe's marker must survive the collapse — browser tests wait on it. *@
    <div class="intake-slim">
        <RadzenButton Text="+ New track" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                      Click="@ResetForNewUpload" title="Analyze another song" />
        <span class="client-capability" hidden data-capability="@(_probed ? _clientCapability ?? "none" : "")"></span>
    </div>
}

@if (_status is not null && (ViewState.IsAdvanced || _status.Stage != JobStage.Complete || _visual is null))
{
    <JobProgress Status="_status" OnCancel="@CancelJobAsync" />
    @if (_preview is { } preview && preview.Confidence > 0 && !_status.Stage.IsTerminal())
    {
        <RadzenText class="preview-line"
                    Text="@($"First look: likely {preview.TonicName}, ~{preview.TempoBpm:0} BPM — the full analysis is refining this…")" />
    }
    @if (_status.Stage == JobStage.Complete && _visual is null)
    {
        <RadzenCard aria-hidden="true">
            <div class="pm-skeleton results-skeleton"></div>
        </RadzenCard>
    }
    @if (ViewState.IsAdvanced)
    {
        <RadzenButton class="debug-toggle" Text="@(_showDebug ? "Hide debug" : "Show debug")"
                      Click="@(() => _showDebug = !_showDebug)" ButtonStyle="ButtonStyle.Light" />
        @if (_showDebug)
        {
            <DebugPanel Status="_status" />
        }
    }
}

@if (_visual is not null && _result is not null && _status is not null)
{
    @if (ViewState.IsBasic)
    {
        <BasicView Status="_status" Result="_result" Visual="_visual"
                   SelectedWindowIndex="_selectedWindow" PlayheadSec="_playheadSec"
                   OnSeek="OnSeek"
                   OnAnalyzeNew="@ResetForNewUpload" />
    }
    else
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H6"
                        Text="@($"{_visual.Notes.Count} notes · {_visual.Chords.Count} chords · {(_liveBpm > 0 ? _liveBpm : _result?.TempoBpm ?? 0):0} BPM{(_liveBpm > 0 ? " (this bar)" : "")}")" />
            <AnalysisCanvas Model="_visual" SelectedWindowIndex="_selectedWindow"
                            PlayheadSec="_playheadSec" OnSeek="OnSeek"
                            OnReady="@(element => _canvasElement = element)" />
            @if (_canvasElement is { } canvasElement)
            {
                <StemMixer JobId="@_status!.JobId" CanvasElement="canvasElement" SeekToSec="_playheadSec"
                           TonicName="@_result?.TonicName" TonicPitchClass="_result?.TonicPitchClass"
                           OnTempoChangedCallback="@(bpm => { _liveBpm = bpm; StateHasChanged(); })" />
            }
        </RadzenCard>

        <ModalHud Result="_result" Windows="_visual.Windows" SelectedWindowIndex="_selectedWindow"
                  OnShowLandscape="ShowLandscapeAsync" />

        <AdvancedStatsPanel Result="_result" Visual="_visual" />

        <div class="export-row">
            <RadzenButton class="share-card-button" Text="Share card (PNG)" Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Primary" Click="@OnShareCard" />
            <div class="export-menu">
                <button class="icon-button export-toggle" type="button" @onclick="ToggleExportAsync"
                        aria-haspopup="true" aria-expanded="@_exportOpen" title="Export">
                    Export ▾
                </button>
                @if (_exportOpen)
                {
                    <div class="export-dropdown" role="menu">
                        <a class="overflow-item" href="@($"api/analysis/{_status!.JobId}/midi")" target="_blank" rel="noopener" role="menuitem">
                            Download MIDI
                        </a>
                        <a class="overflow-item" href="@($"api/analysis/{_status!.JobId}/musicxml")" target="_blank" rel="noopener" role="menuitem">
                            Download MusicXML
                        </a>
                        <a class="overflow-item" href="@($"api/analysis/{_status!.JobId}/chord-chart")" target="_blank" rel="noopener" role="menuitem">
                            Download chord chart (text)
                        </a>
                    </div>
                }
            </div>
        </div>

        @* Bottom of the page in both views: the statistics and their written interpretation. *@
        <SongStatsPanel JobId="@_status!.JobId" />

        @if (_landscapeOn)
        {
            <RadzenCard class="landscape-card">
                <div class="landscape-head">
                    <RadzenText class="landscape-title" Text="3D mode landscape" />
                    <button class="icon-button" type="button" @onclick="HideLandscapeAsync" aria-label="Hide 3D mode landscape" title="Hide">✕</button>
                </div>
                <canvas class="landscape-canvas" @ref="_landscapeCanvas"></canvas>
                <RadzenText class="landscape-hint"
                            Text="Drag to orbit · scroll to zoom · height is confidence, colour is mode" />
            </RadzenCard>
        }
    }
}

@code {
    /// <summary>Set by the library's Open link (/?job=…): load that job instead of waiting for an upload.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "job")]
    public string? Job { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    private void OnViewStateChanged() => InvokeAsync(StateHasChanged);

    private void ResetForNewUpload()
    {
        _status = null;
        _visual = null;
        _result = null;
        _selectedWindow = null;
        _playheadSec = 0;
        _preview = null;
        Navigation.NavigateTo("/", replace: true);
    }

    private JobStatusDto? _status;
    private VisualizationPayload? _visual;

    /// <summary>Tempo of the measure the playhead is in; 0 until playback reports one.</summary>
    private double _liveBpm;
    private ModalResult? _result;
    private string? _uploadError;
    private bool _uploading;
    private int _uploadPercent;
    private long _uploadLoaded;
    private long _uploadTotal;
    private HubConnection? _hub;
    private int? _selectedWindow;
    private double _playheadSec;
    private ElementReference? _canvasElement;
    private IJSObjectReference? _pitchWorker;
    private IJSObjectReference? _recorder;
    private IJSObjectReference? _shareCard;
    private IJSObjectReference? _sfx;
    private IJSObjectReference? _themeJs;
    private IJSObjectReference? _landscape;
    private ElementReference _landscapeCanvas;
    private bool _landscapeOn;
    private bool _landscapeNeedsInit;
    private AnalysisPreviewDto? _preview;
    private bool _previewFetching;
    private string? _clientCapability;
    private bool _probed;
    private bool _showDebug;
    private string _url = "";
    private bool _fetchingUrl;
    private string? _urlError;
    private bool _recording;
    private string? _recordError;
    private bool _moreInputsOpen;
    private bool _exportOpen;

    private void ToggleMoreInputsAsync() => _moreInputsOpen = !_moreInputsOpen;

    private void ToggleExportAsync() => _exportOpen = !_exportOpen;

    private void ShowLandscapeAsync()
    {
        _landscapeOn = true;
        _landscapeNeedsInit = true;
    }

    private async Task HideLandscapeAsync()
    {
        _landscapeOn = false;
        if (_landscape is not null)
        {
            try { await _landscape.InvokeVoidAsync("dispose", _landscapeCanvas); }
            catch (JSDisconnectedException) { /* circuit torn down */ }
        }
    }

    /// <summary>Disposes the WebGL scene when a new job starts (TrackJobAsync calls this).</summary>
    private Task ToggleLandscape(bool on)
    {
        if (on) { ShowLandscapeAsync(); return Task.CompletedTask; }
        return HideLandscapeAsync();
    }
    private readonly HashSet<string> _delegatedJobs = [];

    /// <summary>One entry per stage radio group; "" = Auto (the server's ranked default).</summary>
    private sealed record ExecutorChoice(string Value, string Label);

    /// <summary>The raw server answer, kept so the choices can rebuild when the Tier-2 probe lands.</summary>
    private List<StageExecutorsDto>? _rawExecutorStages;

    /// <summary>What the pickers render: one stable choices list per stage, rebuilt only when the
    /// data or the browser capability changes — never per render.</summary>
    private List<(string Stage, List<ExecutorChoice> Choices)>? _executorStages;

    private readonly Dictionary<string, string> _executorChoices = [];

    private static string StageLabel(string stage) => stage switch
    {
        StageNames.Separating => "Separation",
        StageNames.PitchTracking => "Melody",
        StageNames.ChordDetecting => "Chords",
        StageNames.ModalAnalysis => "Modes",
        _ => stage,
    };

    private static string KindLabel(ExecutorKind kind) => kind switch
    {
        ExecutorKind.Model => "local model",
        ExecutorKind.Method => "code",
        ExecutorKind.Browser => "browser model",
        _ => kind.ToString(),
    };

    /// <summary>Rebuilds every stage's choices. Browser-tier options are offered only after this
    /// browser's Tier-2 probe succeeded — otherwise picking one would be silently ignored by the
    /// planner (the browser tier is invisible without clientCanInfer).</summary>
    private void RebuildExecutorChoices()
    {
        _executorStages = _rawExecutorStages?
            .Select(stage => (stage.Stage, BuildChoices(stage, browserCapable: _clientCapability is not null)))
            .ToList();
    }

    private static List<ExecutorChoice> BuildChoices(StageExecutorsDto stage, bool browserCapable)
    {
        // "Auto" stays unnamed on purpose: what the server actually picks can depend on this
        // browser's capability, so naming one executor here could advertise the wrong one.
        var choices = new List<ExecutorChoice>(stage.Executors.Count + 1)
        {
            new("", "Auto (server picks best)"),
        };
        foreach (var option in stage.Executors)
        {
            if (option.Kind == ExecutorKind.Browser && !browserCapable)
            {
                continue;
            }
            var suffix = option.Available ? "" : " — unavailable";
            choices.Add(new ExecutorChoice(option.Name, $"{option.Name} ({KindLabel(option.Kind)}){suffix}"));
        }
        return choices;
    }

    private string ExecutorChoiceOf(string stage)
        => _executorChoices.TryGetValue(stage, out var name) ? name : "";

    private void OnExecutorPicked(string stage, string? name)
    {
        if (string.IsNullOrEmpty(name))
        {
            _executorChoices.Remove(stage);
        }
        else
        {
            _executorChoices[stage] = name;
        }
    }

    /// <summary>
    /// Tier 2 availability is a per-job property of this browser (spec §4), declared at upload time
    /// so the server can plan the ClientDelegated tier. Until the probe has answered, uploads
    /// declare nothing and the plan is exactly what it always was. The per-stage model picks ride
    /// along as query params (keys from the shared <see cref="StageNames.ExecutorQueryKeys"/>
    /// table); Auto sends nothing. Derived per render — four short strings, and no cached copy
    /// that could ever go stale.
    /// </summary>
    private string UploadUrl
    {
        get
        {
            var query = new List<string>(4);
            if (_clientCapability is not null)
            {
                query.Add("clientCanInfer=true");
            }
            foreach (var (stage, queryKey) in StageNames.ExecutorQueryKeys)
            {
                if (_executorChoices.TryGetValue(stage, out var name))
                {
                    query.Add($"{queryKey}={Uri.EscapeDataString(name)}");
                }
            }
            return query.Count == 0 ? "api/analysis" : $"api/analysis?{string.Join("&", query)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ViewState.Changed += OnViewStateChanged;
        if (!string.IsNullOrWhiteSpace(ViewQuery))
        {
            ViewState.SetViewMode(ViewQuery);
        }
        // The pickers' data loads concurrently with the job-resume path; they pop in when ready.
        var executorsTask = LoadExecutorsAsync();
        if (!string.IsNullOrWhiteSpace(Job))
        {
            try
            {
                if (await Analysis.GetStatusAsync(Job) is { } status)
                {
                    await TrackJobAsync(status);
                }
            }
            catch (HttpRequestException)
            {
                // A stale or mistyped link: the page simply starts empty, same as no query at all.
            }
        }
        await executorsTask;
    }

    private async Task LoadExecutorsAsync()
    {
        try
        {
            _rawExecutorStages = await Analysis.GetExecutorsAsync();
            RebuildExecutorChoices();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException)
        {
            // No pickers, no problem: uploads simply use the server's ranked defaults. The wide
            // filter matters — a proxy serving HTML with a 200 throws JsonException, and that
            // must degrade the pickers, not fault the whole home page.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _pitchWorker = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pitch-worker.js");
            _clientCapability = await _pitchWorker.InvokeAsync<string?>("probeCapability");
            _probed = true;
            RebuildExecutorChoices(); // a capable browser may now offer the browser-tier options
            StateHasChanged();
        }

        if (_landscapeNeedsInit && _landscapeOn && _visual is not null)
        {
            _landscapeNeedsInit = false;
            _landscape ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/mode-landscape.js");
            await _landscape.InvokeVoidAsync("init", _landscapeCanvas, _visual.Windows.Select(w => new
            {
                startSec = w.StartSec, endSec = w.EndSec, modeTag = w.ModeTag, confidence = w.ModeConfidence,
            }));
        }
    }

    /// <summary>Fire-and-forget UI sound; any failure (autoplay policy, torn-down circuit) is silent.</summary>
    private async Task PlaySfxAsync(string name, params object?[] args)
    {
        try
        {
            _sfx ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/sfx.js");
            await _sfx.InvokeVoidAsync(name, args);
        }
        catch (JSException)
        {
            // Sounds are garnish, never an error.
        }
    }

    /// <summary>Canvas click. The window lookup is a plain time-range search, not analysis — the
    /// musical decisions all happened server-side in VisualizationBuilder.</summary>
    private void OnSeek(double seconds)
    {
        _playheadSec = seconds;
        _selectedWindow = _result?.WindowIndexAt(seconds);
    }

    private string UploadProgressText
        => _uploadPercent >= 100 ? "Upload sent — waiting for the server…"
            : _uploadTotal > 0
                ? $"Uploading… {_uploadPercent}% ({_uploadLoaded / 1048576.0:0.0} of {_uploadTotal / 1048576.0:0.0} MB)"
                : $"Uploading… {_uploadPercent}%";

    private void OnUploadProgress(UploadProgressArgs args)
    {
        _uploading = true;
        _uploadPercent = args.Progress;
        _uploadLoaded = args.Loaded;
        _uploadTotal = args.Total;
    }

    private async Task OnUploadComplete(UploadCompleteEventArgs args)
    {
        _uploading = false;
        _uploadError = null;
        // RadzenUpload hands back raw text; deserialize through the source-generated context.
        if (args.RawResponse is not { } rawResponse
            || JsonSerializer.Deserialize(rawResponse, PoModeJsonContext.Default.JobStatusDto) is not { } status)
        {
            _uploadError = "Unexpected server response.";
            Notifications.Notify(NotificationSeverity.Error, "Upload failed", "Unexpected server response.");
            return;
        }
        await PlaySfxAsync("chime");
        await TrackJobAsync(status);
    }

    private async Task OnAnalyzeUrl()
    {
        if (string.IsNullOrWhiteSpace(_url))
        {
            return;
        }
        _urlError = null;
        _fetchingUrl = true;
        try
        {
            var (status, error) = await Analysis.AnalyzeFromUrlAsync(_url.Trim());
            if (status is null)
            {
                _urlError = error ?? "Could not fetch that URL.";
                return;
            }
            await TrackJobAsync(status);
        }
        finally
        {
            _fetchingUrl = false;
        }
    }

    /// <summary>Hands the server-decided analysis to sharecard.js, which only draws it to a PNG.</summary>
    private async Task OnShareCard()
    {
        if (_result is null || _visual is null)
        {
            return;
        }
        _shareCard ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/sharecard.js");
        await _shareCard.InvokeVoidAsync("downloadCard", new
        {
            fileName = _status?.FileName,
            tonicName = _result.TonicName,
            primaryMode = _result.PrimaryMode?.ToString(),
            tempoBpm = _result.TempoBpm,
            tempoEstimated = _result.TempoEstimated,
            durationSec = _visual.DurationSec,
            minPitch = _visual.MinPitch,
            maxPitch = _visual.MaxPitch,
            notes = _visual.Notes.Select(n => new
            {
                midiPitch = n.MidiPitch, startSec = n.StartSec, durationSec = n.DurationSec, role = (int)n.Role,
            }),
            chords = _visual.Chords.Select(c => new { symbol = c.Symbol, startSec = c.StartSec, endSec = c.EndSec }),
            windows = _visual.Windows.Select(w => new { startSec = w.StartSec, endSec = w.EndSec, modeTag = w.ModeTag }),
        });
    }

    private async Task CancelJobAsync()
    {
        if (_status is null)
        {
            return;
        }
        await Analysis.CancelAsync(_status.JobId);
        Notifications.Notify(NotificationSeverity.Info, "Cancel requested",
            "The job stops at the next safe point.");
    }

    private async Task OnStartRecording()
    {
        _recordError = null;
        try
        {
            _recorder ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/audio-recorder.js");
            await _recorder.InvokeVoidAsync("startRecording");
            _recording = true;
        }
        catch (JSException)
        {
            _recordError = "Microphone access was denied or is unavailable.";
        }
    }

    private async Task OnStopRecording()
    {
        if (_recorder is null)
        {
            return;
        }
        _recording = false;
        await _recorder.InvokeVoidAsync("stopRecording");
        var wavBytes = await _recorder.InvokeAsync<byte[]>("getRecordedWavBytes");
        if (wavBytes.Length <= 44) // header-only WAV: nothing was captured
        {
            _recordError = "Nothing was recorded.";
            return;
        }
        var status = await Analysis.UploadAsync(wavBytes, "recording.wav", _clientCapability is not null);
        if (status is null)
        {
            _recordError = "The recording upload failed.";
            return;
        }
        await TrackJobAsync(status);
    }

    /// <summary>Shared by every intake path (upload, URL, recording): reset the result panels,
    /// connect the hub once, subscribe to the job, and reconcile against the current status.</summary>
    private async Task TrackJobAsync(JobStatusDto status)
    {
        _visual = null;
        _result = null;
        _selectedWindow = null;
        _playheadSec = 0;
        _preview = null;
        await ToggleLandscape(false); // disposes the WebGL scene; a bare flag flip would leak it
        // Clearing _visual removes the canvas, so the next analysis builds a fresh one. Drop the old
        // element too, or the mixer would initialise against a canvas that no longer exists.
        _canvasElement = null;
        _status = status;

        if (_hub is null)
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/analysis"))
                .Build();
            _hub.On<JobStatusDto>("JobStatusChanged", OnStatusChanged); // register once, not per upload
        }
        if (_hub.State == HubConnectionState.Disconnected)
        {
            await _hub.StartAsync();
        }
        await _hub.InvokeAsync("Subscribe", status.JobId);

        // The fake pipeline can finish before Subscribe lands — reconcile once.
        var current = await Analysis.GetStatusAsync(status.JobId);
        if (current is not null)
        {
            await OnStatusChanged(current);
        }
    }

    private async Task OnStatusChanged(JobStatusDto status)
    {
        if (_status?.JobId != status.JobId)
        {
            return;
        }
        _status = status;
        if (status.Stage == JobStage.AwaitingClient
            && _pitchWorker is not null
            && _delegatedJobs.Add(status.JobId))
        {
            // Fire and forget: the module swallows its own failures, and the server's Tier2 timeout
            // falls through to the next tier if this browser never posts a result.
            _ = _pitchWorker.InvokeVoidAsync("runDelegated", status.JobId);
        }
        // The fast first-look preview: worth one fetch per push until it appears, while running.
        if (_preview is null && !_previewFetching && !status.Stage.IsTerminal() && status.Stage != JobStage.Uploaded)
        {
            _previewFetching = true;
            try
            {
                _preview = await Analysis.GetPreviewAsync(status.JobId);
            }
            finally
            {
                _previewFetching = false;
            }
        }

        if (status.Stage == JobStage.Complete && _visual is null)
        {
            _result = await Analysis.GetResultAsync(status.JobId);
            _visual = await Analysis.GetVisualAsync(status.JobId);
            if (MockDataState.PlanContainsFakeExecutor(status.Plan))
            {
                MockData.SetMock();
            }
            else
            {
                MockData.SetLive();
            }
            if (_result is not null)
            {
                Notifications.Notify(NotificationSeverity.Success, "Song analyzed",
                    $"{_result.TonicName} {_result.PrimaryMode?.ToString() ?? ""} · {_result.TempoBpm:0} BPM");
                // Tint the chrome with the detected key, then play its tonic (no third — the
                // arpeggio stays mode-neutral, so no musical decision happens client-side).
                _themeJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/theme.js");
                await _themeJs.InvokeVoidAsync("setKeyHue", _result.TonicPitchClass * 30);
                await PlaySfxAsync("fanfare", 48 + _result.TonicPitchClass);
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OnUploadError(UploadErrorEventArgs args)
    {
        _uploading = false;
        _uploadError = string.IsNullOrWhiteSpace(args.Message) ? "Upload failed." : args.Message;
        Notifications.Notify(NotificationSeverity.Error, "Upload failed", _uploadError);
    }

    public async ValueTask DisposeAsync()
    {
        ViewState.Changed -= OnViewStateChanged;
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
        if (_pitchWorker is not null)
        {
            await _pitchWorker.DisposeAsync();
        }
        if (_recorder is not null)
        {
            await _recorder.DisposeAsync();
        }
        if (_shareCard is not null)
        {
            await _shareCard.DisposeAsync();
        }
        if (_sfx is not null)
        {
            await _sfx.DisposeAsync();
        }
        if (_themeJs is not null)
        {
            await _themeJs.DisposeAsync();
        }
        if (_landscape is not null)
        {
            await _landscape.DisposeAsync();
        }
    }
}
