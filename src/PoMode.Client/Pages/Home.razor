@page "/"
@page "/library"
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@using PoMode.Shared.Analysis
@inject AnalysisClient Analysis
@inject MockDataState MockData
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject IJSRuntime JS
@inject BrowserPrefs Prefs
@implements IAsyncDisposable

<PageTitle>PoMode</PageTitle>

@* One analysis view, not two.

   This page used to render a "Basic" and an "Advanced" arrangement of the same job behind a header
   switcher, which meant every result had two layouts, two mixers and two stats panels to keep
   truthful. The kept view is the compact one: key and mode, the piano roll with the selected window
   read out under it, the player, and the statistics. *@

@* Drawn once the demo pointer and the model choosers are known: the card is centred, so a row
   arriving after it moved the whole card. Both are local reads, a fraction of a second. *@
@if (_intakeReady && _visual is null && _status is null)
{
    <div class="intake">
        <RadzenCard class="intake-card">
            @* Two ways in: drop a file, or sing into the microphone. (A third arrives on its own — an
               Android share sheet POSTs to /share-target and the service worker hands the bytes over.) *@
            <div class="upload-hero">
                <RadzenIcon Icon="graphic_eq" class="upload-hero-icon" />
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H1" Text="Drop a track, get the theory" />
                <RadzenText class="upload-hero-sub" Text=".mp3, .wav or .m4a · up to 100 MB" />
                @* A plain file input dressed as a Radzen button rather than RadzenUpload: RadzenUpload
                   POSTs the file itself in one request, and the point here is that the bytes go over tus
                   (js/upload/resumable-upload.js) so a dropped connection resumes instead of restarting.
                   The input covers the button, so a click or a dropped file both land on it. Recording sits
                   beside it: both ways in on one row. *@
                <div class="intake-actions">
                    @* A beat is not a song: it is not here to be read for its mode but to be cut to a
                       tempo, so it uploads the same way and then opens in the Mode Lab, under its chords, instead of on
                       the analysis page. *@
                    <label class="rz-button rz-button-md rz-variant-filled rz-light rz-shade-default upload-choose"
                           title="A drum beat recorded without a click: it opens in the Mode Lab, cut to a loop at the lab's tempo and played with the chords">
                        <RadzenIcon Icon="album" />
                        <span>Choose a beat</span>
                        <input type="file" class="beat-input" accept="audio/*,.mp3,.wav,.m4a"
                               aria-label="Choose a beat" disabled="@_uploading"
                               @ref="_beatInput" @onchange="OnBeatChosenAsync" />
                    </label>
                    @if (!_recording)
                    {
                        <RadzenButton Text="Record a beat" Icon="graphic_eq" ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => OnStartRecording(beat: true))" Disabled="@_uploading" id="record-beat"
                                      title="Tap or play a beat into the microphone, no click needed: it opens in the Mode Lab, cut to a loop at 120 BPM that you can change" />
                    }
                    <label class="rz-button rz-button-md rz-variant-filled rz-primary rz-shade-default upload-choose"
                           data-upload-state="@(_uploading ? (_uploadResuming ? "resuming" : "uploading") : "idle")">
                        <RadzenIcon Icon="upload_file" />
                        <span>Choose a song</span>
                        <input type="file" class="upload-input" accept="audio/*,.mp3,.wav,.m4a"
                               aria-label="Choose a song" disabled="@_uploading"
                               @ref="_fileInput" @onchange="OnFileChosenAsync" />
                    </label>
                    @if (!_recording)
                    {
                        <RadzenButton Text="Record a song" Icon="mic" ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => OnStartRecording(beat: false))" Disabled="@_uploading" id="record-song"
                                      title="Record from your microphone and analyze it" />
                    }
                    else
                    {
                        @* One microphone, so one Stop: it says where the take is going. *@
                        <RadzenButton Text="@(_recordingBeat ? "Stop and open in Mode Lab" : "Stop and analyze")" Icon="stop"
                                      ButtonStyle="ButtonStyle.Danger" Click="@OnStopRecording" id="record-stop" />
                        <RadzenText class="recording-hint" role="status"
                                    Text="@(_recordingBeat ? "Recording a beat…" : "Recording a song…")" />
                    }
                </div>
                @if (_recordError is not null)
                {
                    <RadzenText class="upload-error" Text="@_recordError" />
                }

                @* First run: a finished analysis is one click away, so the canvas, mixer and stats can be
                   seen in seconds instead of after a multi-minute first upload. Only while the demo is all
                   the library holds — once the user has songs of their own, the Library still lists it. *@
                @if (_demo is { Origin: { } demoOrigin } demo)
                {
                    <div class="demo-pointer" data-demo-job="@demo.JobId">
                        <RadzenButton Text="See a finished example" Icon="play_circle" ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => OpenDemoAsync(demo.JobId))" />
                        <RadzenText class="demo-pointer-sub" Text="@demoOrigin.Description" />
                    </div>
                }

                @if (_executorChoices.Count > 0)
                {
                    @* The models are picked on the Settings page; a pinned one is named here so an
                       upload never runs on a choice the person has forgotten making. *@
                    <a class="executor-pins" href="settings">@_executorChoices.Count analysis @(_executorChoices.Count == 1 ? "model" : "models") pinned · change</a>
                }
                @if (_uploading)
                {
                    <div class="upload-progress">
                        <RadzenProgressBar Value="@_uploadPercent" ShowValue="false" />
                        <RadzenText class="upload-progress-text" Text="@UploadProgressText" />
                    </div>
                }
                @if (_uploadError is not null)
                {
                    <RadzenText class="upload-error" Text="@_uploadError" role="alert" />
                }
            </div>
            @* Machine-readable probe result: browser tests wait for it before uploading, so a capability
               declaration can never race the probe. "none" = probed, nothing usable; empty = still probing. *@
            <span class="client-capability" hidden data-capability="@(_probed ? _clientCapability ?? "none" : "")"></span>
        </RadzenCard>
        @* The same page lists what is already here: adding a song and finding one again are one
           job, so the songs sit under the ways to add one rather than on a page of their own. *@
        <LibraryList />
    </div>
}

@* Where this audio came from, when the server knows. A hum take is a melody the user sang over a
   progression this app chose for them, and the mode below is a fact about that melody — without the
   provenance the page reports a mode on an unexplained file. The demo says it was synthesized. *@
@if (_visual is null && _status?.Origin is { } origin)
{
    <div class="take-origin" role="note" data-take-origin="@origin.Kind">
        <span class="take-origin-icon" aria-hidden="true">@(origin.Kind == TakeOrigin.Demo ? "🎹" : "🎤")</span>
        <span class="take-origin-text">@origin.Description</span>
    </div>
}

@if (_status is not null && (_status.Stage != JobStage.Complete || _visual is null))
{
    <JobProgress Status="_status" OnCancel="@CancelJobAsync" QueueAhead="_queueAhead" />
    @if (_status.Stage is JobStage.Failed or JobStage.Cancelled)
    {
        @* The intake card only shows with no job; without this a failed or cancelled job is a dead end. *@
        <div class="analyze-another">
            <RadzenButton Text="Analyze another file" Icon="upload_file" ButtonStyle="ButtonStyle.Primary"
                          Click="@ResetForNewUpload" />
        </div>
    }
    @if (_preview is { } preview && preview.Confidence > 0 && !_status.Stage.IsTerminal())
    {
        <RadzenText class="preview-line"
                    Text="@($"First look: likely {preview.TonicName}, ~{preview.TempoBpm:0} BPM — the full analysis is refining this…")" />
    }
    @if (_status.Stage == JobStage.Complete && _visual is null)
    {
        <RadzenCard aria-hidden="true">
            <div class="pm-skeleton results-skeleton"></div>
        </RadzenCard>
    }
}

@if (_visual is not null && _result is not null && _status is not null)
{
    <BasicView Status="_status" Result="_result" Visual="_visual"
               SelectedWindowIndex="_selectedWindow" PlayheadSec="_playheadSec"
               OnSeek="OnSeek"
               OnAnalyzeNew="@ResetForNewUpload"
               OnRerun="@TrackJobAsync" />
}

@code {
    /// <summary>Set by the library's Open link (/?job=…): load that job instead of waiting for an upload.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "job")]
    public string? Job { get; set; }

    /// <summary>Set by the service worker after another app shared audio into PoMode (/?shared=1).
    /// The file itself is waiting in a cache the worker wrote it to; see js/pwa.js.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "shared")]
    public string? Shared { get; set; }

    private void ResetForNewUpload()
    {
        ClearJob();
        Navigation.NavigateTo("/");
    }

    private void ClearJob()
    {
        _status = null;
        _visual = null;
        _result = null;
        _selectedWindow = null;
        _playheadSec = 0;
        _preview = null;
    }

    private JobStatusDto? _status;
    private VisualizationPayload? _visual;
    private ModalResult? _result;
    private string? _uploadError;
    private bool _uploading;
    private bool _uploadResuming;
    private ElementReference _fileInput;
    private ElementReference _beatInput;
    private IJSObjectReference? _uploader;
    private DotNetObjectReference<Home>? _self;
    private int _uploadPercent;
    private long _uploadLoaded;
    private long _uploadTotal;
    private HubConnection? _hub;

    /// <summary>Jobs that will run before the tracked one, while it waits; pushed by the hub.</summary>
    private int? _queueAhead;
    private int? _selectedWindow;
    private double _playheadSec;
    private IJSObjectReference? _pitchWorker;
    private IJSObjectReference? _separation;
    private IJSObjectReference? _recorder;
    private IJSObjectReference? _sfx;
    private IJSObjectReference? _themeJs;
    private AnalysisPreviewDto? _preview;
    private bool _previewFetching;
    private string? _clientCapability;
    private bool _probed;
    private bool _recording;
    private string? _recordError;

    /// <summary>Jobs already handed to the browser for Tier-2 inference, so a repeated status push
    /// cannot start the work twice.</summary>
    private readonly HashSet<string> _delegatedJobs = [];

    private readonly Dictionary<string, string> _executorChoices = [];

    private bool _intakeReady;

    /// <summary>The library's demo row, when it is the only row: what the empty state points at.</summary>
    private LibraryEntryDto? _demo;

    /// <summary>
    /// Reads the library for its demo row. The read is also what seeds a new user's demo on the server,
    /// so a first visit that lands here rather than on the Library still gets one. Best-effort: with no
    /// demo the intake card is simply what it always was.
    /// </summary>
    private async Task LoadDemoAsync()
    {
        try
        {
            if (await Analysis.GetLibraryAsync() is [{ Origin.Kind: TakeOrigin.Demo, Stage: JobStage.Complete } only])
            {
                _demo = only;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException)
        {
            // Same wide filter as the choosers: a missing pointer must never fault the home page.
        }
    }

    private async Task OpenDemoAsync(string jobId)
    {
        try
        {
            if (await Analysis.GetStatusAsync(jobId) is { } status)
            {
                await TrackJobAsync(status);
            }
        }
        catch (HttpRequestException)
        {
            // Swept since the page loaded: drop the pointer rather than offer a dead button.
            _demo = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // The choosers' data loads concurrently with the job-resume path; they pop in when ready.
        var executorsTask = LoadExecutorsAsync();
        var demoTask = string.IsNullOrWhiteSpace(Job) ? LoadDemoAsync() : Task.CompletedTask;
        if (!string.IsNullOrWhiteSpace(Job))
        {
            try
            {
                if (await Analysis.GetStatusAsync(Job) is { } status)
                {
                    await TrackJobAsync(status);
                }
            }
            catch (HttpRequestException)
            {
                // A stale or mistyped link: the page simply starts empty, same as no query at all.
            }
        }
        await Task.WhenAll(executorsTask, demoTask);
        _intakeReady = true;
    }

    /// <summary>
    /// The URL is the job (TrackJobAsync writes it), so a later change to it is a navigation to follow:
    /// Back from a job to the bare page, the header's Analyze link, or a push link opened in this tab.
    /// Home is reused across all of them, so OnInitializedAsync never sees these.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Job))
        {
            if (_status is not null)
            {
                ClearJob();
            }
            return;
        }
        if (Job == _status?.JobId)
        {
            return;
        }
        try
        {
            if (await Analysis.GetStatusAsync(Job) is { } status)
            {
                await TrackJobAsync(status);
            }
        }
        catch (HttpRequestException)
        {
            // Same as a stale link on first load: the page stays as it is.
        }
    }

    private async Task LoadExecutorsAsync()
    {
        try
        {
            // Only the pins are needed here: the choosers themselves are on the Settings page.
            foreach (var (stage, name) in await ExecutorChoices.LoadAsync(Prefs, await Analysis.GetExecutorsAsync()))
            {
                _executorChoices[stage] = name;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException)
        {
            // No choosers, no problem: uploads simply use the server's ranked defaults. The wide
            // filter matters — a proxy serving HTML with a 200 throws JsonException, and that
            // must degrade the choosers, not fault the whole home page.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        _pitchWorker = await JS.InvokeAsync<IJSObjectReference>("import", "./js/infer/pitch-worker.js");
        _separation = await JS.InvokeAsync<IJSObjectReference>("import", "./js/infer/separation.js");
        _clientCapability = await _pitchWorker.InvokeAsync<string?>("probeCapability");
        _probed = true;
        StateHasChanged();
        // After the probe, not before: a shared file should get the same browser-tier treatment
        // as one dropped on the page, and that is only known once the capability is in.
        await TakeSharedFileAsync();
        await ResumeUnsentAsync();
    }

    /// <summary>A recording or shared file whose upload an earlier visit never finished: the uploader
    /// kept it, and it carries on from the byte the server last confirmed. Only on an idle page; a job
    /// being opened or an upload already running is what the person came for.</summary>
    private async Task ResumeUnsentAsync()
    {
        if (_status is not null || _uploading || Job is { Length: > 0 })
        {
            return;
        }
        try
        {
            _uploader ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/upload/resumable-upload.js");
            if (await _uploader.InvokeAsync<string?>("unsentName") is { Length: > 0 } name)
            {
                // A beat left unsent is still a beat: it carries on into the Mode Lab, not an analysis.
                var asBeat = await _uploader.InvokeAsync<bool>("unsentIsBeat");
                await using var file = await _uploader.InvokeAsync<IJSObjectReference>("takeUnsent");
                await UploadAndAnalyzeAsync(file, name, asBeat);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            // Nothing kept, or nothing readable: the page is simply idle.
        }
    }

    /// <summary>Fire-and-forget UI sound; any failure (autoplay policy, torn-down circuit) is silent.</summary>
    private async Task PlaySfxAsync(string name, params object?[] args)
    {
        try
        {
            _sfx ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/sfx.js");
            await _sfx.InvokeVoidAsync(name, args);
        }
        catch (JSException)
        {
            // Sounds are garnish, never an error.
        }
    }

    /// <summary>Canvas click. The window lookup is a plain time-range search, not analysis — the
    /// musical decisions all happened server-side in VisualizationBuilder.</summary>
    private void OnSeek(double seconds)
    {
        _playheadSec = seconds;
        _selectedWindow = _result?.WindowIndexAt(seconds);
    }

    private string UploadProgressText
        => _uploadResuming
            ? $"Connection lost — resuming… {_uploadPercent}% ({_uploadLoaded / 1048576.0:0.0} of {_uploadTotal / 1048576.0:0.0} MB)"
            : _uploadPercent >= 100 ? "Upload sent — waiting for the server…"
            : _uploadTotal > 0
                ? $"Uploading… {_uploadPercent}% ({_uploadLoaded / 1048576.0:0.0} of {_uploadTotal / 1048576.0:0.0} MB)"
                : $"Uploading… {_uploadPercent}%";

    /// <summary>Called by resumable-upload.js at most once per whole percent, and whenever the upload
    /// starts or stops recovering from a dropped connection.</summary>
    [JSInvokable]
    public Task OnUploadProgress(long sent, long total, bool resuming)
    {
        _uploadLoaded = sent;
        _uploadTotal = total;
        _uploadPercent = total > 0 ? (int)(sent * 100 / total) : 0;
        _uploadResuming = resuming;
        return InvokeAsync(StateHasChanged);
    }

    private Task OnFileChosenAsync() => UploadAndAnalyzeAsync(_fileInput, name: null);

    private Task OnBeatChosenAsync() => UploadAndAnalyzeAsync(_beatInput, name: null, asBeat: true);

    /// <summary>
    /// Every intake path's one route to a job: the bytes go over tus, then the finished upload is
    /// handed to the analyzer with this browser's capability and model picks. <paramref name="source"/>
    /// is whatever resumable-upload.js accepts — the file input, a Blob reference, or a recording's
    /// bytes. Returns false when nothing was started, with the reason in <c>_uploadError</c>.
    /// A beat takes the same route in, because the Mode Lab fetches it back out of the library, but is
    /// only kept, never analysed, and goes straight there.
    /// </summary>
    private async Task<bool> UploadAndAnalyzeAsync(object source, string? name, bool asBeat = false)
    {
        _uploading = true;
        _uploadResuming = false;
        _uploadError = null;
        _uploadPercent = 0;
        _uploadLoaded = 0;
        _uploadTotal = 0;
        StateHasChanged();
        try
        {
            _uploader ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/upload/resumable-upload.js");
            _self ??= DotNetObjectReference.Create(this);
            var uploadId = await _uploader.InvokeAsync<string>("upload", source, name, _self, asBeat);
            var (status, error) = await Analysis.StartFromUploadAsync(
                uploadId, _clientCapability is not null, _executorChoices, asBeat);
            if (status is null)
            {
                return Refused(error ?? "The analyzer would not accept the file.");
            }
            _uploading = false;
            await PlaySfxAsync("chime");
            if (asBeat)
            {
                Navigation.NavigateTo($"modes?beat={Uri.EscapeDataString(status.JobId)}");
                return true;
            }
            await TrackJobAsync(status);
            return true;
        }
        catch (JSException ex)
        {
            // resumable-upload.js rejects with a sentence written to be shown as it is; interop
            // appends the JS stack after the first line.
            return Refused(ex.Message.Split('\n')[0]);
        }
        catch (HttpRequestException)
        {
            return Refused("The server could not be reached. Please try again.");
        }
        finally
        {
            _uploading = false;
            _uploadResuming = false;
        }
    }

    private bool Refused(string reason)
    {
        _uploadError = reason;
        Notifications.Notify(NotificationSeverity.Error, "Upload failed", reason);
        return false;
    }

    private async Task CancelJobAsync()
    {
        if (_status is null)
        {
            return;
        }
        await Analysis.CancelAsync(_status.JobId);
        Notifications.Notify(NotificationSeverity.Info, "Cancel requested",
            "The job stops at the next safe point.");
    }

    /// <summary>Which of the two recordings is running: a beat goes to the Mode Lab, a song is analysed.</summary>
    private bool _recordingBeat;

    private async Task OnStartRecording(bool beat)
    {
        _recordError = null;
        _recordingBeat = beat;
        try
        {
            _recorder ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/capture/audio-recorder.js");
            await _recorder.InvokeVoidAsync("startRecording");
            _recording = true;
        }
        catch (JSException)
        {
            _recordError = "Microphone access was denied or is unavailable.";
        }
    }

    private async Task OnStopRecording()
    {
        if (_recorder is null)
        {
            return;
        }
        _recording = false;
        await _recorder.InvokeVoidAsync("stopRecording");
        var wavBytes = await _recorder.InvokeAsync<byte[]>("getRecordedWavBytes");
        if (wavBytes.Length <= 44) // header-only WAV: nothing was captured
        {
            _recordError = "Nothing was recorded.";
            return;
        }
        await UploadAndAnalyzeAsync(wavBytes, _recordingBeat ? "beat.wav" : "recording.wav", asBeat: _recordingBeat);
    }

    /// <summary>
    /// Picks up audio another app shared into PoMode and analyses it like any other upload.
    ///
    /// <para>Android's share sheet POSTs the file to <c>/share-target</c>, which the service worker
    /// answers by stashing the bytes and redirecting here. That indirection exists because a POST
    /// cannot be handed to a single-page app as a navigation — the page has to come and fetch what
    /// was shared once it is running.</para>
    /// </summary>
    private async Task TakeSharedFileAsync()
    {
        if (Shared != "1")
        {
            return;
        }
        // Cleared immediately so a refresh cannot look for a file that has already been claimed.
        Navigation.NavigateTo("/", replace: true);

        try
        {
            await using var pwa = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/pwa.js");
            if (await pwa.InvokeAsync<string?>("takeSharedName") is not { Length: > 0 } name)
            {
                return;
            }
            // A reference, not the bytes: the Blob goes from pwa.js to the uploader without a 40 MB
            // detour through .NET memory.
            await using var file = await pwa.InvokeAsync<IJSObjectReference>("takeSharedFile");
            await UploadAndAnalyzeAsync(file, name);
        }
        catch (JSDisconnectedException)
        {
            // Navigated away before the handoff finished.
        }
        catch (Exception ex)
        {
            _uploadError = ex.Message;
        }
    }

    /// <summary>Shared by every intake path (upload, recording, share target): reset the result
    /// panels, connect the hub once, subscribe to the job, and reconcile against the current
    /// status.</summary>
    private async Task TrackJobAsync(JobStatusDto status)
    {
        _visual = null;
        _result = null;
        _selectedWindow = null;
        _playheadSec = 0;
        _preview = null;
        _queueAhead = null;
        _status = status;
        // Put the job in the address bar: an analysis runs for minutes, and a reload, a phone that
        // discarded the tab or a copied link must come back to it rather than to an empty intake.
        if (Job != status.JobId)
        {
            Navigation.NavigateTo($"/?job={status.JobId}");
        }

        if (_hub is null)
        {
            // Progress is pushed, never polled, so a dropped socket (a phone waking, a network blip)
            // would otherwise freeze the progress bar for the rest of the job.
            _hub = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/analysis"))
                .WithAutomaticReconnect()
                .Build();
            _hub.On<JobStatusDto>("JobStatusChanged", OnStatusChanged); // register once, not per upload
            _hub.On<string, int>("QueuePosition", (jobId, ahead) =>
            {
                if (_status?.JobId == jobId)
                {
                    _queueAhead = ahead;
                    InvokeAsync(StateHasChanged);
                }
            });
            _hub.Reconnected += _ => _status is { } tracked ? SubscribeAndReconcileAsync(tracked.JobId) : Task.CompletedTask;
        }
        if (_hub.State == HubConnectionState.Disconnected)
        {
            await _hub.StartAsync();
        }
        await SubscribeAndReconcileAsync(status.JobId);
    }

    /// <summary>A new connection is in no groups, and pushes sent while it was down are gone: subscribe,
    /// then read the status once. That one read also covers a fast job finishing before Subscribe lands.</summary>
    private async Task SubscribeAndReconcileAsync(string jobId)
    {
        await _hub!.InvokeAsync("Subscribe", jobId);
        var current = await Analysis.GetStatusAsync(jobId);
        if (current is not null)
        {
            await OnStatusChanged(current);
        }
    }

    private async Task OnStatusChanged(JobStatusDto status)
    {
        if (_status?.JobId != status.JobId)
        {
            return;
        }
        _status = status;
        // One announcement serves both browser stages; which one is waiting follows from whether
        // separation has finished. Keyed by stage, so a job that delegates both runs both.
        var separating = !status.CompletedStages.Contains(StageNames.Separating);
        if (status.Stage == JobStage.AwaitingClient
            && (separating ? _separation : _pitchWorker) is { } module
            && _delegatedJobs.Add($"{status.JobId}:{(separating ? StageNames.Separating : StageNames.PitchTracking)}"))
        {
            // Fire and forget: the modules swallow their own failures, and the server's Tier2 timeout
            // (or the module's decline) falls through to the next tier.
            _ = module.InvokeVoidAsync("runDelegated", status.JobId);
        }
        // The fast first-look preview: worth one fetch per push until it appears, while running.
        if (_preview is null && !_previewFetching && !status.Stage.IsTerminal() && status.Stage != JobStage.Uploaded)
        {
            _previewFetching = true;
            try
            {
                _preview = await Analysis.GetPreviewAsync(status.JobId);
            }
            finally
            {
                _previewFetching = false;
            }
        }

        if (status.Stage == JobStage.Complete && _visual is null)
        {
            _result = await Analysis.GetResultAsync(status.JobId);
            _visual = await Analysis.GetVisualAsync(status.JobId);
            if (MockDataState.PlanContainsFakeExecutor(status.Plan))
            {
                MockData.SetMock();
            }
            else
            {
                MockData.SetLive();
            }
            if (_result is not null)
            {
                // No "Song analyzed" toast: it fired on every finished job opened, not just one that
                // finished while watched, covered the key badge on a phone, and said what that badge
                // says. The result arriving is the notice, and a closed tab gets a Web Push.
                // Tint the chrome with the detected key, then play its tonic (no third — the
                // arpeggio stays mode-neutral, so no musical decision happens client-side).
                _themeJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/shell/theme.js");
                await _themeJs.InvokeVoidAsync("setKeyHue", _result.TonicPitchClass * 30);
                // And hand the interface its voice: from here the clicks and chimes are sounded from
                // the mode's own scale. The pitches are derived here, from the shared ScaleModes
                // table the server graded with, rather than in the browser — sfx.js is given notes
                // to play and never a mode to interpret.
                await PlaySfxAsync("setPalette", _result.EarconPitches());
                await PlaySfxAsync("fanfare", 48 + _result.TonicPitchClass);
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_uploader is not null)
        {
            await _uploader.DisposeAsync();
        }
        _self?.Dispose();
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
        if (_pitchWorker is not null)
        {
            await _pitchWorker.DisposeAsync();
        }
        if (_separation is not null)
        {
            await _separation.DisposeAsync();
        }
        if (_recorder is not null)
        {
            if (_recording)
            {
                // Leaving mid-recording: without this the mic stays live (and its indicator lit) after
                // the page is gone, still buffering audio nobody will ever upload.
                try
                {
                    await _recorder.InvokeVoidAsync("stopRecording");
                }
                catch (JSException)
                {
                }
            }
            await _recorder.DisposeAsync();
        }
        if (_sfx is not null)
        {
            // Back to the keyless defaults on the way out. Leaving the palette set would have the
            // Library and Practice pages clicking in the key of whatever was last analyzed, which
            // is a claim about music that is not on screen.
            try
            {
                await _sfx.InvokeVoidAsync("setPalette", (int[]?)null);
            }
            catch (JSException)
            {
                // Already torn down; nothing is listening either way.
            }
            await _sfx.DisposeAsync();
        }
        if (_themeJs is not null)
        {
            await _themeJs.DisposeAsync();
        }
    }
}
