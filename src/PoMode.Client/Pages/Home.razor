@page "/"
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@using PoMode.Shared.Analysis
@inject AnalysisClient Analysis
@inject MockDataState MockData
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PoMode</PageTitle>

<RadzenCard>
    <RadzenText TextStyle="TextStyle.H5" Text="Audio Modal Analyzer" />
    <RadzenTabs>
        <Tabs>
            <RadzenTabsItem Text="Upload">
                <RadzenText Text="Upload an .mp3 or .wav track (max 100 MB) to analyze its melody, chords, and scale modes." />
                <RadzenUpload Url="@UploadUrl" Accept=".mp3,.wav" Auto="true"
                              Progress="@OnUploadProgress"
                              Complete="@OnUploadComplete" Error="@OnUploadError" ChooseText="Choose audio file" />
                @if (_uploading)
                {
                    <div class="upload-progress">
                        <RadzenProgressBar Value="@_uploadPercent" ShowValue="false" />
                        <RadzenText class="upload-progress-text" Text="@UploadProgressText" />
                    </div>
                }
                @if (_uploadError is not null)
                {
                    <RadzenText class="upload-error" Text="@_uploadError" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="From URL">
                <RadzenText Text="Paste a page URL (YouTube, SoundCloud, …). The server fetches the audio with yt-dlp." />
                <div class="url-row">
                    <RadzenTextBox @bind-Value="_url" Placeholder="https://…" Disabled="@_fetchingUrl" />
                    <RadzenButton Text="@(_fetchingUrl ? "Fetching…" : "Analyze")" Click="@OnAnalyzeUrl"
                                  Disabled="@_fetchingUrl" ButtonStyle="ButtonStyle.Primary" />
                </div>
                @if (_urlError is not null)
                {
                    <RadzenText class="upload-error" Text="@_urlError" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="Record">
                <RadzenText Text="Record from your microphone, then analyze the recording like an upload." />
                <div class="record-row">
                    @if (!_recording)
                    {
                        <RadzenButton Text="Start recording" Click="@OnStartRecording" ButtonStyle="ButtonStyle.Primary" />
                    }
                    else
                    {
                        <RadzenButton Text="Stop and analyze" Click="@OnStopRecording" ButtonStyle="ButtonStyle.Danger" />
                        <RadzenText class="recording-hint" Text="Recording…" />
                    }
                </div>
                @if (_recordError is not null)
                {
                    <RadzenText class="upload-error" Text="@_recordError" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="Batch">
                <BatchPanel />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
    @* Machine-readable probe result: browser tests wait for it before uploading, so a capability
       declaration can never race the probe. "none" = probed, nothing usable; empty = still probing. *@
    <span class="client-capability" hidden data-capability="@(_probed ? _clientCapability ?? "none" : "")"></span>
</RadzenCard>

@if (_status is not null)
{
    <JobProgress Status="_status" />
    <RadzenButton class="debug-toggle" Text="@(_showDebug ? "Hide debug" : "Show debug")"
                  Click="@(() => _showDebug = !_showDebug)" ButtonStyle="ButtonStyle.Light" />
    @if (_showDebug)
    {
        <DebugPanel Status="_status" />
    }
}

@if (_visual is not null)
{
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H6" Text="@($"{_visual.Notes.Count} notes · {_visual.Chords.Count} chords")" />
        <AnalysisCanvas Model="_visual" SelectedWindowIndex="_selectedWindow"
                        PlayheadSec="_playheadSec" OnSeek="OnSeek"
                        OnReady="@(element => _canvasElement = element)" />
        @if (_canvasElement is { } canvasElement)
        {
            <StemMixer JobId="@_status!.JobId" CanvasElement="canvasElement" SeekToSec="_playheadSec" />
        }
    </RadzenCard>
}

@if (_result is not null && _visual is not null)
{
    <ModalHud Result="_result" Windows="_visual.Windows" SelectedWindowIndex="_selectedWindow"
              JobId="@_status!.JobId" />
    <div class="export-links">
        <RadzenLink Path="@($"api/analysis/{_status!.JobId}/midi")" Text="Download MIDI" Target="_blank" />
        <RadzenLink Path="@($"api/analysis/{_status!.JobId}/musicxml")" Text="Download MusicXML" Target="_blank" />
    </div>
}

@code {
    private static readonly JsonSerializerOptions WebJson = new(JsonSerializerDefaults.Web);

    private JobStatusDto? _status;
    private VisualizationPayload? _visual;
    private ModalResult? _result;
    private string? _uploadError;
    private bool _uploading;
    private int _uploadPercent;
    private long _uploadLoaded;
    private long _uploadTotal;
    private HubConnection? _hub;
    private int? _selectedWindow;
    private double _playheadSec;
    private ElementReference? _canvasElement;
    private IJSObjectReference? _pitchWorker;
    private IJSObjectReference? _recorder;
    private string? _clientCapability;
    private bool _probed;
    private bool _showDebug;
    private string _url = "";
    private bool _fetchingUrl;
    private string? _urlError;
    private bool _recording;
    private string? _recordError;
    private readonly HashSet<string> _delegatedJobs = [];

    /// <summary>
    /// Tier 2 availability is a per-job property of this browser (spec §4), declared at upload time
    /// so the server can plan the ClientDelegated tier. Until the probe has answered, uploads
    /// declare nothing and the plan is exactly what it always was.
    /// </summary>
    private string UploadUrl => _clientCapability is null ? "api/analysis" : "api/analysis?clientCanInfer=true";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        _pitchWorker = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pitch-worker.js");
        _clientCapability = await _pitchWorker.InvokeAsync<string?>("probeCapability");
        _probed = true;
        StateHasChanged();
    }

    /// <summary>Canvas click. The window scan is a plain time-range lookup, not analysis — the
    /// musical decisions all happened server-side in VisualizationBuilder.</summary>
    private void OnSeek(double seconds)
    {
        _playheadSec = seconds;
        _selectedWindow = null;
        if (_result is null)
        {
            return;
        }
        for (var index = 0; index < _result.Windows.Count; index++)
        {
            var window = _result.Windows[index];
            if (seconds >= window.StartSec && seconds < window.EndSec)
            {
                _selectedWindow = index;
                return;
            }
        }
    }

    private string UploadProgressText
        => _uploadPercent >= 100 ? "Upload sent — waiting for the server…"
            : _uploadTotal > 0
                ? $"Uploading… {_uploadPercent}% ({_uploadLoaded / 1048576.0:0.0} of {_uploadTotal / 1048576.0:0.0} MB)"
                : $"Uploading… {_uploadPercent}%";

    private void OnUploadProgress(UploadProgressArgs args)
    {
        _uploading = true;
        _uploadPercent = args.Progress;
        _uploadLoaded = args.Loaded;
        _uploadTotal = args.Total;
    }

    private async Task OnUploadComplete(UploadCompleteEventArgs args)
    {
        _uploading = false;
        _uploadError = null;
        if (args.RawResponse is not { } rawResponse
            || JsonSerializer.Deserialize<JobStatusDto>(rawResponse, WebJson) is not { } status)
        {
            _uploadError = "Unexpected server response.";
            return;
        }
        await TrackJobAsync(status);
    }

    private async Task OnAnalyzeUrl()
    {
        if (string.IsNullOrWhiteSpace(_url))
        {
            return;
        }
        _urlError = null;
        _fetchingUrl = true;
        try
        {
            var (status, error) = await Analysis.AnalyzeFromUrlAsync(_url.Trim());
            if (status is null)
            {
                _urlError = error ?? "Could not fetch that URL.";
                return;
            }
            await TrackJobAsync(status);
        }
        finally
        {
            _fetchingUrl = false;
        }
    }

    private async Task OnStartRecording()
    {
        _recordError = null;
        try
        {
            _recorder ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/audio-recorder.js");
            await _recorder.InvokeVoidAsync("startRecording");
            _recording = true;
        }
        catch (JSException)
        {
            _recordError = "Microphone access was denied or is unavailable.";
        }
    }

    private async Task OnStopRecording()
    {
        if (_recorder is null)
        {
            return;
        }
        _recording = false;
        await _recorder.InvokeVoidAsync("stopRecording");
        var wavBytes = await _recorder.InvokeAsync<byte[]>("getRecordedWavBytes");
        if (wavBytes.Length <= 44) // header-only WAV: nothing was captured
        {
            _recordError = "Nothing was recorded.";
            return;
        }
        var status = await Analysis.UploadAsync(wavBytes, "recording.wav", _clientCapability is not null);
        if (status is null)
        {
            _recordError = "The recording upload failed.";
            return;
        }
        await TrackJobAsync(status);
    }

    /// <summary>Shared by every intake path (upload, URL, recording): reset the result panels,
    /// connect the hub once, subscribe to the job, and reconcile against the current status.</summary>
    private async Task TrackJobAsync(JobStatusDto status)
    {
        _visual = null;
        _result = null;
        _selectedWindow = null;
        _playheadSec = 0;
        // Clearing _visual removes the canvas, so the next analysis builds a fresh one. Drop the old
        // element too, or the mixer would initialise against a canvas that no longer exists.
        _canvasElement = null;
        _status = status;

        if (_hub is null)
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/analysis"))
                .Build();
            _hub.On<JobStatusDto>("JobStatusChanged", OnStatusChanged); // register once, not per upload
        }
        if (_hub.State == HubConnectionState.Disconnected)
        {
            await _hub.StartAsync();
        }
        await _hub.InvokeAsync("Subscribe", status.JobId);

        // The fake pipeline can finish before Subscribe lands — reconcile once.
        var current = await Analysis.GetStatusAsync(status.JobId);
        if (current is not null)
        {
            await OnStatusChanged(current);
        }
    }

    private async Task OnStatusChanged(JobStatusDto status)
    {
        if (_status?.JobId != status.JobId)
        {
            return;
        }
        _status = status;
        if (status.Stage == JobStage.AwaitingClient
            && _pitchWorker is not null
            && _delegatedJobs.Add(status.JobId))
        {
            // Fire and forget: the module swallows its own failures, and the server's Tier2 timeout
            // falls through to the next tier if this browser never posts a result.
            _ = _pitchWorker.InvokeVoidAsync("runDelegated", status.JobId);
        }
        if (status.Stage == JobStage.Complete && _visual is null)
        {
            _result = await Analysis.GetResultAsync(status.JobId);
            _visual = await Analysis.GetVisualAsync(status.JobId);
            if (MockDataState.PlanContainsFakeExecutor(status.Plan))
            {
                MockData.SetMock();
            }
            else
            {
                MockData.SetLive();
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OnUploadError(UploadErrorEventArgs args)
    {
        _uploading = false;
        _uploadError = string.IsNullOrWhiteSpace(args.Message) ? "Upload failed." : args.Message;
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
        if (_pitchWorker is not null)
        {
            await _pitchWorker.DisposeAsync();
        }
        if (_recorder is not null)
        {
            await _recorder.DisposeAsync();
        }
    }
}
