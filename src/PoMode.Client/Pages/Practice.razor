@page "/practice"
@using PoMode.Shared.Analysis
@using PoMode.Client.Services
@inject AnalysisClient Analysis
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PoMode</PageTitle>

@* Ear training on the modes. The server issues the phrase and grades the attempt; this page only
   collects settings, drives the microphone, and places the numbers it is handed. Every sentence
   shown here — the instruction, the verdict, the advice — is written server-side, the same rule the
   canvas and the mixer follow. *@

<RadzenCard class="practice-setup">
    <div class="practice-head">
        <RadzenText TextStyle="TextStyle.H5" Text="Practice" />
        @if (_streak is { } streak && streak.Attempts > 0)
        {
            <div class="streak" title="Kept in this browser only">
                @* Past a few in a row the emoji gives way to a real flame, which is the one place
                   this page rewards rather than reports. Below that it stays a glyph: a streak of
                   one does not need a particle system. *@
                <span class="streak-flame">
                    <canvas class="streak-canvas @(streak.Streak >= FlameFromStreak ? "" : "hidden")"
                            @ref="_flameCanvas" aria-hidden="true"></canvas>
                    @if (streak.Streak < FlameFromStreak)
                    {
                        <span class="streak-glyph">@(streak.Streak > 0 ? "🔥" : "·")</span>
                    }
                </span>
                <span class="streak-count">@streak.Streak</span>
                <span class="streak-label">in a row · best @streak.Best</span>
            </div>
        }
    </div>
    <RadzenText class="practice-description"
                Text="Pick a mode, hear the phrase, then sing it back against the click. The server scores your pitch, your timing, and whether you stayed inside the mode at all." />

    <div class="practice-controls">
        <label class="practice-field">
            <span>Mode</span>
            <select @bind="_mode" @bind:after="ReloadAsync" disabled="@_busy" aria-label="Mode">
                @foreach (var mode in ScaleModes.All)
                {
                    <option value="@mode">@mode</option>
                }
            </select>
        </label>
        <label class="practice-field">
            <span>Tonic</span>
            <select @bind="_tonic" @bind:after="ReloadAsync" disabled="@_busy" aria-label="Tonic">
                @for (var pitchClass = 0; pitchClass < 12; pitchClass++)
                {
                    var value = pitchClass;
                    <option value="@value">@ScaleModes.NoteName(value)</option>
                }
            </select>
        </label>
        <label class="practice-field">
            <span>Exercise</span>
            <select @bind="_kind" @bind:after="ReloadAsync" disabled="@_busy" aria-label="Exercise">
                <option value="@ModeExerciseKind.ScaleRun">Scale run</option>
                <option value="@ModeExerciseKind.CharacteristicLeap">Characteristic leap</option>
                <option value="@ModeExerciseKind.Phrase">Phrase</option>
            </select>
        </label>
        <label class="practice-field">
            <span>Tempo @(_bpm.ToString("0")) BPM</span>
            <input type="range" min="48" max="120" step="4" @bind="_bpm" @bind:event="oninput"
                   @bind:after="ReloadAsync" disabled="@_busy" aria-label="Tempo" />
        </label>
        <label class="practice-field">
            <span>Octave</span>
            <select @bind="_octave" @bind:after="ReloadAsync" disabled="@_busy" aria-label="Octave">
                <option value="3">Low (3)</option>
                <option value="4">Middle (4)</option>
                <option value="5">High (5)</option>
            </select>
        </label>
    </div>
</RadzenCard>

@if (_exercise is { } exercise)
{
    <RadzenCard class="practice-exercise">
        <RadzenText TextStyle="TextStyle.H6" Text="@exercise.Title" />
        <p class="practice-instruction">@exercise.Instruction</p>

        <div class="scale-notes" aria-label="The notes of this mode">
            @foreach (var note in exercise.ScaleNotes)
            {
                <span class="scale-note @(IsCharacteristic(exercise, note) ? "characteristic" : "")">@note</span>
            }
        </div>

        @* The phrase as a pitch/time plot, with the sung line written over it live. It reports
           nothing the server has not said: the scoring below is the verdict, this is the picture. *@
        <div class="ribbon-wrap">
            <canvas class="practice-ribbon" @ref="_ribbonCanvas" aria-hidden="true"
                    data-testid="practice-ribbon"></canvas>
            <span class="ribbon-legend">
                <span class="legend-target">phrase</span>
                <span class="legend-sung">you</span>
            </span>
        </div>

        <div class="practice-actions">
            <RadzenButton Text="@(_phase == Phase.Demo ? "Playing…" : "Hear it")" Icon="volume_up"
                          ButtonStyle="ButtonStyle.Secondary" Disabled="@_busy"
                          Click="@HearAsync" id="practice-hear" />
            <RadzenButton Text="@SingLabel" Icon="mic" ButtonStyle="ButtonStyle.Primary"
                          Disabled="@_busy" Click="@SingAsync" id="practice-sing" />
            <RadzenButton Text="New phrase" Icon="casino" ButtonStyle="ButtonStyle.Light"
                          Disabled="@_busy" Click="@RerollAsync" id="practice-reroll"
                          title="A different phrase in the same mode" />
        </div>

        @if (_phase == Phase.CountingIn)
        {
            <p class="practice-cue counting">Counting you in…</p>
        }
        else if (_phase == Phase.Recording)
        {
            <p class="practice-cue recording">Sing now — one note per click.</p>
        }
        else if (_phase == Phase.Grading)
        {
            <p class="practice-cue">Scoring…</p>
        }

        @if (_error is { } error)
        {
            <p class="practice-error">@error</p>
        }
    </RadzenCard>

    @if (_score is { } score)
    {
        <RadzenCard class="practice-score">
            <div class="score-head">
                <div class="score-number @ScoreClass(score.Score)">
                    <span class="score-value">@score.Score</span>
                    <span class="score-outof">/ 100</span>
                </div>
                <div class="score-verdict">
                    <p class="verdict-text">@score.Verdict</p>
                    @if (score.Advice is { } advice)
                    {
                        <p class="advice-text">@advice</p>
                    }
                </div>
            </div>

            @* Three components, not one, because they fail for different reasons and the server
               grades them separately. Collapsing them would hide which one to practise. *@
            <div class="score-bars">
                <ScoreBar Label="Pitch" Percent="score.PitchPercent"
                     Hint="@($"{score.NotesHit} of {score.NotesTotal} notes exactly right")" />
                <ScoreBar Label="Timing" Percent="score.TimingPercent"
                     Hint="@TimingHint(score)" />
                <ScoreBar Label="Inside the mode" Percent="score.ModePurityPercent"
                     Hint="@PurityHint(score)" />
            </div>

            <div class="score-flags">
                <span class="flag @(score.CharacteristicSung ? "good" : "missing")">
                    @(score.CharacteristicSung
                        ? $"Sang the {string.Join(" / ", exercise.CharacteristicDegrees)}"
                        : $"Never sang the {string.Join(" / ", exercise.CharacteristicDegrees)}")
                </span>
                @if (score.ExtraNotes > 0)
                {
                    <span class="flag extra">@score.ExtraNotes extra note@(score.ExtraNotes == 1 ? "" : "s")</span>
                }
            </div>

            <div class="note-grid" aria-label="How each note went">
                @foreach (var note in score.Notes)
                {
                    <div class="note-cell @note.Verdict.ToString().ToLowerInvariant()"
                         title="@NoteTitle(note)">
                        <span class="note-target">@note.TargetLabel</span>
                        <span class="note-sung">@(note.SungLabel ?? "—")</span>
                    </div>
                }
            </div>
        </RadzenCard>
    }
}

@code {
    /// <summary>Where an attempt is in its cycle. Drives every label and disabled state on the page,
    /// so there is one answer to "what is happening" rather than four booleans that can disagree.</summary>
    private enum Phase { Idle, Demo, CountingIn, Recording, Grading }

    /// <summary>Streak at which the glyph gives way to the particle flame. Three is the first number
    /// that means "this is going well" rather than "you passed one".</summary>
    private const int FlameFromStreak = 3;

    private IJSObjectReference? _module;
    private IJSObjectReference? _ribbon;
    private IJSObjectReference? _flame;
    private IJSObjectReference? _confetti;
    private IJSObjectReference? _sfx;
    private ElementReference _ribbonCanvas;
    private ElementReference _flameCanvas;

    /// <summary>True once the plot has been started on the canvas, so the first render after an
    /// exercise arrives sets it up and later ones only reload the phrase.</summary>
    private bool _ribbonReady;

    private ModeExerciseDto? _exercise;
    private ExerciseScoreDto? _score;
    private StreakDto? _streak;
    private string? _error;
    private Phase _phase = Phase.Idle;

    private ScaleMode _mode = ScaleMode.Dorian;
    private int _tonic = 2;             // D Dorian: the mode this app is usually explaining
    private ModeExerciseKind _kind = ModeExerciseKind.ScaleRun;
    private double _bpm = 72;
    private int _octave = 4;
    private int _seed = 42;

    private bool _busy => _phase != Phase.Idle;

    private string SingLabel => _phase switch
    {
        Phase.CountingIn => "Counting in…",
        Phase.Recording => "Listening…",
        Phase.Grading => "Scoring…",
        _ => "Sing it",
    };

    /// <summary>The streak record, as this browser has it. Never sent anywhere.</summary>
    private sealed record StreakDto(int Streak, int Best, int Attempts);

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/practice-session.js");
        _streak = await _module.InvokeAsync<StreakDto>("loadStreak");
    }

    /// <summary>
    /// Fetches the phrase for the current settings. The score is dropped with it: a score belongs to
    /// one phrase, and leaving it on screen under a different exercise would be a wrong answer.
    /// </summary>
    private async Task ReloadAsync()
    {
        _error = null;
        _score = null;
        _exercise = await Analysis.GetExerciseAsync(_kind, _mode, _tonic, _bpm, _seed, _octave);
        if (_exercise is null)
        {
            _error = "Could not load an exercise.";
            return;
        }
        await PublishExerciseAsync(_exercise);
    }

    /// <summary>
    /// Hands the new phrase to the plot and to the live cue.
    /// </summary>
    /// <remarks>
    /// The pitch-class set goes with it because both of them need to know which notes are inside the
    /// mode, and neither may work that out: the set comes from <see cref="ScaleModes"/> — the same
    /// shared table the server graded against — so the browser is told, not left to decide. It is the
    /// mode's OWN scale on its own tonic, not the parent key's, which is the same rule
    /// ModeExerciseBuilder follows and the reason the pentatonics come out right.
    /// </remarks>
    private async Task PublishExerciseAsync(ModeExerciseDto exercise)
    {
        var pitchClasses = ScaleModes.Intervals(exercise.Mode)
            .Select(interval => (exercise.TonicPitchClass + interval) % 12)
            .ToArray();
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("setExercise", pitchClasses, exercise.TargetNotes);
            }
            if (_ribbon is not null && _ribbonReady)
            {
                await _ribbon.InvokeVoidAsync(
                    "setTargets", exercise.TargetNotes, exercise.DurationSec, pitchClasses);
            }
        }
        catch (JSDisconnectedException)
        {
            // Navigated away while the phrase was loading.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The canvases only exist once an exercise has rendered, so this cannot move into
        // OnInitializedAsync — and it must survive the exercise being reloaded, hence the flag.
        if (_exercise is not null && !_ribbonReady)
        {
            _ribbon ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/fx-practice-ribbon.js");
            // False when the effects are off or the canvas has no usable context; the page is
            // complete without it either way.
            _ribbonReady = await _ribbon.InvokeAsync<bool>("init", _ribbonCanvas);
            if (_ribbonReady)
            {
                await PublishExerciseAsync(_exercise);
            }
        }
        if (_streak is { Streak: >= FlameFromStreak } && _flame is null)
        {
            _flame = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fx-streak.js");
        }
        // Guarded on the streak pill being rendered at all: with no attempts yet there is no canvas,
        // and handing JS an unset element reference throws.
        if (_flame is not null && _streak is { Attempts: > 0 })
        {
            // Told the streak every render: the module decides whether that means burning hotter,
            // starting, or stopping, so this page never has to track which of those it last did.
            await _flame.InvokeVoidAsync("setStreak", _flameCanvas, _streak.Streak);
        }
    }

    /// <summary>A different phrase in the same mode. Only the seeded walk actually varies — the scale
    /// run and the leap drill are the same phrase by definition, so the button rerolls the seed and
    /// they come back identical, which is correct.</summary>
    private async Task RerollAsync()
    {
        _seed = Random.Shared.Next(1, 100_000);
        await ReloadAsync();
    }

    private async Task HearAsync()
    {
        if (_module is null || _exercise is null)
        {
            return;
        }
        try
        {
            _phase = Phase.Demo;
            await _module.InvokeVoidAsync("playPhrase", _exercise.TargetNotes, _exercise.DurationSec);
            // The player has no completion callback here, so the page simply waits out the phrase.
            // A stop button would be noise for something that lasts a few seconds.
            await Task.Delay(TimeSpan.FromSeconds(_exercise.DurationSec + 0.3));
        }
        catch (JSDisconnectedException)
        {
            // Navigated away mid-phrase.
        }
        finally
        {
            _phase = Phase.Idle;
        }
    }

    /// <summary>
    /// One attempt: count in, record the phrase, send the notes for grading.
    ///
    /// <para>The notes go to the server rather than being scored here for the usual reason — deciding
    /// whether a sung note was the right one is a musical judgment, and those are made server-side.
    /// </para>
    /// </summary>
    private async Task SingAsync()
    {
        if (_module is null || _exercise is null || _busy)
        {
            return;
        }

        _error = null;
        _score = null;
        try
        {
            _phase = Phase.CountingIn;
            StateHasChanged();

            if (!await _module.InvokeAsync<bool>("start", _exercise.Bpm, _exercise.DurationSec))
            {
                _error = "Microphone access was denied or is unavailable.";
                _phase = Phase.Idle;
                return;
            }

            _phase = Phase.Recording;
            await PlayHapticAsync("tap");
            StateHasChanged();
            await _module.InvokeAsync<bool>("waitForPhrase", _exercise.DurationSec);

            _phase = Phase.Grading;
            StateHasChanged();
            var sung = await _module.InvokeAsync<List<NoteEvent>>("finish");

            _score = await Analysis.GradeAttemptAsync(_exercise, sung);
            if (_score is null)
            {
                _error = "The server would not score that attempt.";
            }
            else
            {
                var previousBest = _streak?.Best ?? 0;
                _streak = await _module.InvokeAsync<StreakDto>("recordResult", _score.Score);
                await CelebrateAsync(_score.Score, previousBest);
            }
        }
        catch (JSDisconnectedException)
        {
            // Navigated away mid-attempt; the module dies with the page.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _phase = Phase.Idle;
        }
    }

    /// <summary>The degrees that name the mode, highlighted in the scale strip. The server supplies
    /// which ones they are; this only matches the note name back to them.</summary>
    private static bool IsCharacteristic(ModeExerciseDto exercise, string noteName)
    {
        var intervals = ScaleModes.CharacteristicIntervals(exercise.Mode);
        return intervals.Any(interval =>
            ScaleModes.NoteName(exercise.TonicPitchClass + interval) == noteName);
    }

    private static string ScoreClass(int score) => score switch
    {
        >= 85 => "great",
        >= 65 => "good",
        >= 40 => "fair",
        _ => "poor",
    };

    private static string TimingHint(ExerciseScoreDto score)
    {
        if (score.MedianTimingOffsetSec == 0)
        {
            return "no timing measured";
        }
        var offset = Math.Abs(score.MedianTimingOffsetSec).ToString("0.00");
        return score.Rushing ? $"{offset}s ahead of the click" : $"{offset}s behind the click";
    }

    private static string PurityHint(ExerciseScoreDto score)
        => score.OutsideNotes.Count == 0
            ? "every note was inside the mode"
            : $"outside the mode: {string.Join(", ", score.OutsideNotes)}";

    private static string NoteTitle(NoteGradeDto note) => note.Verdict switch
    {
        NoteVerdict.Hit => $"{note.TargetLabel} — sung correctly",
        NoteVerdict.Octave => $"{note.TargetLabel} — right note, wrong octave ({note.SungLabel})",
        NoteVerdict.Wrong => $"{note.TargetLabel} — sang {note.SungLabel} instead",
        _ => $"{note.TargetLabel} — nothing sung here",
    };

    /// <summary>A haptic tick, if the device has one and the effects allow it. Never awaited for
    /// anything: a phone that cannot buzz must not delay a downbeat.</summary>
    private async Task PlayHapticAsync(string name)
    {
        try
        {
            _sfx ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/sfx.js");
            await _sfx.InvokeVoidAsync(name);
        }
        catch (JSException)
        {
            // Haptics are garnish, never an error.
        }
    }

    /// <summary>
    /// The reward, and only for a real one: confetti and the rising arpeggio fire when this attempt
    /// beat the best score this browser has seen, not merely when it passed. A celebration that goes
    /// off every time stops reading as a celebration by the third phrase.
    /// </summary>
    private async Task CelebrateAsync(int score, int previousBest)
    {
        _sfx ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/sfx.js");
        if (score > previousBest && previousBest > 0)
        {
            _confetti ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/fx-confetti.js");
            await _confetti.InvokeVoidAsync("burst");
            await _sfx.InvokeVoidAsync("cheer");
            await _sfx.InvokeVoidAsync("doubleTap");
        }
        else
        {
            // Still worth a nudge: the score card can land below the fold on a phone.
            await _sfx.InvokeVoidAsync("thud");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            if (_ribbon is not null)
            {
                await _ribbon.InvokeVoidAsync("dispose");
                await _ribbon.DisposeAsync();
            }
            if (_flame is not null)
            {
                await _flame.InvokeVoidAsync("dispose", _flameCanvas);
                await _flame.DisposeAsync();
            }
            if (_confetti is not null)
            {
                await _confetti.DisposeAsync();
            }
            if (_sfx is not null)
            {
                await _sfx.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone during teardown.
        }
    }
}
