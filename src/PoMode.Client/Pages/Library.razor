@page "/library"
@using PoMode.Shared.Analysis
@inject AnalysisClient Analysis
@inject MockDataState MockData
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PoMode</PageTitle>

<RadzenCard>
    <RadzenText TextStyle="TextStyle.H5" Text="Song library" />

    @if (_entries is null)
    {
        <div class="library-skeletons" aria-hidden="true">
            <div class="pm-skeleton"></div>
            <div class="pm-skeleton"></div>
            <div class="pm-skeleton"></div>
        </div>
    }
    else if (_entries.Count == 0)
    {
        <div class="library-empty">
            <RadzenText class="library-empty-headline" Text="No songs yet" />
            <RadzenText class="library-empty-sub"
                        Text="Analyzed songs will show up here." />
            <a class="library-empty-cta" href="">Upload your first track →</a>
        </div>
    }
    else
    {
        @* Compare only makes sense with 2+ completed jobs — hide the column when there's only one. *@
        var canCompare = _entries.Count >= 2;
        <div class="library-filters" role="search" aria-label="Filter songs">
            <RadzenTextBox @bind-Value="_search" Placeholder="Search songs…" aria-label="Search by file name"
                           class="library-search" @oninput="@(e => _search = e.Value?.ToString() ?? "")" />
            <RadzenDropDown TValue="string" Data="@KeyChoices" Value="@_keyFilter" AllowClear="true"
                            Placeholder="Any key" Change="@(v => _keyFilter = v as string)" class="library-filter" />
            <RadzenDropDown TValue="string" Data="@ModeChoices" Value="@_modeFilter" AllowClear="true"
                            Placeholder="Any mode" Change="@(v => _modeFilter = v as string)" class="library-filter" />
            <label class="library-latest-only">
                <RadzenCheckBox TValue="bool" Value="@_latestOnly" Change="@(on => _latestOnly = on)" />
                Latest run per song
            </label>
            <span class="library-count">@Filtered.Count of @_entries.Count songs</span>
            @* The grid is the view for comparing figures; the wall is the view for finding a song
               you half remember. Both read the same filtered list. *@
            <div class="library-views" role="tablist" aria-label="Library view">
                <button class="library-view @(_wall ? "" : "active")" type="button" role="tab"
                        aria-selected="@(!_wall)" @onclick="@(() => SetViewAsync(false))">Table</button>
                <button class="library-view @(_wall ? "active" : "")" type="button" role="tab"
                        aria-selected="@_wall" @onclick="@(() => SetViewAsync(true))">Wall</button>
            </div>
        </div>
        @if (_wall)
        {
            <div class="library-wall @(_tilt ? "tilt" : "")" data-library-count="@_entries.Count">
                @foreach (var entry in Filtered)
                {
                    <button class="library-tile" type="button" @onclick="@(() => OpenAsync(entry))"
                            disabled="@(entry.Stage != JobStage.Complete)"
                            title="@($"{entry.FileName} · {entry.CreatedAt:yyyy-MM-dd HH:mm}")">
                        @* Every attribute here is a server-decided fact; fx-cover.js turns them
                           into a picture and knows nothing about what they mean. *@
                        <canvas class="library-cover" aria-hidden="true"
                                data-seed="@entry.JobId"
                                data-hue="@HueOf(entry)"
                                data-degrees="@DegreesOf(entry)"
                                data-tempo="@((entry.TempoBpm ?? 0).ToString("0", System.Globalization.CultureInfo.InvariantCulture))"
                                data-settled="@((entry.Stage == JobStage.Complete).ToString().ToLowerInvariant())"></canvas>
                        <span class="tile-facts">
                            <span class="tile-name">@entry.FileName</span>
                            <span class="tile-key">
                                @if (entry.TonicName is null)
                                {
                                    <span class="tile-unclear">Not analyzed</span>
                                }
                                else
                                {
                                    <strong>@entry.TonicName</strong>
                                    <span>@(string.IsNullOrEmpty(entry.PrimaryMode) ? "mode unclear" : entry.PrimaryMode)</span>
                                }
                            </span>
                            @if (entry.TempoBpm is { } tileBpm)
                            {
                                <span class="tile-tempo">@($"{tileBpm:0} BPM")</span>
                            }
                            @if (entry.Origin is { } tileOrigin)
                            {
                                <span class="tile-origin" title="@tileOrigin.Description">🎤 hum</span>
                            }
                        </span>
                    </button>
                }
            </div>
        }
        else
        {
        <div class="library-grid" data-library-count="@_entries.Count">
            <RadzenDataGrid Data="@Filtered" TItem="LibraryEntryDto" AllowSorting="true" Density="Density.Compact"
                            AllowPaging="true" PageSize="15" PagerHorizontalAlign="HorizontalAlign.Center">
                <Columns>
                    <RadzenDataGridColumn TItem="LibraryEntryDto" Property="FileName" Title="Song">
                        <Template Context="entry">
                            @entry.FileName
                            @if (RunCountOf(entry) is > 1 and var runs)
                            {
                                <span class="library-runs-badge" title="This song was analyzed more than once">×@runs</span>
                            }
                            @* A sung take is not an uploaded song, and the row should not read like one —
                               its whole meaning is the progression the singer was hearing. *@
                            @if (entry.Origin is { } origin)
                            {
                                <span class="library-origin-badge" title="@origin.Description">🎤 hum</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LibraryEntryDto" Property="CreatedAt" Title="Analyzed" FormatString="{0:yyyy-MM-dd HH:mm}" Width="150px" />
                    <RadzenDataGridColumn TItem="LibraryEntryDto" Title="Key" Width="130px">
                        <Template Context="entry">
                            @if (entry.TonicName is null)
                            {
                                <span>—</span>
                            }
                            else if (string.IsNullOrEmpty(entry.PrimaryMode))
                            {
                                <span><strong>@entry.TonicName</strong> <span class="library-key-missing">— mode unclear</span></span>
                            }
                            else
                            {
                                <span><strong>@entry.TonicName</strong> @entry.PrimaryMode</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LibraryEntryDto" Title="Tempo" Width="90px">
                        <Template Context="entry">
                            @(entry.TempoBpm is { } bpm ? $"{bpm:0} BPM" : "—")
                        </Template>
                    </RadzenDataGridColumn>
                    @* An all-Complete column says nothing; it only appears when something isn't. *@
                    @if (_entries.Any(e => e.Stage != JobStage.Complete))
                    {
                        <RadzenDataGridColumn TItem="LibraryEntryDto" Property="Stage" Title="Status" Width="110px" />
                    }
                    <RadzenDataGridColumn TItem="LibraryEntryDto" Title="" Sortable="false" Width="@(canCompare ? "200px" : "90px")">
                        <Template Context="entry">
                            <RadzenButton Text="Open" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                          Click="@(() => Open(entry))" Disabled="@(entry.Stage != JobStage.Complete)" />
                            @if (canCompare)
                            {
                                <RadzenToggleButton Text="Compare" Size="ButtonSize.Small"
                                                    Value="@_compare.Contains(entry.JobId)"
                                                    Change="@(_ => ToggleCompareAsync(entry))"
                                                    Disabled="@(entry.Stage != JobStage.Complete)" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
        }
    }
</RadzenCard>

@if (_compareResults.Count == 2)
{
    <RadzenCard class="compare-panel" data-compare-count="2">
        <RadzenText TextStyle="TextStyle.H6" Text="Side by side" />
        <div class="compare-cards">
            @foreach (var (entry, result) in _compareResults)
            {
                <div class="compare-card">
                    <div class="compare-title">@entry.FileName</div>
                    <div class="compare-facts">
                        <span>@result.TonicName @(result.PrimaryMode?.ToString() ?? "unclear")</span>
                        <span>@($"{result.TempoBpm:0} BPM")</span>
                        <span>@result.Windows.Count windows</span>
                    </div>
                    <div class="mode-timeline" title="Mode over time">
                        @foreach (var window in result.Windows)
                        {
                            var mode = window is { InsufficientEvidence: false, Matches.Count: > 0 }
                                ? window.Matches[0].Mode.ToString() : null;
                            <span class="mode-segment @SegmentClass(mode)"
                                  style="--pm-grow: @SegmentGrow(window)" title="@(mode ?? "unclear")"></span>
                        }
                    </div>
                    <div class="mode-legend">
                        @foreach (var mode in ModesUsed(result))
                        {
                            <span class="legend-item"><span class="mode-segment @SegmentClass(mode)"></span>@mode</span>
                        }
                    </div>
                </div>
            }
        </div>
    </RadzenCard>
}

@code {
    private List<LibraryEntryDto>? _entries;
    private readonly HashSet<string> _compare = [];
    private readonly List<(LibraryEntryDto Entry, ModalResult Result)> _compareResults = [];

    private IJSObjectReference? _cover;
    private IJSObjectReference? _sfx;

    /// <summary>Wall or table. A per-viewer convenience like the theme override, so it lives in the
    /// browser rather than anywhere the server can see it.</summary>
    private bool _wall;
    private bool _tilt;

    private string _search = "";
    private string? _keyFilter;
    private string? _modeFilter;
    private bool _latestOnly = true;

    private int RunCountOf(LibraryEntryDto entry)
        => _entries?.Count(e => e.FileName == entry.FileName) ?? 1;

    private List<string> KeyChoices => _entries?
        .Select(e => e.TonicName).OfType<string>().Distinct().OrderBy(k => k).ToList() ?? [];

    private List<string> ModeChoices => _entries?
        .Select(e => e.PrimaryMode).Where(m => !string.IsNullOrEmpty(m)).Cast<string>()
        .Distinct().OrderBy(m => m).ToList() ?? [];

    /// <summary>The grid's view: search on file name, exact key/mode match. Empty filters pass all,
    /// so "songs in the same key" is just picking that key in the dropdown.</summary>
    private List<LibraryEntryDto> Filtered
    {
        get
        {
            IEnumerable<LibraryEntryDto> view = _entries ?? [];
            if (_latestOnly)
            {
                // Entries arrive newest-first, so the first of each file name is the latest run.
                view = view.GroupBy(e => e.FileName).Select(g => g.First());
            }
            return view
                .Where(e => string.IsNullOrWhiteSpace(_search)
                    || e.FileName.Contains(_search, StringComparison.OrdinalIgnoreCase))
                .Where(e => _keyFilter is null || e.TonicName == _keyFilter)
                .Where(e => _modeFilter is null || e.PrimaryMode == _modeFilter)
                .ToList();
        }
    }

    /// <summary>
    /// The tonic's place on the colour wheel. Twelve pitch classes over 360 degrees, the same
    /// mapping the Analyze page uses for --pm-key-hue, so a song is the same colour on the wall as
    /// the chrome turns when you open it. Falls back to the neutral accent hue when the analysis
    /// named no key — an unanalyzed song should not be assigned one by the art.
    /// </summary>
    private static int HueOf(LibraryEntryDto entry)
    {
        if (entry.TonicName is null)
        {
            return 262;
        }
        for (var pitchClass = 0; pitchClass < 12; pitchClass++)
        {
            if (string.Equals(ScaleModes.NoteName(pitchClass), entry.TonicName, StringComparison.OrdinalIgnoreCase))
            {
                return pitchClass * 30;
            }
        }
        return 262;
    }

    /// <summary>
    /// How many notes the named mode has, which is what makes a pentatonic cover visibly sparser
    /// than a diatonic one. Read from the shared interval table rather than counted in the browser,
    /// so the picture cannot disagree with the analysis about what the mode contains.
    /// </summary>
    private static int DegreesOf(LibraryEntryDto entry)
        => Enum.TryParse<ScaleMode>(entry.PrimaryMode, out var mode)
            ? ScaleModes.Intervals(mode).Count
            : 7;

    private async Task SetViewAsync(bool wall)
    {
        if (_wall == wall)
        {
            return;
        }
        _wall = wall;
        await PlaySfxAsync("click");
    }

    /// <summary>Fire-and-forget UI sound, matching the Analyze page's contract: a sound that cannot
    /// play is skipped, never surfaced.</summary>
    private async Task PlaySfxAsync(string name)
    {
        try
        {
            _sfx ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/sfx.js");
            await _sfx.InvokeVoidAsync(name);
        }
        catch (JSException)
        {
            // Sounds are garnish, never an error.
        }
        catch (JSDisconnectedException)
        {
            // Navigated away.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_wall)
        {
            return;
        }
        try
        {
            _cover ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/fx-cover.js");
            if (firstRender || !_tilt)
            {
                _tilt = await _cover.InvokeAsync<bool>("allowsTilt");
            }
            // Safe to call on every render: covers already painted carry a data attribute and are
            // skipped, so filtering or paging repaints only what is genuinely new.
            await _cover.InvokeAsync<int>("paintAll", null);
        }
        catch (JSDisconnectedException)
        {
            // Navigated away mid-render.
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _entries = await Analysis.GetLibraryAsync() ?? [];
        // The library lists persisted jobs — the data is real persistence, not placeholders.
        // The mock banner is the Analyze page's "I haven't shown you a real result yet" hint;
        // showing it here implies the library is mocked, which it isn't.
        MockData.SetLive();
    }

    private void Open(LibraryEntryDto entry)
        => Navigation.NavigateTo($"/?job={entry.JobId}");

    /// <summary>The wall's open: the same navigation, with the transport sound the mixer uses for a
    /// start, because picking a cover is the gesture that begins listening to something.</summary>
    private async Task OpenAsync(LibraryEntryDto entry)
    {
        await PlaySfxAsync("whoosh");
        Open(entry);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_cover is not null)
            {
                await _cover.DisposeAsync();
            }
            if (_sfx is not null)
            {
                await _sfx.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone during teardown.
        }
    }

    private async Task ToggleCompareAsync(LibraryEntryDto entry)
    {
        if (!_compare.Remove(entry.JobId))
        {
            if (_compare.Count == 2)
            {
                return; // two is the comparison; a third selection is ignored until one is untoggled
            }
            _compare.Add(entry.JobId);
        }

        _compareResults.Clear();
        if (_compare.Count == 2 && _entries is not null)
        {
            foreach (var selected in _entries.Where(e => _compare.Contains(e.JobId)))
            {
                if (await Analysis.GetResultAsync(selected.JobId) is { } result)
                {
                    _compareResults.Add((selected, result));
                }
            }
        }
    }

    // Presentation-only mapping (the modes themselves were decided server-side).
    private static string SegmentClass(string? mode)
        => mode is null ? "mode-unclear" : $"mode-{mode.ToLowerInvariant()}";

    private static string SegmentGrow(ModalWindow window)
        => Math.Max(window.EndSec - window.StartSec, 0.1).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static IEnumerable<string> ModesUsed(ModalResult result)
        => result.Windows
            .Where(w => w is { InsufficientEvidence: false, Matches.Count: > 0 })
            .Select(w => w.Matches[0].Mode.ToString())
            .Distinct();
}
