@page "/live"
@using PoMode.Shared.Analysis
@inject AnalysisClient Analysis
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PoMode</PageTitle>

<RadzenCard>
    <RadzenText TextStyle="TextStyle.H5" Text="Live analysis" />
    <RadzenText class="live-description" Text="Sing or play into your microphone. Every few seconds the server re-analyzes what it heard: key, modes, and a growing note roll." />
    <div class="live-controls" @ref="_root">
        @if (!_running)
        {
            <RadzenButton Text="Start listening" ButtonStyle="ButtonStyle.Primary" Click="@StartAsync" />
        }
        else
        {
            <RadzenButton Text="Stop" ButtonStyle="ButtonStyle.Danger" Click="@StopAsync" />
            <RadzenText class="live-hint" Text="@($"Listening… {_noteCount} notes heard")" />
        }
        @if (_error is not null)
        {
            <RadzenText class="live-error" Text="@_error" />
        }
    </div>
</RadzenCard>

@if (_visual is not null && _visual.Notes.Count > 0)
{
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H6" Text="@($"{_visual.Notes.Count} notes · {_result!.TonicName} {_result.PrimaryMode?.ToString() ?? "mode unclear"}")" />
        <AnalysisCanvas Model="_visual" SelectedWindowIndex="_selectedWindow"
                        PlayheadSec="0" OnSeek="OnSeek" />
    </RadzenCard>
    <ModalHud Result="_result!" Windows="_visual.Windows" SelectedWindowIndex="_selectedWindow" JobId="" />
}

@code {
    private const int AnalyzeEverySeconds = 5;

    private ElementReference _root;
    private IJSObjectReference? _module;
    private bool _running;
    private string? _error;
    private int _noteCount;
    private VisualizationPayload? _visual;
    private ModalResult? _result;
    private int? _selectedWindow;
    private Timer? _timer;

    private async Task StartAsync()
    {
        _error = null;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/live-session.js");
        if (!await _module.InvokeAsync<bool>("start", _root))
        {
            _error = "Microphone access was denied or is unavailable.";
            return;
        }
        _running = true;
        _visual = null;
        _result = null;
        _selectedWindow = null;
        _noteCount = 0;
        _timer = new Timer(async _ => await AnalyzeAsync(), null,
            TimeSpan.FromSeconds(AnalyzeEverySeconds), TimeSpan.FromSeconds(AnalyzeEverySeconds));
    }

    private async Task StopAsync()
    {
        _timer?.Dispose();
        _timer = null;
        _running = false;
        await AnalyzeAsync(); // one final pass over the full take
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("stop", _root);
        }
    }

    /// <summary>Ships the notes heard so far to the server, which makes every musical decision.</summary>
    private async Task AnalyzeAsync()
    {
        if (_module is null)
        {
            return;
        }
        try
        {
            var notes = await _module.InvokeAsync<List<NoteEvent>>("snapshot", _root);
            _noteCount = notes.Count;
            if (notes.Count > 0 && await Analysis.AnalyzeLiveAsync(notes) is { } analysis)
            {
                _result = analysis.Result;
                _visual = analysis.Visual;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException)
        {
            // Torn down mid-tick; the timer dies with the component.
        }
    }

    private void OnSeek(double seconds)
        => _selectedWindow = _result?.WindowIndexAt(seconds);

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone during teardown.
            }
        }
    }
}
