@page "/live"
@using PoMode.Shared.Analysis
@inject AnalysisClient Analysis
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>PoMode</PageTitle>

<RadzenCard>
    <RadzenText TextStyle="TextStyle.H5" Text="Live analysis" />
    <RadzenText class="live-description" Text="Sing or play into your microphone. Every few seconds the server re-analyzes what it heard: key, modes, and a growing note roll." />
    @* Between the server's answers there used to be no feedback at all, which is the wrong way
       round for the one page you use with your voice. The ring's radius is the pitch and its
       steadiness is the tuning; it claims nothing about mode, which is the server's answer below. *@
    <div class="tuner-wrap @(_tunerOn ? "" : "hidden")">
        <canvas class="live-tuner" @ref="_tunerCanvas" aria-hidden="true" data-testid="live-tuner"></canvas>
    </div>
    <div class="live-controls" @ref="_root">
        @if (!_running)
        {
            <RadzenButton Text="Start listening" ButtonStyle="ButtonStyle.Primary" Click="@StartAsync" />
        }
        else
        {
            <RadzenButton Text="Stop" ButtonStyle="ButtonStyle.Danger" Click="@StopAsync" />
            <RadzenText class="live-hint" Text="@($"Listening… {_noteCount} notes heard")" />
        }
        @if (_hasTake)
        {
            <RadzenButton Text="@(_sending ? "Sending…" : "Analyze this take →")"
                          ButtonStyle="ButtonStyle.Secondary" Disabled="@_sending"
                          Click="@SendToAnalyzerAsync" id="live-send-analyzer"
                          title="Send what you just sang through the full analysis pipeline: stem separation, pitch tracking, chords and modes" />
        }
        @if (_error is not null)
        {
            <RadzenText class="live-error" Text="@_error" />
        }
    </div>
</RadzenCard>

@if (_visual is not null && _visual.Notes.Count > 0)
{
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H6" Text="@($"{_visual.Notes.Count} notes · {_result!.TonicName} {_result.PrimaryMode?.ToString() ?? "mode unclear"}")" />
        <AnalysisCanvas Model="_visual" SelectedWindowIndex="_selectedWindow"
                        PlayheadSec="0" OnSeek="OnSeek" />
    </RadzenCard>
    <ModalHud Result="_result!" Windows="_visual.Windows" SelectedWindowIndex="_selectedWindow" />
}

@code {
    private const int AnalyzeEverySeconds = 5;

    private ElementReference _root;
    private ElementReference _tunerCanvas;
    private IJSObjectReference? _module;
    private IJSObjectReference? _tuner;
    private bool _tunerOn;
    private bool _running;
    private string? _error;
    private int _noteCount;
    private VisualizationPayload? _visual;
    private ModalResult? _result;
    private int? _selectedWindow;
    private Timer? _timer;
    private bool _hasTake;
    private bool _sending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        try
        {
            _tuner = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fx-tuner.js");
            // False with effects off or no usable canvas context; the page is unchanged without it.
            _tunerOn = await _tuner.InvokeAsync<bool>("init", _tunerCanvas);
            if (_tunerOn)
            {
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
            // Navigated away before the first render finished.
        }
    }

    private async Task StartAsync()
    {
        _error = null;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/live-session.js");
        if (!await _module.InvokeAsync<bool>("start", _root))
        {
            _error = "Microphone access was denied or is unavailable.";
            return;
        }
        _running = true;
        _hasTake = true;
        _visual = null;
        _result = null;
        _selectedWindow = null;
        _noteCount = 0;
        _timer = new Timer(async _ => await AnalyzeAsync(), null,
            TimeSpan.FromSeconds(AnalyzeEverySeconds), TimeSpan.FromSeconds(AnalyzeEverySeconds));
    }

    private async Task StopAsync()
    {
        _timer?.Dispose();
        _timer = null;
        _running = false;
        await AnalyzeAsync(); // one final pass over the full take
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("stop", _root);
        }
    }

    /// <summary>Ships the notes heard so far to the server, which makes every musical decision.</summary>
    private async Task AnalyzeAsync()
    {
        if (_module is null)
        {
            return;
        }
        try
        {
            var notes = await _module.InvokeAsync<List<NoteEvent>>("snapshot", _root);
            _noteCount = notes.Count;
            if (notes.Count > 0 && await Analysis.AnalyzeLiveAsync(notes) is { } analysis)
            {
                _result = analysis.Result;
                _visual = analysis.Visual;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException)
        {
            // Torn down mid-tick; the timer dies with the component.
        }
    }

    /// <summary>
    /// Hands the recorded take to the full analysis pipeline. The live view only ever sees pitch the
    /// browser detected; the analyzer works on the audio itself, so the recording is uploaded rather
    /// than the notes on screen.
    /// </summary>
    private async Task SendToAnalyzerAsync()
    {
        if (_module is null || _sending)
        {
            return;
        }

        _sending = true;
        _error = null;
        try
        {
            if (_running)
            {
                await StopAsync();
            }

            var wav = await _module.InvokeAsync<byte[]>("takeWavBytes", _root);
            if (wav.Length == 0)
            {
                _error = "Nothing was recorded yet. Press Start listening and sing first.";
                return;
            }

            var job = await Analysis.UploadAsync(
                wav, $"live-take-{DateTime.Now:yyyyMMdd-HHmmss}.wav", clientCanInfer: false);

            if (job is not null && !string.IsNullOrEmpty(job.JobId))
            {
                Navigation.NavigateTo($"/?job={job.JobId}");
            }
            else
            {
                _error = "The analyzer would not accept the take.";
            }
        }
        catch (JSDisconnectedException)
        {
            // Navigated away mid-send.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _sending = false;
        }
    }

    private void OnSeek(double seconds)
        => _selectedWindow = _result?.WindowIndexAt(seconds);

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("stop", _root);
                await _module.DisposeAsync();
            }
            if (_tuner is not null)
            {
                await _tuner.InvokeVoidAsync("dispose");
                await _tuner.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone during teardown.
        }
    }
}
